@ARTICLE{11363200,
  author={Gokhan Ozkaya, Suat and Baygin, Mehmet},
  journal={IEEE Access}, 
  title={A Lightweight Machine Learning Model for the Automatic Classification of Near-Field and Far-Field Earthquakes}, 
  year={2026},
  volume={14},
  number={},
  pages={13610-13624},
  abstract={Classification of seismic signals is critical in distinguishing between Near-Field (NF) and Far-Field (FF) seismic events in earthquake engineering and structural analysis. In this paper, we propose an innovative machine learning-based model for automatic classification of seismic signals. The proposed method consists of signal decomposition using Tunable Q-Factor Wavelet Transform (TQWT), feature extraction using Nigerian Pattern and statistical moment methods, feature selection using Iterative Neighborhood Component Analysis (INCA) algorithm, and finally classification using Support Vector Machines (SVM) algorithm. The proposed model provides a lightweight framework with low computational cost and high classification accuracy compared to traditional methods in the literature. The model was tested on 147 open-access seismic signal data and achieved 93.2% classification accuracy with a 10-fold cross-validation strategy. This study aims to make a significant contribution to earthquake engineering analysis and structural design processes by providing an effective method for the automatic classification of seismic signals.},
  keywords={Feature extraction;Noise measurement;Signal resolution;Recording;Earthquake engineering;Computational modeling;Classification algorithms;Vectors;Q-factor;Long short term memory;Seismic signals;near-field and far-field;machine learning;earthquake engineering},
  doi={10.1109/ACCESS.2026.3657500},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10407506,
  author={Sun, Yuming and Keskinocak, Pinar and Steimle, Lauren N. and Kovacs, Stephanie D. and Wassilak, Steven G.},
  booktitle={2023 Winter Simulation Conference (WSC)}, 
  title={A Compartmental Simulation Model to Improve Interventions for Controlling Poliovirus Outbreaks}, 
  year={2023},
  volume={},
  number={},
  pages={1184-1195},
  abstract={Poliomyelitis (polio) is an infectious disease that paralyzed millions of people worldwide before polio vaccines were available. Despite the successes of the Global Polio Eradication Initiative, there are circulating vaccine-derived poliovirus outbreaks that require improved interventions. We built a compartmental model to simulate the spread of polio that considers mutation of the live-attenuated virus (in the oral polio vaccine) to evaluate the effectiveness of interventions. We validated the model in a case study of northern Nigeria and tested the impact of interventions that varied in the number of vaccination rounds and the target regions. Results indicated that the model captures polio dynamics by matching the case counts and their spatiotemporal and age distributions in the data. To stop the outbreaks, stakeholders should conduct aggressive interventions with more rounds and broader coverage, especially in the under-vaccinated regions, compared to the current practice.},
  keywords={Surveillance;Sociology;Vaccines;Stakeholders;Statistics;Viruses (medical);Immune system},
  doi={10.1109/WSC60868.2023.10407506},
  ISSN={1558-4305},
  month={Dec},}@INPROCEEDINGS{10051548,
  author={Iyanda, Abimbola Rhoda and Ogungbe, Omolara Aminat and Aderibigbe, Adeniyi Sunday},
  booktitle={2022 5th Information Technology for Education and Development (ITED)}, 
  title={An Adaptable SVM Model for Abnormalities Detection in Chest X-ray Reports}, 
  year={2022},
  volume={},
  number={},
  pages={1-8},
  abstract={In Nigeria, prose format is used to present and perform analysis on chest x-ray reports and this often results in delayed response from the clinicians. Therefore, with a view to developing a system for analyzing chest x-ray reports for diagnosing cardiomegaly, linear support vector machine algorithm was utilized to formulate an adaptable model with a train-test split of 70:30 for six hundred and fifty (650) de-identified patients' information. Attributes relevant to cardiomegaly from the collected dataset were extracted using Term frequency/inverse document frequency technique. This work provides an adequate requirement for diagnosis design with accuracy of 93.69%. Its implementation in software application has the potential to reduce delay in attending to patients and can also help the clinicians focus on the findings from chest x-ray reports.},
  keywords={Analytical models;Adaptation models;Computational modeling;Support vector machine classification;X-rays;Software;X-ray imaging;Abnormalities;Clinical Chest X-ray Reports;Machine Learning;Adaptable Model;Human computer Interaction},
  doi={10.1109/ITED56637.2022.10051548},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11592105,
  author={Faruk, Nasir and Garba, Salisu and Owonubi, Job Sunday and Imoize, Agbotiname Lucky and Adewole, Kayode S. and Kanya, Rislana Abdulazeez and Abdulkarim, Abubakar},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Standardization in Clinical Data Repositories - A Case Study of SLUK HISCDR}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The absence of standardized, interoperable, and secure Clinical Data Repositories (CDRs) limits effective healthcare delivery and data-driven decision-making in low-resource environments. This study presents the design and implementation of the SLUK HISCDR, a cloud-based CDR developed at Sule Lamido University, Kafin Hausa, Nigeria, initially deployed as J-Care. Using a two-phased pragmatic approach, Phase One developed and piloted J-Care, a SaaS microservices platform that digitized clinical workflows at the SLUK clinic. Phase Two expanded the system into a secure, federated CDR and incorporated a statewide baseline health data assessment for Jigawa State. The methodology combined software engineering techniques, a cross-sectional survey of 286 PHCs, 18 secondary facilities, and 1 tertiary facility, and Power BI for analytics and visualization. Findings show that SLUK HISCDR provides a viable, scalable model for standardized CDR deployment in Nigeria. The paper recommends nationwide policy adoption, investment in digital infrastructure, improved rural staffing, and future integration of federated machine learning for predictive analytics.},
  keywords={Occupational health;Medical services;Educational institutions;Software as a service;Federated learning;Modeling;Clinical Data Repository (CDR);Health Information System (HIS);Healthcare Baseline Data;Jigawa State;Nigeria;Power BI},
  doi={10.1109/CTUS-EMEA68989.2025.11592105},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{7821608,
  author={Oluwaranti, Adeniran and Okegbile, Samuel},
  booktitle={2016 Future Technologies Conference (FTC)}, 
  title={Two state Markov chain based predictive model for cognitive Radio spectrum availability: A conceptual approach}, 
  year={2016},
  volume={},
  number={},
  pages={179-186},
  abstract={One of the major challenges in Cognitive Radio Network (CRN) is the limitations in protecting the activities of the licensed devices from any form of interference while making an efficient use of the unused spectrum opportunistically. The CRNs required that the unlicensed devices leave the band once the licensed device is detected. The high fluctuation in available spectrum due to random behaviour of the licensed devices however imposes a challenge in detecting the unused spectrum bands. This work presents a model with the capability to predict the cognitive radio spectrum availability base on the behaviour of the licensed devices observed in southwest of Nigeria. Discrete time Markov chain (DTMC) and duty cycle models were adopted in predicting the spectrum usage. Results shows that prediction using DTMC was appropriate for channels in which licensed devices resides in one state for a long period of time before switching to another state.},
  keywords={Predictive models;Cognitive radio;Markov processes;Interference;White spaces;TV;Switches;Cognitive device;White Space;Digital Switchover;Markov model;Duty cycle},
  doi={10.1109/FTC.2016.7821608},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8102286,
  author={Owoseni, Adebowale and Salami, Olusola and Twinomurinzi, Rossana and Mtsweni, Jabu},
  booktitle={2017 IST-Africa Week Conference (IST-Africa)}, 
  title={Evolving a new community through Tuckman model and WhatsApp messaging platform}, 
  year={2017},
  volume={},
  number={},
  pages={1-9},
  abstract={Tuckman's model identified forming, storming, norming and performing as four fundamental stages of group development; a new community like an extended group will not achieve optimal effectiveness unless it attains the stage of performing and interdependence [1]; therein lies one of the challenges of metropolitan housing schemes in developing countries [2]. Concerted efforts by governments of Lagos state, Nigeria at meeting deficiency in housing needs has yielded little returns in the long-run because of inability of homeowners and residents of new housing estates to take responsibilities for shared facilities; especially when estates were built by government and sold out in mortgage schemes. This exploratory study looks into how a new community of 144 new apartments evolved over 18 months with WhatsApp as a collaborative messaging tool for 180days and its impact on shared facilities maintenance. Group WhatsApp conversation was extracted and analysed for themes consistent with Tuckman's model. The research outcome shows significant usefulness of WhatsApp towards establishing a performing community — a community with common focus where resources are allocated efficiently, communicates effectively with processes in place to ensure final objectives are achieved; a community with common sense of responsibilities towards sustaining shared facilities.},
  keywords={Loans and mortgages;Government;Tools;Electronic mail;Contracts;Economic indicators;Uncertainty;housing;real-estate;homeowners;residents;community;group-formation;messaging;WhatsApp},
  doi={10.23919/ISTAFRICA.2017.8102286},
  ISSN={},
  month={May},}@INPROCEEDINGS{9914577,
  author={Owuamanam, Jude N. and Abdullah, Salfarina and Jusoh, Yusmadi Yah and Pa, Noraini Che},
  booktitle={2022 Applied Informatics International Conference (AiIC)}, 
  title={E-Service Quality Model for Assessing Customer Satisfaction of Mobile Banking Service}, 
  year={2022},
  volume={},
  number={},
  pages={178-183},
  abstract={Banks are now extending their services from the traditional face-to-face banking interactions to a self-service system. Although mobile banking has grown exponentially, many users are not confident to transact using their phones due to the low e-service quality of mobile banking. This study proposes a model for assessing the e-service quality of mobile banking while examining the relationship between such e-service dimensions and customer satisfaction. The primary data obtained from users of the mobile banking service in Nigeria were measured and analysed. A total number of 156 responses were obtained and analysed using structural equation modelling (SEM). The results show that app design, fulfilment and security are positively significant to customer satisfaction. Hence, the findings provide guidance and useful information to service providers on how the e-service quality of mobile banking systems can be improved.},
  keywords={Analytical models;Numerical analysis;Customer satisfaction;Banking;Mathematical models;Security;Informatics;E-Service Quality;Mobile Banking;Customer Satisfaction;Service;Application},
  doi={10.1109/AiIC54368.2022.9914577},
  ISSN={},
  month={May},}@INPROCEEDINGS{10629731,
  author={Akinrolabu, Olatunde David and Ajayi, Olusola Olajide and Ebitigha, Akinola Elijah and Adegbite, Adewuyi Adetayo and Obafemi, Joy Rotimi and Ogunleye, Jacob Kehinde},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={Handwritten Signature Verification Model Using Transfer Deep Learning Technique}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The legitimacy and authentication of handwritten signature verification in industries such as banking, security and educational institutions cannot be over-emphasized. Handwritten signatures are physical representations of a person’s signature that can be used to sign documents. This research work designed a model for verifying handwritten signatures using transfer deep learning which involved the use of a Visual Geometry Group (VGG16), a 16-layer deep pre-trained algorithm and a custom CNN. A total of 14,500 signatures were harvested from attendance registers of staff from selected higher institutions in the western part of Nigeria. The data were pre-processed to extract distinct features of the handwritten signatures before the classification and verification processes. During classification, the technique exploited the knowledge gained from reference signatures using distinct threshold values to match the new signatures for proper verification. The results from the experiment demonstrated a good upshot with performance accuracy of 99%, precision of 99%, recall of 100%, and f-score of 100%. Other evaluation metrics used stand at good performance values respectively. This implied that the technique can accurately classify and authenticate the reference features. The model can therefore be used for efficient verification of handwritten signatures in our institutions.},
  keywords={Deep learning;Measurement;Industries;Geometry;Handwriting recognition;Visualization;Feature extraction;Handwritten Signature;Image Classification;Pre-trained Model;Transfer deep learning;Convolutional Neural Network;Computer Vision},
  doi={10.1109/SEB4SDG60871.2024.10629731},
  ISSN={},
  month={April},}@INPROCEEDINGS{10927409,
  author={Oladapo, Kayode Abiodun and Alowolodu, Dayo Olufunsho and Akinsola, Jide Ebenezer Taiwo},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Fuzzified Risk Assessment Model for Detection and Prediction of Flood Using Machine Learning Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={1-10},
  abstract={Pluvial flooding is a type of flood that has become a threat to human life and the global economy due to the variability in climate change, rapid urbanization and fast-growing spatial development. Studies have shown that Machine Learning (ML) applications can be used to reduce this risk. However, less attention has been paid to the use of a fuzzy rule-based classification to appraise the performance of ML, based on pluvial flood Conditioning Variables (CVs). Therefore, the study developed a fuzzified risk assessment model for the detection and prediction of pluvial flood using ML techniques. The application was developed by categorizing the pluvial flood CVs using the degree of interdependency index. A total of 144,401 records and eight CVs out of 53 were gathered from the United States Geological Survey and Copernicus Climate Data Store from five Local Government Areas (LGAs) in Oyo State, Nigeria. Fuzzy logic was applied to the eight CVs using the triangular method, after which five ML algorithms were used to train the CVs: K-Nearest Neighbours (KNN), Random Forest (RF), Classification and Regression Trees (CART), Naïve Bayes (NB) and Artificial Neural Network (ANN) algorithms. The fuzzy logic re-classified the selected CVs into five classes: no flood, low, moderate, high and very high pluvial flood susceptibility. The performance of the application was evaluated using the 10-fold cross-validation and hold-out techniques, based on accuracy, sensitivity, specificity, precision and Area Under Receiver Operating Characteristics (AUROC) metrics. The study concluded that the fuzzified ML application can be used in detecting and predicting pluvial floods. Consequently, CART which had the best results, when compared to the rest of the classifier models, is recommended for use by experts. This is because the application showed the capacity to assist experts to alert the public on expected risks. Also, it will further assist local authorities and government agencies for appropriate pluvial flood management plans.},
  keywords={Fuzzy logic;Accuracy;Local government;Predictive models;Floods;Risk management;Indexes;Random forests;Regression tree analysis;Guidelines;risk assessment;pluvial flood;fuzzy logic;machine learning techniques;degree of interdependency index},
  doi={10.1109/NIGERCON62786.2024.10927409},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{11592293,
  author={Aliozora-Nwaonye, Chinyere and Imoize, Agbotiname Lucky},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Designing and Sustaining Inclusive Digital Education Platforms: Strategies to Bridge the Learning Divide in Remote and Underserved Communities}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Persistent digital disparities restrict equitable access to quality education in Nigeria and comparable developing regions. While technology-driven learning presents significant potential, infrastructural limitations, inconsistent policy implementation, and socioeconomic barriers exacerbate the digital divide, particularly in underserved and remote areas. This study examines strategies for designing and sustaining inclusive digital education platforms that promote educational equity and equality. Drawing on both global and Nigerian evidence, the study employs a systematic literature review to synthesize comparative analyses of digital transformation in education, sustainable development frameworks, inclusive education policies, and telecommunications innovations, and to leverage case studies from Rivers State, Nigeria. The analysis identifies five interdependent enablers of sustainable digital inclusion: (1) equitable access to reliable connectivity and resilient infrastructure; (2) development of locally relevant and culturally responsive digital content; (3) ongoing professional development for teachers in digital pedagogy; (4) participatory governance models utilizing hybrid public-private partnerships; and (5) human-centered platform design tailored for low-bandwidth environments and integrating these enablers within a working system positions inclusive digital education as both a technological and socio-institutional reform. The proposed conceptual model supports Nigeria’s digital education transformation agenda and aligns with Sustainable Development Goal 4 (SDG 4), which advocates for inclusive and equitable quality education.},
  keywords={Modeling;Learning (artificial intelligence);Sustainable development;Technology;Digital divide;Design methodology;Printing;Digital intelligence;Rivers;Artificial intelligence;Digital Divide;Inclusive Education;Sustainable Development;Digital Literacy;SDG4},
  doi={10.1109/CTUS-EMEA68989.2025.11592293},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{7784233,
  author={Ayodele, Solomon Oluyinka and Oga, Ojoko Edo and Bundot, Yohanna Garba and Ogbari, Mercy Ejovwokeoghene},
  booktitle={2016 6th International Conference on Information Communication and Management (ICICM)}, 
  title={Role of power supply towards e-learning acceptance: VBSEM-AMOS}, 
  year={2016},
  volume={},
  number={},
  pages={151-155},
  abstract={Around the World, advents of e-learning and its applications have given tertiary establishments a better operating system to broaden their educational system via invents like the internet which offers learners with versatility and ubiquity to embrace e-learning education anywhere and at anytime. Unfortunately, in Nigeria, minimal studies have been conducted to explore the factors conducive to students' acclaimed versatility regarding e-learning. This study applied Technology Acceptance Model (TAM) as foundation to investigate Nigerian students' perception to embrace e-learning. Variance Based Analysis-Amos was employed on the 869 responses from students in five Nigerian tertiary establishments. This study revealed power supply, technical resources, perceptive usefulness and ease as significantly important to embracing e-learning when regressed on intent to e-learning. Except ease of use and technical resources, all the factors paths regressed were significant to e-learning acceptability. Squared multiple of 74% accomplished, findings and recommendations were thereafter presented.},
  keywords={Electronic learning;Power supplies;Mathematical model;Internet;Business;Electronic mail;elearning;TAM;VBSEM},
  doi={10.1109/INFOCOMAN.2016.7784233},
  ISSN={},
  month={Oct},}@ARTICLE{8030300,
  author={Audhkhasi, K. and Rosenberg, A. and Saon, G. and Sethy, A. and Ramabhadran, B. and Chen, S. and Picheny, M.},
  journal={IBM Journal of Research and Development}, 
  title={Recent progress in deep end-to-end models for spoken language processing}, 
  year={2017},
  volume={61},
  number={4/5},
  pages={2:1-2:10},
  abstract={End-to-end models (or sequence-to-sequence models) based on deep neural networks have recently become popular within the machine learning community. These techniques are also increasingly used in automatic speech recognition as an alternative to the state-of-the-art, hybrid HMM-DNN (hidden Markov model, deep neural network) system. The end-to-end systems contain a purely neural architecture that eliminates the need of any time alignment between the input acoustic feature vector sequence and output phone sequence. In this paper, we present progress within the IBM Watson Multimodal Group on end-to-end models for spoken language processing. We present our work on two types of end-to-end models applied to speech-to-text and keyword search tasks, namely, 1) recurrent neural networks (RNNs) based on connectionist temporal classification loss, and 2) attention-based encoder–decoder RNNs. We present results on several languages (such as Pashto, Mongolian, Javanese, Amharic, Guarani, Dholuo, Igbo, and Georgian) from the Intelligence Advanced Research Projects Activity funded Babel Program. We also present a detailed analysis of some salient characteristics of these models compared with the state-of-the-art HMM-DNN hybrid systems, and also discuss future challenges in using such models for spoken language processing.},
  keywords={Hidden Markov models;Acoustics;Decoding;Training;Recurrent neural networks;Mathematical model},
  doi={10.1147/JRD.2017.2701207},
  ISSN={0018-8646},
  month={July},}@INPROCEEDINGS{10630428,
  author={A, Adeyemo Oluwaseyi and O, Bakare Kaosara and A., Oguntimilehin and Aweh, Opani M. and Okebule, Toyin},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={Location-based Tourism Recommender System using Swarm Intelligence}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The developments in social networks and internet technologies have drawn researchers from around the world to investigate recommender systems for developing customized location-based services. The overload of information is challenging for people to make decisions and literature opined that little work has been done using swarm intelligence for tourism in Nigeria. The aim is to develop a location-based tourism recommender system using swarm intelligence. The system development approach adopted in this work is the spiral model. The bat, wolf, firefly, and grey algorithms were considered in the development of the recommender model. The data used for analysis was sourced from the TripAdvisor dataset consisting of attraction places, restaurants, and hotels in some southwest states in Nigeria as well as Lagos and Abuja, and visualized using various Python libraries. The results were experimentally validated on the TripAdvisor dataset to show the performance and efficiency of the system. In the comparison of the various algorithms, the recommender model which used the firefly algorithm had mean square error, root mean square error, and mean absolute error that were lower at 0.81262, 0.90145, and 0.66184 respectively. The firefly algorithm was further developed using a collaborative technique and then integrated into a web application that makes recommendations for a tourist. The latter improved the performance of the system when applied to the TripAdvisor dataset. This work will assist tourists in recommending comparable destinations that are most relevant to them.},
  keywords={Spirals;Social networking (online);Data visualization;Mean square error methods;Libraries;Particle swarm optimization;Root mean square;Recommender system;Swarm Intelligence;Collaborative Technique;Optimization;Firefly Algorithm;Location-Based Services},
  doi={10.1109/SEB4SDG60871.2024.10630428},
  ISSN={},
  month={April},}@INPROCEEDINGS{10465321,
  author={Ifedayo, Osideinde and Abayomi-Alli, Adebayo and Folorunso, Olusegun and Alabi, Orobosade and Omoyiola, Bayo Olushola},
  booktitle={2023 First International Conference on the Advancements of Artificial Intelligence in African Context (AAIAC)}, 
  title={Opinion Mining of Heterogenous Social Media Reviews on the Proposed Adoption of eNaira}, 
  year={2023},
  volume={},
  number={},
  pages={1-8},
  abstract={The Nigerian eNaira version launched recently was aimed at deploying digital currency services for the Nigerian monetary market. The opinion of Nigerians towards the adoption of the eNaira was conducted in this study. The methodology entails eNaira review acquisition from opinion mining reviews across heterogeneous social media platforms, text pre-processing, and sentiment analysis of tokenized review corpus. A dataset of 29505 unigram textual corpus was analysed to determine the positive, negative, and neutral sentiments expressed in their polarities. The pre-processing involved stop-word removal, stemming, lemmatization, Part-of-Speech tagging, entity tagging and tokenization. The opinion mining methodology deployed the Valence Aware Dictionary and Sentiment Reasoner (VADER) approach for the sentiment analysis of the eNaira tweets. The experimental results showed 56.25 %, 22.76% and 20.98% neutral, positive, and negative sentiments, respectively towards the adoption of the eNaira. The unigram analysis of the tokenized corpus likewise returns tokens including ‘app’, ‘bvn’ and ‘password’ as the most prominent unigram tokens while the bigram analysis returns (‘reset’, ‘password’) and (‘sent’, ‘email’) as the most prominent 2-word phrase with highest information gain. The result shows that eNaira enjoys favourable consideration for electronic commerce transaction.},
  keywords={Sentiment analysis;Reviews;Social networking (online);Online banking;Blogs;Tagging;Tokenization;Digital Currency;eNaira;Opinion mining;Sentiment analysis;Social media;VADER},
  doi={10.1109/AAIAC60008.2023.10465321},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{6799874,
  author={Udofia, K. M. and Emagbetere, J. O.},
  booktitle={2013 International Conference on Connected Vehicles and Expo (ICCVE)}, 
  title={Development of multi-agent ANFIS-based model for urban traffic signal control}, 
  year={2013},
  volume={},
  number={},
  pages={662-669},
  abstract={In this paper, an adaptive neuro-fuzzy inference system (ANFIS) based model for urban traffic signal control was developed. The ANFIS-based control scheme adaptively controls phase sequence and phase lengths to ensure smooth flow of traffic, decrease traffic delays and hence enhance effective road usage. In this design, a multiagent approach was adopted, and an agent (ANFIS-based) used traffic information such as queuelength and waiting time in an intersection, and queuelengths information received from agents of neighboring intersections, to effectively and efficiently control traffic in real-time at any given intersection. A simulator is developed using MATLAB/SIMULINK software for a network of eight intersections in Uyo Metropolis of eastern Nigeria as a case study. Performance evaluation results showed that for three different traffic volume scenarios considered, ANFIS-based traffic control scheme significantly outperforms the existing and optimized fixed-time controls in terms of delay, throughputs and queuelength.},
  keywords={Equations;Vehicles;Mathematical model;Traffic control;Adaptation models;Fuzzy logic;Firing;Multi-agent;adaptive;neuro-fuzzy inference system;Vehicle Traffic control;traffic model},
  doi={10.1109/ICCVE.2013.6799874},
  ISSN={2378-1297},
  month={Dec},}@INPROCEEDINGS{8010751,
  author={Papanagnou, Christos I. and Matthews-Amune, Omeiza},
  booktitle={2017 IEEE 19th Conference on Business Informatics (CBI)}, 
  title={An Estimation Model for Hypertension Drug Demand in Retail Pharmacies with the Aid of Big Data Analytics}, 
  year={2017},
  volume={01},
  number={},
  pages={463-470},
  abstract={The unpredictability of consumer preference observed in the last few years has coincided with the global digital data explosion as consumers are increasingly relying on internet information to guide their buying behaviour. The emergence of this trend has resulted in demand volatility and uncertainty in the retail industry, leading to negative consequences on inventory control and on shareholder profits in the long-run. This paper examines whether retail pharmacies in Abuja, Nigeria may exploit the increasing availability of relevant big data (structured, semi-structured and unstructured) from different sources to enhance the existing information regarding the demand for antihypertensive medication. In order to examine this, we consider a VARX model with non-structured data as exogenous to obtain the best estimation.},
  keywords={Hypertension;Supply chains;Google;Companies;Forecasting;Data models;big data analytics;hypertension;demand estimation;retail pharmacies},
  doi={10.1109/CBI.2017.18},
  ISSN={2378-1971},
  month={July},}@INPROCEEDINGS{9688052,
  author={Borsdorf, Marvin and Li, Haizhou and Schultz, Tanja},
  booktitle={2021 IEEE Automatic Speech Recognition and Understanding Workshop (ASRU)}, 
  title={Target Language Extraction at Multilingual Cocktail Parties}, 
  year={2021},
  volume={},
  number={},
  pages={717-724},
  abstract={Typically, target speaker extraction seeks to extract a target speaker's contribution according to his or her individual voice characteristics. In a “multilingual cocktail party” however, listeners may desire to extract speaker contributions spoken in a particular language, regard-less of the number of contributing speakers. In this paper, we pro-pose a novel task called “target language extraction” (TLE) which extracts voices based on the spoken language rather than on individ-ual speaker characteristics. We introduce a new database for TLE which simulates the multilingual cocktail party problem in mixtures of two and four speakers with German as the target language. The database is derived from the GlobalPhone 2000 Speaker Package and is called “GlobalPhone Multilingual Cocktail Party - German” (GlobalPhoneMCP-GE). Our experimental results show that our approach to TLE achieves very good performance regardless of the number of speakers in the mixture and that TLE generalizes well to unseen speakers and interfering languages. This work represents the first attempt at target language extraction.},
  keywords={Databases;Conferences;Task analysis;Automatic speech recognition;Target language extraction;selective auditory attention;multilingual;GlobalPhone;cocktail party problem},
  doi={10.1109/ASRU51503.2021.9688052},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10767565,
  author={Azeta, Ambrose A. and Adewale, Muyideen D. and Omote, Patrick O. and Onaolapo, Funmi O. and Bakare, Idowo A. and Tjiraso, Steven},
  booktitle={2024 International Conference on Emerging Trends in Networks and Computer Communications (ETNCC)}, 
  title={Comparative Analysis of Random Forest and Multilayer Perceptron Algorithms for Predicting Gross Domestic Product}, 
  year={2024},
  volume={},
  number={},
  pages={453-459},
  abstract={This study examines the efficacy of machine learning techniques, particularly Multilayer Perceptron (MLP), and Random Forest and in forecasting Nigeria's Gross Domestic Product (GDP). Traditional statistical methods frequently fail to capture intricate, nonlinear relationships, thus necessitating advanced techniques. The dataset employed in this research encompasses 22 instances from 2000 to 2021. It includes variables such as GDP, healthcare expenditure, population, and the index of economic freedom obtained from the World Bank as well as the Nigerian Perceptions Index for corruption. The data was prepared to undergo training and testing following the CRISP-DM methodology. The models were trained and evaluated using a five-member cross-validation method. Performance metrics indicated that MLP outperformed Random Forest, with MAE values of 16.8228 and 25.3074 and RMSE values of 23.2111 and 33.2027, respectively. These findings suggest that MLP offers more accurate GDP predictions for Nigeria, effectively managing complex data relationships. This study provides valuable insights for enhancing predictive accuracy and supporting more effective economic planning and decision-making.},
  keywords={Training;Machine learning algorithms;Accuracy;Economic indicators;Biological system modeling;Multilayer perceptrons;Predictive models;Prediction algorithms;Random forests;Testing;GDP;Five-member Cross-Validation;Machine learning;Multilayer Perceptron;Random Forest},
  doi={10.1109/ETNCC63262.2024.10767565},
  ISSN={},
  month={July},}@INPROCEEDINGS{10630249,
  author={Ale, Felix and Ikpaya, Ikpaya D. and Daniyan, Ilesanmi and Opateye, Goodness O. and Onwodi, Gregory and Agboola, Olufemi O.},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={Application of Machine Learning Models for Predicting Students' Performance in Mathematics: A K-Fold Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={Mathematics plays a pivotal role in science, technology and engineering. It is one of the compulsory subjects to gain admission into a higher institution in Nigeria. Considering its importance, students' performance has been a significant concern for most educators, government, parents and guardians. This study aims to predict students' performance in mathematics using the K-fold approach to support effective decision-making and policy implementation on mathematics. The primary dataset was collected from 192 senior secondary schools, and one mathematics student was randomly selected from five Senior Secondary Schools in Bwari Area Council, Abuja, and used as a sample. Students' Mathematics Achievement Test (SMAT) was used as the instrument to collect data. The data was processed and modelled using the Python Programming language. Thus, five machine learning models were trained and evaluated to overcome overfitting using four-, five---, and six-fold K-Fold cross-validation techniques. Five folds performed best for all the models except for the Support Vector Regressor, which performed best with six folds. The evaluation of the models showed that the Light Gradient Boosting Model outperformed others with a Mean Absolute Error of 12.642 and a Root Mean Square Error of 15.894. The models were significantly influenced by the students' personal study time, friends' assistance, and the parents' educational background. It is therefore recommended that academic researchers, educational authorities in Nigeria, and relevant stakeholders use and improve on this model to predict the students' scores and assist them in achieving great performance in mathematics.},
  keywords={Instruments;Predictive models;Mathematical models;Mathematics;Vectors;Stakeholders;Sustainable development;Root mean square;STEM;Python;K-fold approach;Machine learning models;Mathematics;Prediction;SMAT},
  doi={10.1109/SEB4SDG60871.2024.10630249},
  ISSN={},
  month={April},}@INPROCEEDINGS{9077661,
  author={Nwankwo, Wilson and Ukhurebor, Kingsley and Ukaoha, Kingsley},
  booktitle={2020 International Conference in Mathematics, Computer Engineering and Computer Science (ICMCECS)}, 
  title={Knowledge Discovery and Analytics in Process Reengineering: A Study of Port Clearance Processes}, 
  year={2020},
  volume={},
  number={},
  pages={1-7},
  abstract={Due to the nature of the transactions involved in imports and the security threats associated with it, most nations have put agencies and machineries in place for regulating and monitoring the flow of trade. The objectives of these agencies include but not restricted to monitoring of trade transactions; revenue generation, facilitation of trade, policy and decision making, etc. Risk management is a major segment of the clearance process at the port and is consistently advocated by the world customs organization (WCO) and the world trade organization (WTO) respectively. In Nigeria, the Nigeria Customs Service (NCS) performs this function with the aid of Automated System for Customs Data (ASYCUDA) first implemented in 2006 during the modernization project of the Federal Government of Nigeria and now modernized as the Nigeria Customs Information System (NICIS). This study reviews the present imports clearance process to identify areas that may be remedied through process re-engineering using analytics. It adopts a hybrid methodology comprising descriptive methods, object-based and knowledge-based modeling with the aim of establishing a reliable model that could be integrated to advance the existing imports process and clearance process. The proposed model uses the k-means algorithm to discover pertinent patterns and trends with respect to areas that need enhancement thus helping the relevant authorities in achieving a competent and effective clearance process driven by knowledge-based process re-engineering.},
  keywords={Systems operation;Knowledge based systems;Neural networks;Knowledge discovery;Mathematical models;Security;Risk management;Knowledge discovery;Analytics;Risk management systems;Business process re-engineering;Predictive modeling},
  doi={10.1109/ICMCECS47690.2020.246989},
  ISSN={},
  month={March},}@INPROCEEDINGS{11467974,
  author={Segera, Davies and Kahati, Lennox and Odimas, Bradley and Tito, Ben},
  booktitle={2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)}, 
  title={Bridging Climate Change and Public Health: An Inclusive IVR Framework for Disease Surveillance}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={There is an increase in climate change illnesses such as malaria, cholera, and heat-stress in Kenya and Nigeria, yet so many districts encounter problems in data collection such as: relying on paper logs which reach the public-health offices weeks later, time consuming and costly physical visits. We co-designed an Interactive Voice Response (IVR) system (based on English) that works on any smart-feature phone. Using a mixed-method approach informed by the Unified Theory of Acceptance and Use of Technology (UTAUT), we conducted surveys and interviews in Ilaje-Bariga, Lagos. A six-week pilot in North-Central Nigeria (January to April 2025) generated 5660 IVR responses, plus 123 in-person interviews with health workers, patients, and caregivers. Participants were recruited through a purpose-convenience sampling and had to be residents of Ilaje-Bariga aged 18 years and above with healthcare or caregiving experience; those who did not provide consent were excluded. Most (95.1%) had at least secondary education, providing a diverse but locally representative sample of those who can use the english-based version of the IVR. The pilot collected 5,660 clean records. The Task Completion Rate (TCR) was 80.2% and the Not Completing Rate (NCR) 19.8%, with only 691 records needing retries, indicating low errors and latency. A lightweight (native that does not need cloud processing through API (Application Programming Interface) IVR can cut disease-reporting delays from weeks to hours. Next steps include DHIS2 integration and cost-effectiveness testing across Nigerian states.},
  keywords={Low earth orbit satellites;Feedback;Circuits;Communication systems;Internet;Internet of Things;Amplitude shift keying;Protocols;Low latency communication;Radio access networks;IVR;Climate Change;Public Health Surveillance;DHIS2;UTAUT;Data Collection},
  doi={10.1109/ACDSA67686.2026.11467974},
  ISSN={},
  month={Feb},}@ARTICLE{10540388,
  author={Tang, Gongbo and Yousuf, Oreen and Jin, Zeying},
  journal={IEEE Access}, 
  title={Improving BERTScore for Machine Translation Evaluation Through Contrastive Learning}, 
  year={2024},
  volume={12},
  number={},
  pages={77739-77749},
  abstract={BERTScore is an automatic evaluation metric for machine translation. It calculates similarity scores between candidate and reference tokens through embeddings. The quality of embeddings is crucial, but embeddings of low-resource languages tend to be poor. Multilingual pre-trained models can transfer knowledge from rich-resource languages to low-resource languages, but embeddings from these models are not always well aligned. To improve BERTScore for low-resource languages, we attempt to align embeddings by fine-tuning pre-trained models via contrastive learning which shortens the distance between semantically similar sentences and increases the distance between dissimilar sentences. We experiment on Hausa, a low-resource language, in the WMT21 English-Hausa translation task. We conduct fine-tuning on three different pre-trained models (XLM-R, mBERT, LaBSE). Our experimental results show that our proposed method not only achieves higher correlation with human judgments than original BERTScore, but also surpass surface-based metrics such as BLEU, chrF, and the state-of-the-art metric COMET, when fine-tuning mBERT. Moreover, our proposed method generates better embeddings than pre-trained embedding models (E5, BGE, M3E) which are fine-tuned on different NLP tasks. We also extend our experiments to Chinese, a rich-resource language, in an English-Chinese translation task, and further confirms the effectiveness of our method.},
  keywords={Task analysis;Measurement;Computational modeling;Data models;Correlation;Comets;Mathematical models;Contrast resolution;Natural language processing;Translational research;BERTScore;contrastive learning;low-resource languages;machine translation evaluation},
  doi={10.1109/ACCESS.2024.3406993},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9497305,
  author={Mokeddem, Mohamed Lakhdar and Belahcene, Mebarka and Bourennane, Salah},
  booktitle={2021 1st International Conference On Cyber Management And Engineering (CyMaEn)}, 
  title={Yolov4FaceMask: COVID-19 Mask Detector}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={The rampant COVID-19 disease has brought global crisis with its deadly spread to most countries in the world, and about over 58 million confirmed cases along with 1.4 million deaths on April 2021. The absence of any active therapeutic agents and the lack of immunity against COVID-19 increase the population's vulnerability. Since there are efficient vaccines but it is not available to all worldwide, Especially the inhabitants of the third world, in addition the appearance of mutated copies (Indian version, Nigerian version ⋯), properly wearing masks in public areas is one of the major protection methods for people. Although it is important to wear the facemask correctly, there are not much research studies about facemask detection based on image processing. In this work, we propose Yolov4FaceMask, which is a model with high accuracy and can detect Masked/IncorrectMask/UnMasked faces. The main challenging point of this task is the absence of practical datasets. For this, we introduce our new practical dataset, which contains 14409 images. Experiments show that the Yolov4FaceMask achieves 88.82% mAP on our proposed dataset. This paper presents a Deep Learning (DL) based framework for automating face-masked/incorrect mask/unmasked people's detection using images and surveillance video and the library OpenCV for image processing. Our proposed model uses the object detection model named YOLOv4 to segregate human's faces from the background. The Yolo4FaceMask results are further compared with other popular state-of-the-art models of face mask detection, e.g. Face-mask InceptionV3 and SSDMNV2 and RetinaFaceMask in terms of mean Average Precision (mAP).},
  keywords={COVID-19;Computational modeling;Surveillance;Detectors;Object detection;Feature extraction;Vaccines;Detection;Localisation;Deep Learning;Classification;Convolutional Neural Network;Yolov4},
  doi={10.1109/CyMaEn50288.2021.9497305},
  ISSN={},
  month={May},}@INPROCEEDINGS{11592086,
  author={Sunday, Olowofela S. and Fayomi, Ojo S.I. and Tafa, Adebimpe},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Assessment of Power Generation Trends using Matlab-Based Predictive and Simulation Techniques}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Nigeria has long struggled with chronic electricity generation and supply difficulties, despite having an abundance of natural and renewable energy resources. However, industrial productivity, the provision of health services, and access to education have all been severely hampered by the disparities between the generation, supply, and rising population demand for energy. Data was obtained from the National Control Centre, Oshogbo, Osun State. Nigeria. These data was imported, went through initial inspection, through cleaning and got converted into MATLAB time-table structure This study uses simulation and prediction methods based on MATLAB R2022b to examine the trends in electricity generation in Nigeria. Econometric toolbox was used to implement ARIMA (Autoregressive Integrated Moving Average) and DeepLearning toolbox was used for training the LSTM (Long Short-Term Memory recurrent neural Network). Both were used to simulate five years data (2019-2023) and prediction were made for Short term 2024,Medium term 2024-2026 and Long term 20242028. These findings used statistical inference, machine learning, and predictive analysis to estimate generating patterns and evaluate accuracy. The results show that Nigeria’s power generation trend is significantly below the installed capacity and needs immediate action. Therefore, the LSTM model is more reliable and suitable for long-term power generation forecasting, as it provides higher accuracy, better fit, and minimal bias compared to the traditional ARIMA model.},
  keywords={Modeling;Electricity;Energy;Power generation;Forecasting;Long short term memory;Printing;Equations;Renewable energy sources;MATLAB;MATLAB;electricity;ARIMA;LSTM;statistical inference},
  doi={10.1109/CTUS-EMEA68989.2025.11592086},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11636747,
  author={Suleymanli, Samir and Ozkan, Merve and Aykaç, Yusuf Evren and Samet, Refik},
  booktitle={2026 34th Signal Processing and Communications Applications Conference (SIU)}, 
  title={Explainable AI (XAI) for Sentiment Analysis in low-resource languages}, 
  year={2026},
  volume={},
  number={},
  pages={1-4},
  abstract={Natural Language Processing has achieved progress for high-resource languages, but low-resource African languages remain underserved. This paper presents an XAI framework for sentiment analysis in Swahili and Hausa. We fine-tune the afro-xlmr-small model and integrate Integrated Gradients, LIME, and SHAP to analyze model decisions. We introduce fidelity metrics to assess explanation quality and investigate biases related to loanwords and entities, alongside cultural validation. Results show that dataset quality and class balance are the primary determinants of performance in these settings.},
  keywords={Modeling;Explainable AI;Barium;Conferences;Testing;Geographic information systems;Natural language processing;Explainable AI;Sentiment Analysis;Low-Resource Languages;Swahili;Hausa;Bias Detection;Cultural Validation;Cross-Lingual NLP},
  doi={10.1109/SIU71813.2026.11636747},
  ISSN={2165-0608},
  month={July},}@INPROCEEDINGS{11592176,
  author={Erinosho, Tolulope Christiana and Abayomi, Addultaofeek and Abayomi, Abdultaofeek and Akinwale, Kamoli Amusa and Olorunnishola, Taiwo and Adetiba, Emmanuel and Olaitan, Olutoyin},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Development of a Deep-Learning Web-Based Pathogen Diagnosis System for Selected Staple Crops in Africa}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Agriculture faces significant challenges in sustainability, particularly in managing crop diseases. Maize and cassava, two vital crops for economic stability and food security, are greatly liable to diseases that can result in significant yield losses. Traditional disease detection methods, such as visual scouting and laboratory analysis, are both time and labor intensive, and also require expert knowledge, thus posing challenges for smallholder farmers. This study leverages deep learning to develop a web-based classification system for maize and cassava disease detection, providing an accessible and efficient solution. The system utilizes datasets sourced from Kaggle and local farms in Nigeria. Two Convolutional Neural Network (CNN) models were implemented for each crop: a fine-tuned MobileNetV2 and a custom CNN model for maize, and a finetuned ResNet-50 alongside a custom CNN model for cassava. A user-friendly interface built with Streamlit is included in the system which was deployed on Hugging Face, to allow real-time classification and actionable recommendations for users. Data pre-processing, comprising augmentation techniques improved model performance and reliability while addressing class imbalances. The fine-tuned MobileNetV2 model achieved 89% accuracy for maize, outperforming the custom CNN at 84%. For cassava, the fine-tuned ResNet-50 model achieved an accuracy of 48%, while the custom CNN model improved classification accuracy to $\mathbf{7 1 \%}$. The system was further validated using leafy images collected from a local farm in Southwestern Nigeria, demonstrating practical applicability. This scalable tool empowers smallholder farmers to detect maize and cassava diseases early, mitigate economic losses, and promote food security. Our focus in future study will expand the current datasets to comprise various environmental conditions, refining model architectures to communicate with the local farmers in the study area in their native language.},
  keywords={Modeling;Diseases;Convolutional neural networks;Crops;Machine learning;Accuracy;Training;Printing;Testing;Timing;Deep Learning;Agriculture;Maize;Cassava;Disease Diagnosis},
  doi={10.1109/CTUS-EMEA68989.2025.11592176},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10630019,
  author={Toyin, Okebule and Adeyemo, Oluwaseyi A. and Oguntimilehin, Abiodun and Obamiyi, Stephen E. and Badeji-Ajisafe, Bukola and O. B, Abiola and Aweh, Opani M. and O. A, Sanya and Akinduyite, Christianah O.},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={A Comparative Analysis of Selected Machine Learning Classifiers for Early Detection of Breast Cancer}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Breast cancer is the principal causes of death among women in Nigeria and the world at large. The high prevalence of breast cancer in women has rapidly increased in recent decades. X-ray mammography and magnetic resonance imaging (MRI) are currently the major methods used to diagnose cancer in Nigeria. Machine learning techniques are the trendiest tool of the 21st century for discovery where intelligent approaches are utilized to detect breast cancer classification patterns. A technique for excellently recognizing and forecasting early cancer of the breast is needed by specialists for an unequivocal detection. This work provides a comparative analysis of selected Machine Learning classifiers for early detection of breast cancer. Locally dataset was obtained from Ekiti State University Teaching Hospital. Statistical approaches were employed to clean the data by assigning the missing value based on the neighboring feature values, in contrast to other methods that exclude all cases. This study examined three of Machine Learning techniques - Support Vector Machine (SVM), Logistic Regression (LR), and Naive Bayes (NB) models on the basis of which we idetified the best predictive model. Accuracy, Precision, Recall, and F1 Score metrics were implemented for evaluating each model’s performance using python programing language. The findings of this study demonstrate that the suggested SVM-based model has greater promise for breast cancer classification than the LR and NB classifiers yielding a 96% accuracy rate and suggested that the mechanism is effective than traditional techniques when assessed using several indicators of effectiveness to detect breast cancer.},
  keywords={Support vector machines;Logistic regression;Accuracy;Magnetic resonance imaging;Machine learning;Predictive models;Breast cancer;Breast Cancer;Machine Learning;Accuracy;Precision;Recall},
  doi={10.1109/SEB4SDG60871.2024.10630019},
  ISSN={},
  month={April},}@INPROCEEDINGS{11060497,
  author={Baadel, Said and Bassey, Brian and Uzoka, Faith-Michael},
  booktitle={2025 IST-Africa Conference (IST-Africa)}, 
  title={Enhancing Public Health Outcomes: Machine Learning for Early Dengue Fever Detection in Low- and Middle-Income Countries}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Dengue fever remains a significant public health concern, especially in low- and middle-income countries (LMICs) like Nigeria, where its prevalence is driven by a combination of socioeconomic and environmental factors. This study explores the application of machine learning (ML) techniques to enhance the diagnosis of dengue fever, with a focus on rule-based classifiers to provide greater transparency and interpretability in medical decision-making. The dataset comprised over 4,800 patient records obtained from secondary and tertiary healthcare facilities in the Niger Delta region of Nigeria, with contributions from 62 experienced physicians specializing in febrile illnesses. Two rule-based classifiers, RIPPER and PART, were employed to assess their effectiveness in predicting dengue fever cases using causative data. Both models demonstrated similar performance in accuracy, sensitivity and precision indicating their strength in accurately identifying true dengue cases, which is critical for timely intervention and treatment. This study will benefit the different public stakeholders as it underscores the potential of rule-based ML models to improve the accuracy of dengue fever diagnoses in LMICs, enhancing public health efforts and optimizing resource allocation in poorer African regions where dengue is endemic.},
  keywords={Accuracy;Sensitivity;Dengue fever;Machine learning;Stakeholders;Resource management;Public healthcare;Socioeconomics;Viruses (medical);Medical diagnostic imaging;dengue fever;low-to-middle-income countries;machine learning;rulebased classifiers},
  doi={10.23919/IST-Africa67297.2025.11060497},
  ISSN={2576-8581},
  month={May},}@INPROCEEDINGS{11508033,
  author={K, Karthikeyan and V, Tamil Azhagi and M, Gokulnath},
  booktitle={2026 International Conference on Smart Futuristic Technology}, 
  title={An Context-Aware Simultaneous Translation for the Classroom Using an Adaptive Terminology-Guided Approach}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Real-time captioning and translation enhance accessibility in multilingual classrooms, particularly for English–Indie language pairs, by providing immediate bilingual scaffolding that improves comprehension for students who prefer native languages while lectures are delivered in English. Traditional fixed wait-k approaches face latency-quality trade-offs and struggle with domain-specific terminology, leading to unstable captions and mistranslations in unstructured, pause-rich lecture speech. This paper proposes a context-aware framework combining Whisper-based streaming ASR with NLLB/IndicTrans2 MT, supported by CTranslatel for efficient inference and deployment. An adaptive wait-k controller minimizes delay using ASR confidence and pause detection, while glossary-guided decoding improves terminology accuracy without full fine-tuning Evaluations on FLORES-200, FLEURS, and lecture-style Samanantar subsets show that the adaptive approach achieves higher COMET scores at comparable latency and improves domain-specific consistency, indicating practical viability for classroom settings. The frame-work offers a scalable solution for low-latency, context-aware classroom translation to support educational accessibility in multilingual regions by leveraging robust ASR and multilingual MT with optimized inference backends.},
  keywords={Terminology;Automatic speech recognition;Translation;Aluminum;Decoding;Modeling;Streams;Printing;Stability;Multilingual;Simultaneous Speech Translation;Low-Latency Processing;Adaptive Wait-k Policy;Streaming Automatic Speech Recognition (ASR);Neural Machine Translation (NMT);Indic Language Pairs;Accessible Education;Terminology-Constrained Decoding},
  doi={10.1109/ICSFT66733.2026.11508033},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10124617,
  author={Ajani, Adegbenro Sunday and Ogunbode, Olusoji Amos and Egbeyale, Godwin Babatunde and Odeyemi, Charity Segun and Babalola, Adedoja Feyisayo and Oyero, Peter Olaoluwa},
  booktitle={2023 International Conference on Science, Engineering and Business for Sustainable Development Goals (SEB-SDG)}, 
  title={Construction of a Low-Power Rating FM Transmitter Radio with Audio Console for Community Broadcast and Security Alert}, 
  year={2023},
  volume={1},
  number={},
  pages={1-5},
  abstract={The security challenges experienced in different communities of Nigeria require initiatives from every stakeholder, hence the development of this miniaturized FM transmission console for information dissemination within a localized community. The early transmitter for radio broadcasting was so bulky and laborious that they occupied large space and heavy circuitry. The circuits were mainly designed with valves and other active components, which are responsible for the large size. With the advent of semiconductor materials such as transistors and integrated circuits, electronic equipments are now becoming miniaturized such that small transmitters are now becoming handy and compact. In line with this, a complete radio broadcasting equipment that is compact and locally designed is constructed in this research. The system units are of two categories namely: the audio console for processing voice with music mixer and the transmitter unit where the center frequency is generated. This project is aimed at serving community such as Estates or villages for broadcasting urgent information using a small radio broadcasting FM transmitting at 107.0 MHz with a power rating of 1 watt and covers a distance of 1 kilometer irrespective of directivity. The output audio signal was tested for different hours of the day and production was received with noticeable voice output. The radio broadcasting transmitter can also be used to disseminate information within large industries, hospitals and universities. The constructed device is recommended for security alerts in areas where security challenges are currently taking place in the Nigeria.},
  keywords={Frequency modulation;Semiconductor materials;Radio transmitters;Vegetation;Valves;Security;Transistors;Transmitter;audio console;modulator},
  doi={10.1109/SEB-SDG57117.2023.10124617},
  ISSN={},
  month={April},}@INPROCEEDINGS{9803159,
  author={Olajuwon, Lagodo Hafis and Faruk, Nasir and Oloyede, Abdulkarim A. and Sowande, Olugbenga. A. and Abdulkarim, Abubakar and Olawoyin, Lukman A. and Adediran, Yinusa A.},
  booktitle={2022 IEEE Nigeria 4th International Conference on Disruptive Technologies for Sustainable Development (NIGERCON)}, 
  title={Efficacy of some Unpopular PathLoss Propagation Models in the VHF and UHF Bands}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Several research efforts that have been made for decades in testing the performance of channel models have concentrated on the widely (popular) used models; little efforts have been made towards testing other models, termed as non-widely (unpopular) models. Therefore, this paper tested the efficacies of some non-widely used models for wider applicability in Nigeria environment across VHF (Very High Frequency) and UHF (Ultra High Frequency) bands. Error analyses were conducted. Findings show that Hata model, which is among the most widely used models, has performed better than all the models considered. Even though Walfisch Ikegami and Walfisch Bertoni models are considered unpopular, their performance isn’t as bad as perceived by researchers globally. The models performed credibly well in the UHF bands and fairly in the VHF bands. However, Knife edge model performed woefully, despite that it is one of the most cited model amongst all the contending models considered. Other unpopular models (Lee, Green-Obaidat, Desouza-Lins and Edwards-Durkin) performed terribly bad across all routes and bands.},
  keywords={Error analysis;Conferences;Green products;UHF measurements;Predictive models;Propagation losses;Loss measurement;Path Loss;Hata;Unpopular Models;Nigeria;LEE;GREEN-Obaidat;Desouza-Lins;Edwards-Durkin},
  doi={10.1109/NIGERCON54645.2022.9803159},
  ISSN={2377-2697},
  month={April},}@INPROCEEDINGS{10033298,
  author={Sobanke, Victor Oluwasina},
  booktitle={2022 IEEE 28th International Conference on Engineering, Technology and Innovation (ICE/ITMC) & 31st International Association For Management of Technology (IAMOT) Joint Conference}, 
  title={Determinants of Manpower Utilisation in Manufacturing Firms}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={Debate on the employability of high-level manpower in Nigeria has continued to draw the attention of various stakeholders in governments, academia, labour organisations, employers, and unemployed persons. This paper, therefore, examined the factors influencing the utilisation of manpower in manufacturing firms in the Southwest of Nigeria. The study employed a quantitative research approach by collecting data from 229 employees of Food and Beverage processing companies selected for the survey using random and snowballing sampling techniques. The study measurement model was assessed using exploratory and confirmatory factor analyses while the hypothesised model was tested using a structural equation model. Results showed that employees' career-skills utilisation was influenced by social $(\beta=0.497$; $p < 0.001)$ and organisational $(\beta=0.233;p < 0.001)$ factors; and the employees' level of job satisfaction was influenced by personal $(\beta={-}0.140;p < 0.001)$, social $(\beta=0.324;p < 0.001)$ and family $(\beta=\ 0.611;\ p < 0.001)$ factors while only social $(\beta=0.499;p < 0.01)$ factor influences employees' willingness to change. The study concludes that employees' social, organisational and family attributes are crucial for the utilisation of manpower in Nigeria.},
  keywords={Analytical models;Technological innovation;Engineering profession;Government;Companies;Mathematical models;Social factors;Manpower utilisation;Human resources;Structural equation modelling;Food and Beverage companies;Measurement model},
  doi={10.1109/ICE/ITMC-IAMOT55089.2022.10033298},
  ISSN={},
  month={June},}@INPROCEEDINGS{8422244,
  author={Schmidt, Aurora and Fink, Clay and Barash, Vladimir and Cameron, Christopher and Macy, Michael},
  booktitle={2018 IEEE International Conference on Communications (ICC)}, 
  title={Using Spectral Clustering of Hashtag Adoptions to Find Interest-Based Communities}, 
  year={2018},
  volume={},
  number={},
  pages={1-7},
  abstract={We investigate the use of spectral clustering of hashtag adoptions in Nigerian Twitter users between October 2013 and November 2014. This period is of interest due to the online campaign centered around the #BringBackOurGirls (BBOG) hashtag, which relates to the kidnapping of 276 Nigerian schoolgirls. We examine the adoption of hashtags during the six months before, the month after, and the six months following the kidnapping to test the informational value of behavior-based clusters discovered with unsupervised methods for predicting future hashtag usage behaviors. We demonstrate an efficient spectral clustering approach, that leverages power iteration on symmetric adjacency matrices, to group users based on hashtag adoptions prior to the kidnapping. Unlike follow networkbased clusters, these adoption-based clusters reveal groups of users with similar interests and prove to be more predictive of interest in future topics. We compare this unsupervised spectral clustering to spectral clustering based on symmetrized follow network relations as well as clusters induced by latent Dirichlet allocation (LDA) topics. We find that hashtag adoptionbased clusters perform similarly to the more computationally expensive LDA approach at identifying interest groups that are more likely to adopt future topical tags. We also benchmark the spectral clustering approach against the popular Louvain clustering approach on a synthetic dataset, finding the faster spectral clustering algorithm produces more balanced clusters with a higher similarity to the true interest groupings used to synthesize adoption data.},
  keywords={Twitter;Tagging;Sparse matrices;Clustering algorithms;Sociology;Statistics;Measurement},
  doi={10.1109/ICC.2018.8422244},
  ISSN={1938-1883},
  month={May},}@INPROCEEDINGS{11537193,
  author={Titus, Douglas Kilyobas and Baha, Benson Yusuf and Godwin, Daniel},
  booktitle={2026 8th International Congress on Human-Computer Interaction, Optimization and Robotic Applications (ICHORA)}, 
  title={Flood Prediction Framework Using an Ensemble Machine Learning Algorithm}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Floods constitute one of the most devastating natural calamities in the world, which result in massive loss of life, destruction of infrastructure and gross economic impact. The states of Adamawa, Borno and Gombe are especially prone to regular flooding in Nigeria, but there are few reliable and data driven prediction systems in the area. The paper designed and tested an ensemble machine learning model that predicts floods based on hydrometeorological variables collected by the Nigerian Bureau of Statistics and the satellite based Power API of NASA, which runs between 2019 and 2025. The dataset consisted of 4,383 records containing 13 original climate and environmental variables, which had been increased to 86 features with the help of temporal, lag, interaction, and polynomial feature engineering. The data gaps were filled with mean imputation and Box-Cox transformation was used to normalize very skewed data like precipitation, solar radiation, and wind speed. Five machine learning classifiers such as Support Vector Machine (SVM), Random Forest, Artificial Neural Network (ANN), XGBoost, and LightGBM were trained as baseline machine learning classifiers. These were also compared with four ensemble strategies including hard voting, soft voting, bagging and stacking. Randomized search was used as the hyperparameter optimization tool and 5fold cross validation was used to evaluate the model performance on various metrics such as Accuracy, Precision, Recall, F1score, AUC-ROC, and RMSE. It was found that overall accuracy was above 85 % and that the flood event detection (recall) was low in all classifiers, a result of a large class imbalance; flood occurrences only made up around 12.5 % of the data (549 flood days and $\mathbf{3, 8 3 4}$ non-flood days). LightGBM showed the superior overall performance with a cross validation F1-score of 0.1131 $\pm \mathbf{0. 0 2 8 1}$, closely followed by XGBoost with $\mathbf{0. 0 9 8 5} \pm \mathbf{0. 0 2 8 4}$. The results confirm the feasibility of satellite derived climate information to operational flood forecasting and the necessity to combat class imbalance with methods like Synthetic Minority Oversampling Technique (SMOTE) or cost sensitive learning.},
  keywords={Floods;Modeling;Machine learning;Machining;Printing;Accuracy;Training;Optimization;Ensemble learning;Forecasting;Flood Prediction;Ensemble Learning;Machine Learning;Hydro-meteorological Data;Disaster Management},
  doi={10.1109/ICHORA69329.2026.11537193},
  ISSN={2996-4393},
  month={May},}@INPROCEEDINGS{6205023,
  author={Saberi, Morteza and Azadeh, Ali and Saberi, Zahra and Pazhoheshfar, Peiman},
  booktitle={2012 International Conference on Information Retrieval & Knowledge Management}, 
  title={A knowledge management system based on artificial intelligence (AI) methods: A flexible fuzzy regression-analysis of variance algorithm for natural gas consumption estimation}, 
  year={2012},
  volume={},
  number={},
  pages={143-147},
  abstract={A knowledge management (KM) system has a different schema that one of them has been studied in the present study. One of version of KM is based on artificial intelligence (AI) methods. KM based on AI has been investigated in the present work based on natural gas consumption estimation domain. Developing accurate and flexible model to natural gas consumption estimation is a strategic step in policy and decision-making process in energy sector. This paper provides a stage algorithm during that it gains optimal fuzzy regression model for studding natural gas consumption in sixteen countries according to data in years 1989 till 2007. Different countries have selected from Africa, America, Asia, Europe and Middle East based on high, middle and low GDP index and for every one of them nine fuzzy regression models have executed and the results and error of each model have calculated. Preprocess has been done on the initial data to gain better results which the min-max method has been used for this purpose. Two criterions have been used to determining suitable and appropriate fuzzy regression model in each country. Firstly, fuzzy regression models with MAPE value below 10 is deleted from the assessment and remained fuzzy regression models are compared with ANOVA. Upon logic that given algorithm sketches for some countries none of used models are proper while for other countries optimal model is gained in first or second filter of algorithm. To show the applicability and superiority of the proposed flexible Fuzzy regression model the data for oil consumption in Japan, Thailand, Bangladesh from Asia and Norway, Italy, Bulgaria from Europe and Qatar, Iran, Iraq from Middle East and The united state, Mexico, Bolivia from North America and Libya, Tunisia, Nigeria from Africa during 1989 to 2007 are used.},
  keywords={Data models;Mathematical model;Analysis of variance;Economic indicators;Predictive models;Estimation;Natural Gas Consumption;Fuzzy Regression;ANOVA Test},
  doi={10.1109/InfRKM.2012.6205023},
  ISSN={},
  month={March},}@INPROCEEDINGS{6715657,
  author={Akinsanmi, O. and Ekundayo, K. R.},
  booktitle={2013 IEEE International Conference on Emerging & Sustainable Technologies for Power & ICT in a Developing Society (NIGERCON)}, 
  title={Application of neural network to electrostatic fields distribution pattern: A case study}, 
  year={2013},
  volume={},
  number={},
  pages={206-211},
  abstract={This paper presents the application of neural network to the electrostatic field distribution pattern modeling: a case study of Non-harmattan seasons in Zaria, Nigeria. The data was captured through an online mechanism for twenty four months (February, 2007-February, 2009) by the computer; the focus of the analysis is determining the effect of environmental factors such as temperature, pressure and relative humidity on the static electric field during the Non-harmattan season. The plots of the electrostatic field against the variation of the environmental factors were used as the qualitative analytical tools and yielded a non-linear relationship. The data was analyzed using Neural Network version 3.24 Software, to establish predictive model for the Non-harmattan period. The result of the analyses yielded good neural statistical values of Root Mean Square Error (RMSE) of 0.05, Pearson R value of 0.087 and RMSE of 0.04, R of 0.83 respectively for Non-harmattan, inside and outside Scenarios, which are reflections of a good models. The result was further buttressed by the plot of the Neural Network based Electrostatic Fields distribution pattern modeling of the experimental and predicted parameters. With the insignificant values of the RMSE, Pearson R value which are reflections of the closeness of the predicted and the experimental parameters, hence the model could be relied upon to predict the electrostatic fields during Non-harmattan season in Zaria, Nigeria.},
  keywords={Electrostatics;Neural networks;Data models;Computational modeling;Electric fields;Predictive models;Temperature measurement;Electrostatic field;Neural Network;Electrostatic field distribution pattern models;Environmental factors;Non — Hammattan Season},
  doi={10.1109/NIGERCON.2013.6715657},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{9314610,
  author={Adetona, Zacchaeus A. and Mbamaluikem, Peter O.},
  booktitle={2020 IEEE International Conference on Power and Energy (PECon)}, 
  title={Factors Affecting Load Pattern in a Tropical Electric Power Distribution Area}, 
  year={2020},
  volume={},
  number={},
  pages={35-39},
  abstract={Electric load forecasting is affected by numerous factors and these vary from one geographical location to another. The ability to identify the factors contributing to the consumption pattern in an area will help in designing an effective and exact forecasting model that will contribute to an effective energy dispatch. In this study, topical weather and various time factors contributing to the power consumption pattern of Ayobo Power Distribution Area of Lagos state, Nigeria were considered. These time factors are categorized as Working Time, Leisure Time and Sleeping Time while the weather season is categorized into dry and raining season. The results show that the load begins to rise from the baseline load and goes to its peak during the working periods and fall considerably for the other two periods. Also, the general power consumption is affected significantly by the two main weather seasons of the year in Nigeria namely wet and dry season. The cooling degree days do also affect the power consumption. It is therefore necessary for these metrics to be considered when designing load forecasting model for this area and thus Nigeria in general.},
  keywords={Meteorology;Cooling;Load forecasting;Humidity;Wind speed;Power generation;Load modeling;Cooling degree days;electric load forecast;tropical weather;time period;season},
