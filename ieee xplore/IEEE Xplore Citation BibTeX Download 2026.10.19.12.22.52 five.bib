  booktitle={2022 IEEE 12th Annual Computing and Communication Workshop and Conference (CCWC)}, 
  title={Solutions for Closing Usage Gap in Rural Areas in West Africa}, 
  year={2022},
  volume={},
  number={},
  pages={0254-0259},
  abstract={Bridging the digital gap in general, and the rural usage gap in particular, has been a significant concern for the telephony industry for years. This study examines the key factors in telephony adoption by non-subscriber in West Africa. To do this, we used a quantitative approach using the structural equation model. We collected data in two representative West African countries: Nigeria and Guinea Conakry. On a global population of 620 people, 204 did not own a mobile phone. Analysis of the data collected from this 204 non-subscriber showed that the key factors driving future technology adoption are attitude, social influence, perceived usefulness, and perceived ease of use the demographic factor of gender moderates these factors.},
  keywords={Industries;Conferences;Sociology;Africa;Telephony;Mathematical models;Mobile handsets;Coverage gap;usage gap;intention to adopt;telephony;rural areas},
  doi={10.1109/CCWC54503.2022.9720816},
  ISSN={},
  month={Jan},}@ARTICLE{11481040,
  author={Mathew, Stephen and David, Ikwuoche J. and Nkombou, William Bob M. and Abubakar, Sadiq S. and Ojirobe, Yunusa A.},
  journal={IEEE Access}, 
  title={An Entropy Transformed Pareto Distribution for Measuring Wealth Inequality}, 
  year={2026},
  volume={14},
  number={},
  pages={65394-65405},
  abstract={In this study, an Entropy Transformed Pareto Distribution (EnTrPD) was proposed to provide improved flexibility in modelling heavy-tailed behavior observed in data, and was subsequently applied to assess wealth inequalities in Nigeria using quarterly Gross Domestic Product (GDP) data. The derived properties of the distribution include  $n^{\mathrm {th}}$  moment, characteristic function, mean, and variance. The model parameters were estimated using five parameter estimation techniques: the maximum likelihood, least squares, weighted least square, Cramer-von Mises, and Anderson Darling methods. Through simulation, the model was validated to be consistent with large sample inference, and it showed that all five estimators yielded estimates that converged to the true parameter value as sample size increased, reflecting consistency, high accuracy, and stability. On application to GDP data, the results showed that the classical Pareto distribution overestimated inequality. Particularly in the upper tail, it produce inflated Gini coefficients and extreme top-income shares. However, the EnTrPD yielded inequality measures that reflected the Nigerian economy, with Gini coefficients ranging from 0.35 to 0.56 with stable Atkinson and Generalized Entropy indices. In addition, the Lorenz curve and density analyses confirmed that the EnTrPD effectively captured heavy-tail behavior and extreme wealth concentrations without exaggeration, demonstrating its superiority over the classical Pareto method in modelling heavy-tailed economic distributions and assessing inequality.},
  keywords={Integrated circuits;Internet of Things;Electronic mail;Communication systems;Communications technology;Internet;Information and communication technology;Message systems;Feed in tariff;Internet of Things;Entropy transformation;Pareto distribution;heavy-tail distribution;estimators;GDP;wealth inequality measures},
  doi={10.1109/ACCESS.2026.3683845},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{862080,
  author={Schultz, T. and Waibel, A.},
  booktitle={2000 IEEE International Conference on Acoustics, Speech, and Signal Processing. Proceedings (Cat. No.00CH37100)}, 
  title={Polyphone decision tree specialization for language adaptation}, 
  year={2000},
  volume={3},
  number={},
  pages={1707-1710 vol.3},
  abstract={With the distribution of speech technology products all over the world, the fast and efficient portability to new target languages becomes a practical concern. The authors explore the relative effectiveness of adapting multilingual LVCSR systems to a new target language with limited adaptation data. For this purpose they introduce a polyphone decision tree specialization method. Several recognition results are presented based on mono- and multilingual recognizers. These recognizers are developed in the framework of the project GlobalPhone. In this project we investigate speech recognition in 15 languages: Arabic, Mandarin and Shanghai Chinese, Croatian, English, French, German, Japanese, Korean, Portuguese, Russian, Spanish, Swedish, Tamil, and Turkish.},
  keywords={Decision trees;Natural languages;Training data;Hidden Markov models;Speech;Target recognition;Databases;Erbium;Context modeling;Power system modeling},
  doi={10.1109/ICASSP.2000.862080},
  ISSN={1520-6149},
  month={June},}@INPROCEEDINGS{6639085,
  author={Egorova, Ekaterina and Veselý, Karel and Karafiát, Martin and Janda, Miloš and Černocký, Jan},
  booktitle={2013 IEEE International Conference on Acoustics, Speech and Signal Processing}, 
  title={Manual and semi-automatic approaches to building a multilingual phoneme set}, 
  year={2013},
  volume={},
  number={},
  pages={7324-7328},
  abstract={The paper addresses manual and semi-automatic approaches to building a multilingual phoneme set for automatic speech recognition. The first approach involves mapping and reduction of the phoneme set based on IPA and expert knowledge, the later one involves phoneme confusion matrix generated by a neural network. The comparison is done for 8 languages selected from GlobalPhone on three scenarios: 1) multilingual system with abundant data for all the languages, 2) multilingual systems excluding target language 3) multilingual systems with small amount of data for target languages. For 3), the multilingual system brought improvement for languages close enough to the others in the set.},
  keywords={Error analysis;Speech;Speech recognition;Manuals;Acoustics;Hidden Markov models;Training;multilingual speech recognition;phoneme set mapping;phoneme confusion matrix},
  doi={10.1109/ICASSP.2013.6639085},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{9092616,
  author={Tom, Abubakar Magira and Virgiyanti, Wiwied and Sheik Osman, Wan Rozaini},
  booktitle={2019 International Conference on Data and Software Engineering (ICoDSE)}, 
  title={The Impact of Government Support on the Adoption of IaaSBEL by University’s Top Management}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={Due to globalization and advancement in technological innovations, cloud-based e-learning has become an important paradigm in providing education for all. Numerous Higher Education institutions have realized the significance of adopting innovation that will make learning easier and affordable. Thus, Infrastructure as-a Service-based e-learning has been recognized as an important technology to improve the existing e-learning systems, and thus, is increasingly gaining the attention of practitioners and researchers in both developed and developing countries. The purpose of this study is to identify the factors that influence the intention to adopt Infrastructure as-a Service-based e-learning among ICT directorates top managers in the Nigerian HEIs. The study further deploys the Technology, Organization, Environment, and Diffusion of Innovation theory. Data was collected from 454 ICT directorate's Top Managers in the Nigerian HEIs using disproportionate stratified random sampling technique. The findings indicate that Relative Advantage, Cost Savings, Service Provider Support, and Government Support are the key predictors of Infrastructure as Service-Based E-learning intention to adopt model in Nigerian HEIs.},
  keywords={Cloud computing;Electronic learning;Technological innovation;Government;Security;IaaS;e-learning;Cloud Computing;Developing Countries;Nigeria},
  doi={10.1109/ICoDSE48700.2019.9092616},
  ISSN={2640-0227},
  month={Nov},}@INPROCEEDINGS{11249323,
  author={Saragih, Jan Meyer and Mehmood, Faisal and Sakti, Sakriani},
  booktitle={2025 Asia Pacific Signal and Information Processing Association Annual Summit and Conference (APSIPA ASC)}, 
  title={Beyond One-Shot Dubbing: Leveraging N-Best Translation and Prompted Paraphrasing with Synchrony-Aware Re-Ranking}, 
  year={2025},
  volume={},
  number={},
  pages={1146-1151},
  abstract={Dubbing—translating and synchronizing spoken content across languages—requires not only semantic accuracy but also precise alignment with the timing and rhythm of the original speech. While recent work has explored paraphrasing with large language models (LLMs) for dubbing, most approaches rely on a single translation and a one-shot paraphrasing pass, limiting the space of alternatives and often resulting in suboptimal alignment. We propose a multi-candidate framework that leverages N-best machine translation outputs and in-context paraphrasing with LLMs to generate diverse candidates that preserve meaning while varying in structure and length. This expanded candidate space enables better exploration of alignment options without modifying the underlying MT or TTS systems. To select the best output, we introduce synchrony-aware reranking based on speech-only alignment metrics—specifically Speech Length Compliance and Speech Overlap—which quantify temporal alignment between the generated and reference speech without requiring video input or retraining. Experiments on German-to-English dubbing using the FLEURS dataset and the IWSLT 2024 Dubbing Challenge test set show that our approach improves temporal synchrony and perceived naturalness. These results highlight the value of combining translation diversity, incontext paraphrasing, and synchrony-based selection for highquality automatic dubbing.},
  keywords={Measurement;Translation;Diversity reception;Semantics;Pipelines;Rhythm;Space exploration;Timing;Machine translation;Videos},
  doi={10.1109/APSIPAASC65261.2025.11249323},
  ISSN={2640-0103},
  month={Oct},}@INPROCEEDINGS{9692354,
  author={Adedigba, Adeyinka P. and Adeshina, Steve A.},
  booktitle={2021 1st International Conference on Multidisciplinary Engineering and Applied Science (ICMEAS)}, 
  title={Deep Learning-based Classification of COVID-19 Lung Ultrasound for Tele-operative Robot-assisted diagnosis}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={Despite the implementation of strict COVID-19 guideline, over 300,000 healthcare workers has been infected with COVID-19 globally with over 7,000 deaths. This risk of infection and loss of vital healthcare workers can be eliminated by deploying a deep learning enhanced teleoperated robot. The robot for this study was developed by Worchester Polytechnic Institute, US, to be deployed for COVID-19 at the Nigerian National Hospital Abuja. In this paper, we develop a deep learning-based automatic classification of lung ultrasound images for rapid, efficient and accurate diagnosis of patients for the developed teleoperated robot. Two lightweight models (SqueezeNet and MobileNetV2) were trained on COVID-US benchmark dataset with a computational- and memory-efficient mixed-precision training. The models achieve 99.74% (± 1) accuracy, 99.39% (± 1) recall and 99.58% (± 2) precision rate. We believe that a timely deployment of this model on the teleoperated robot will remove the risk of infection of healthcare workers.},
  keywords={COVID-19;Deep learning;Training;Ultrasonic imaging;Hospitals;Computational modeling;Soft sensors;Deep convolution neural networks;healthcare workers;Lung Ultrasound;mixed-precision training;Robot-assisted diagnosis;Tele-medicine},
  doi={10.1109/ICMEAS52683.2021.9692354},
  ISSN={},
  month={July},}@INPROCEEDINGS{10302262,
  author={Abdurahman, Hamza Shukri and Yimer, Amare Kassaw},
  booktitle={2023 International Conference on Information and Communication Technology for Development for Africa (ICT4DA)}, 
  title={Application of Machine Learning Algorithms for Pneumonia Detection and Classification}, 
  year={2023},
  volume={},
  number={},
  pages={67-72},
  abstract={According to the WHO 2022 report, pneumonia is the leading cause of mortality in children, killing 5 million children under the age of five in 2020, with Nigeria, India, Pakistan, the Democratic Republic of the Congo, and Ethiopia accounting for half of all deaths. This work expands on the limited research on important and limited chest x-ray images, and it is one of the first to address the qualities of chest x-ray images as a critical component of how successfully ML algorithms perform. In this work, we proposed a CNN model for detecting the presence of pneumonia in a patient using 5, 815 public chest x-ray images, 3,096 from Merawi, and 1,611 from Felegehiwot local hospitals. The image datasets were processed, evaluated, and proportionally combined. To evaluate the state of all images in each dataset, different exploratory data analysis techniques were employed to validate image quality, similarity, and variances. Exploratory analysis revealed that x-ray images obtained from Merawi Hospital have low quality as compared to other image sources due to exposure imbalance during imaging. The proposed model has 6 2D convolution 3 2D MaxPool, 1 flatten, and 3 fully connected layers. The results show that the proposed model outperformed all deep transfer learning with a test accuracy, weighted recall, and precision f1 score of 93% and an AUC score of 96.2% after comparision. The model missed 7 pneumonia images obtained from Felegehiwot and 8 normal images obtained from Merawi hospital. During model debugging, we observed that the model could not obtain enough information from pneumonia images obtained from Felegehiwot Hospital during training due to small sample size of only 177 images, whereas the normal missed images obtained from Merawi hosptal are noisy due to low exposures. The model performs well with online test data, with test accuracy, weighted precision, recall, an f1 score of 99%, and 100% AUC score. The model properly predicts all normal images but incorrectly labels only one pneumonia image. The findings indicate that this work is incredibly valuable for diagnostic and decision-making support, particularly in developing countries with limited medical healthcare resources.},
  keywords={Training;Hospitals;Pulmonary diseases;Transfer learning;Radiology;Data models;Classification algorithms;Chest x-ray image;Evaluation metrics;Machine learning algorithm;Medical image dataset;Pneumonia},
  doi={10.1109/ICT4DA59526.2023.10302262},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11592283,
  author={Shehu, A.F and Abubakar, A. S. and Dodo, U.A. and Belgore, A.T and Rahama, S.A},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Performance Comparison of Gaussian Process Regression Sub models for Wind Speed Prediction: Machine learning approach}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Wind speed is a crucial environmental parameter for numerous applications, including energy production, agriculture, and climate modelling. Accurate forecasting of wind speed improves the efficiency of renewable energy systems and enhances disaster preparedness. It is also crucial for wind energy systems and in ensuring that power grids operate efficiently. Traditional models often struggle with the nonlinear and random nature of environmental data. In this study, two different types of Gaussian Process Regression (GPR) models - the Exponential and Squared Exponential types - were used to predict wind speed. Weather information, including temperature, pressure, and humidity from Abuja, Nigeria, between January 1983 and September 1985, was used as the raw data. The data was split so that 75% was used for training the models and 25% was used for testing them. MATLAB R2019a software was used to build and test models. GPR is beneficial because it enables the quantification of confidence in predictions, rather than simply providing a numerical value. The performance of each model was evaluated using various metrics, including RMSE, MAE, R and R-squared. Results showed that the Exponential kernel GPR model performed best when all provided weather variables were used together. With an RMSE of 0.07474 and an Rsquared of 0.91387, it demonstrated the highest predictive accuracy. This indicates that GPR models can be highly effective in predicting wind speed for renewable energy applications.},
  keywords={Modeling;Wind speed;Ground penetrating radar;Kernel;Equations;Meteorology;Testing;Weathering;Weather;Wind;Wind Speed;Prediction;Gaussian Process Regression;Renewable Energy},
  doi={10.1109/CTUS-EMEA68989.2025.11592283},
  ISSN={},
  month={Nov},}@ARTICLE{10209173,
  author={Oladipo, Stephen Oyewumi and Sun, Yanxia and Amole, Abraham Olatide},
  journal={IEEE Access}, 
  title={Analysis of the Impact of Clustering Techniques and Parameters on Evolutionary-Based Hybrid Models for Forecasting Electricity Consumption}, 
  year={2023},
  volume={11},
  number={},
  pages={82838-82856},
  abstract={Electricity is undeniably one of the most crucial building blocks of high-quality life all over the world. Like many other African countries, Nigeria is still grappling with the challenge of the energy crisis. However, accurate prediction of electricity consumption is vital for the operation of electric utility companies and policymakers. In response, this study underlines the application of hybrid modelling techniques for the accurate prediction of electricity consumption, using Lagos districts, Nigeria, as a case study. To begin with, this research investigates the performance of three evolutionary algorithms — Particle Swarm Optimization (PSO), Genetic Algorithm (GA), and Differential Evolution (DE) — to optimize the parameters of adaptive network-based fuzzy inference systems (ANFIS). In addition, the impact of renowned clustering techniques such as grid partitioning (GP), fuzzy c-means (FCM), and subtractive clustering (SC) on other pivotal key hyperparameters of the ANFIS was examined and analyzed. Furthermore, the robustness of the optimal sub-model was evaluated by comparing it with other hybrid models that are based on six different variants of PSO. The efficacy of the proposed model was evaluated using four standard statistical measures. Finally, the results showed that the combination of the ANFIS approach and PSO under an SC approach and clustering radius of 0.6 delivered the best forecast scheme with the highest accuracy of the MAPE (8.8418%), the MAE (872.1784), the CVRMSE (10.7895), and the RMSE (1.0945E+03). The simulation results were analyzed and compared to other approaches, revealing that the suggested model is better.},
  keywords={Predictive models;Genetic algorithms;Adaptation models;Forecasting;Prediction algorithms;Data models;Biological system modeling;Particle swarm optimization (PSO);genetic algorithm (GA);differential evolution (DE);adaptive network-based fuzzy inference systems (ANFIS);clustering technique},
  doi={10.1109/ACCESS.2023.3302252},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{6757255,
  author={Yussuff, Abayomi I. O. and Khamis, Nor Hisham Haji},
  booktitle={2013 IEEE International RF and Microwave Conference (RFM)}, 
  title={Comparison of slant path rain attenuation models using data from a tropical station}, 
  year={2013},
  volume={},
  number={},
  pages={228-233},
  abstract={The distribution of rain along the radio propagation path is inhomogeneous. The non-uniformity of rainfall in both the horizontal and vertical directions makes the estimation of slant path attenuation complex. At frequencies above 10 GHz, the effects of attenuation and noise induced by atmospheric gases and rain are quite significant. Rain height data were obtained from the Tropical Rainfall Measuring Mission (TRMM) and NigComSat-1 satellite for 37 stations in Nigeria as reported in the literature. These TRMM and Nigeria data were used to find relationship between the rainfall rate and the effective slant path length. This effective length was used with local parameters at Universiti Teknologi Malaysia (UTM) to estimate the slant path attenuation values at the Ku-band. Furthermore, terrestrial attenuation data at 0.01% of the time for UTM were obtained from the UTM Wireless Communication Centre (WCC). Again, these attenuation data were transformed to slant path attenuation values using a transformation technique available in the literature. The attenuation exceeded for other percentages of the time was also obtained. The breakpoint model along with the ITU-R, DAH, Crane, Mandeep and the proposed modified ITU-R models were considered. It was observed that the validation results at 12 GHz clearly suggested that the proposed modified ITU-R model's estimates seem to provide fairly more acceptable results when compared with other models of interest.},
  keywords={Rain;Attenuation;Predictive models;Cranes;Attenuation measurement;Data models;Atmospheric modeling;Breakpoint attenuation;Slant path;Tropics;Stratiform;Convective},
  doi={10.1109/RFM.2013.6757255},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10124482,
  author={O., Louisa Osiyi and A., Adebiyi Ayodele and O., Igbekele Emmanuel},
  booktitle={2023 International Conference on Science, Engineering and Business for Sustainable Development Goals (SEB-SDG)}, 
  title={Prediction of Diabetes Mellitus in Developing Countries: A Systematic Review}, 
  year={2023},
  volume={1},
  number={},
  pages={01-06},
  abstract={Diabetes Mellitus (DM) is a chronic disease that affects millions of people around the world, primarily in developing countries. Diabetes has also been found to be a recurrent and genetic and hereditary disease ravaging lives from one generation to another. Hence, early detection of diabetes is critical to avoiding complications and lowering healthcare costs. This review article aims to compare previous works that used various machine learning models in predicting Diabetes Mellitus (DM) in Nigeria, a developing country. The models' accuracy, precision, and recall, as well as their advantages and limitations, are all discussed. The difficulties encountered in applying machine learning models for DM prediction in Nigeria, as well as potential solutions, are also discussed. The article emphasizes the importance of ongoing research in this area as well as the advantages of using K-Nearest Neighbor (KNN) and Support Vector Machine (SVM) models to improve early detection and management of diabetes in developing countries.},
  keywords={Support vector machines;Analytical models;Costs;Systematics;Machine learning;Medical services;Predictive models;Machine Learning;Diabetes Prediction;Support Vector Machine;K-Nearest Neighbor;Logistic Regression},
  doi={10.1109/SEB-SDG57117.2023.10124482},
  ISSN={},
  month={April},}@INPROCEEDINGS{9325637,
  author={Ishaq, A. I. and Abiodun, A. A.},
  booktitle={2020 International Conference on Data Analytics for Business and Industry: Way Towards a Sustainable Economy (ICDABI)}, 
  title={A new Generalization of Dagum Distribution with Application to Financial Data Sets}, 
  year={2020},
  volume={},
  number={},
  pages={1-6},
  abstract={In statistics and financial modeling, the Dagum model can be an alternative to log-nornal and pareto distributions in the applications of personal income, financial and wealth data, among others. This study proposed an extension of the Dagum model by adding an extra parameter from the Maxwell generalized family of distributions. Some properties of the extended Dagum model were studied. We illustrated the usefulness of the proposed distribution by applying two financial data related to Nigerian naira to Japanese Yen selling exchange rate data and the inflation rate of the United State of American data. It shown that, the Maxwell-Dagum model could be employed in modeling financial data apart from Weibul-Dagum, Topp-Leone-Dagum, Gamma-Dagum and Odd Log-Logistic-Dagum models.},
  keywords={Mathematical model;Data models;Density functional theory;Hazards;Random variables;Probability density function;Industries;Dagum;Maxwell-Dagum;quantile function;moments;order statistics},
  doi={10.1109/ICDABI51230.2020.9325637},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9128240,
  author={Guenoupkati, Agbassou and Salami, Adekunlé Akim and Kodjo, Mawugno Koffi and Napo, Kossi},
  booktitle={2019 II International Conference on High Technology for Sustainable Development (HiTech)}, 
  title={Statistical Characterization of Electric Power Production and Importation: Case Study of Benin Electricity Community (CEB)}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={The regularity between electricity supply and demand brings electricity companies to develop efficient and reliable models based on deterministic or stochastic approaches. To satisfy the demand of both Togolese and Beninese Republics in the interconnected area apart from its own production of Nangbeto hydropower plant, Benin Electricity Company imports electricity from Volta River Authority in Ghana, Transmission Company of Nigeria in Nigeria, and Ivoirian Electricity Company in Ivory Coast. The scope of this paper is to propose a statistical approach using probability density functions to characterize the electricity generation of Nangbeto hydropower plant and electricity importation from Volta River Authority / Ivoirian Electricity Company Transmission Company of Nigeria. The aim is to predict the probability of electrical energy available at each generation and importation source at a given time. By using the Kolmogorov-Smirnov goodness of fit test and some statistical performance indicators, it is demonstrated that Skewnormal distribution provides a better fitting of the production data and importation from VRA/CIE. However, the Weibull distribution fits well the importations from TCN.},
  keywords={Electricity;Fitting;Hydroelectric power generation;Production;Companies;Probability density function;Predictive models;Power systems;Rivers;Weibull distribution;Statistical modelling;Produced electric power;Imported electric power;Probability distribution;Goodness of fit test},
  doi={10.1109/HiTech48507.2019.9128240},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11592119,
  author={Adeluyi, Olufemi and Okafor, Chukwuemeka and Achumba, Ifeyinwa},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Bridging the Last Mile: The Interplay of Regulation, Finance, and Public-Private Partnership}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The global digital divide persists with glaring disparities in access: roughly 3 billion people were still unconnected in 2023. In Africa, only $\sim 37 \%$ of the population had Internet access in 2023, versus $\sim 93 \%$ in the EU and $\sim 97 \%$ in the USA. Nigeria’s experience typifies this gap: despite recent growth to $\boldsymbol{\sim} \mathbf{5 5 \%}$ penetration, its broadband infrastructure lags behind peers. This paper examines regulatory, financial, and PPP strategies to bridge the last mile of connectivity, focusing on successful policies in Nigeria, the EU, and the USA. We analyze large-scale initiatives (e.g., Nigeria’s Project BRIDGE and national broadband plan), compare international connectivity metrics (Table I), and highlight the role of standards - notably the IEEE/UL 2933 “TIPPSS” standard for clinical IoT - in creating trust in digital systems. Through case studies and figures on investment needs and coverage, we show how coherent policy frameworks (e.g., the EU Digital Decade, US Infrastructure Act) and well-structured PPPs (e.g., São Tomé’s ACE cable PPP) can catalyze investment and deployment. We conclude with lessons learned and outline future work on financing models and inclusive regulatory reforms to connect the unconnected.},
  keywords={Printing;Modeling;Banking;Bridges;Finance;Africa;Investment;Joining processes;Standards;Government;digital divide;last-mile connectivity;broadband infrastructure;regulatory frameworks;public-private partnerships (PPPs);blended finance;open-access networks},
  doi={10.1109/CTUS-EMEA68989.2025.11592119},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10705239,
  author={Igoche, Bern Igoche and Matthew, Olumuyiwa and Bednar, Peter and Gegov, Alexander},
  booktitle={2024 IEEE 12th International Conference on Intelligent Systems (IS)}, 
  title={Leveraging Structural Causal Models for Bias Detection and Feature Adjustment in Machine Learning Predictions}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={This research addresses the critical issue of fairness bias in machine learning predictions and explanations around the Nigerian Polytechnic admission process. We propose a novel approach that leverages Structural Causal Models (SCMs) to design an ontological framework for detecting bias and adjusting features in Local Interpretable Model-agnostic Explanations (LIME). The SCM ontology provides a principled approach to identify the features that contribute to fairness bias, and we show the presence of bias in LIME explanations for the Polytechnic admission dataset. To mitigate this bias, we propose an ablation technique for feature adjustment in a fair-LIME framework that uses SCM ontology. Experimental results on the Benpoly admission dataset show a remarkable reduction in fairness bias with high fidelity to the predictions of the black-box model. The fair-LIME explanations provided a valid and unbiased interpretation of the factors driving admission decisions. In this regard, the paper significantly extends the scope of eXplainable AI by developing a principled method for obtaining an unbiased explanability aimed at fostering the growth of trustworthy AI systems. The fair-LIME framework holds strong implications towards making the development of transparent, accountable, and ethical AI systems a reality for high-stakes decision-making processes.},
  keywords={Ethics;Explainable AI;Decision making;Closed box;Predictive models;Ontologies;Feature extraction;Cognition;Intelligent systems;Explainable AI;Fairness bias;Structural Causal Models;LIME;Ontological reasoning},
  doi={10.1109/IS61756.2024.10705239},
  ISSN={2767-9802},
  month={Aug},}@INPROCEEDINGS{9692357,
  author={Abdullahi, Jazuli and Rotimi, Abdulazeez and Malami, Salim Idris and Jibrin, Hauwa Baffa and Tahsin, Ala and Abba, S.I.},
  booktitle={2021 1st International Conference on Multidisciplinary Engineering and Applied Science (ICMEAS)}, 
  title={Feasibility of artificial intelligence and CROPWAT models in the estimation of uncertain combined variable using nonlinear sensitivity analysis}, 
  year={2021},
  volume={},
  number={},
  pages={1-7},
  abstract={Reference evapotranspiration (ET0) estimation with reliable accuracy is critical for the management of water resources and irrigation practices. The aim of this study is to estimate ET0 using CROPWAT model in Kano and Katsina meteorological stations of northwestern Nigeria. Artificial neural network (ANN) and multiple linear regression (MLR) were also developed for comparison. Monthly mean data for 34 years (1983&#x2013;2016) including maximum, minimum and mean temperatures (T<inf>max</inf>, T<inf>min</inf> and T<inf>mean</inf>), relative humidity (RH) and wind speed (U2) were used as inputs. Penman Monteith (FAO-56-PM) regarded as the standard method for computing ET0 was used as the benchmark. Initially, nonlinear correlation analysis was carried out to determine the best input variable. Thereafter, 7 models were developed based on different combinations to ascertain the most reliable for comparison to Crop Water and Irrigation Requirements Program of FAO (CROPWAT) model. The normalized Determination coefficient (R2) and root mean square error (RMSE) were used as the criteria for checking the performance of the models. The results showed that RH was the most dominant input, model 6 that has a combination of T<inf>max</inf>, RH and U2 provided the most reliable performance. The results also demonstrated that CROPWAT model is comparable in performance to ANN and MLR and can be efficiently used to estimate ET0 in the study stations with R<sup>2</sup> of 0.923, 0.962 and RMSE of 0.065, 0.046 in the validation phase for Kano and Katsina stations, respectively.},
  keywords={Analytical models;Irrigation;Temperature distribution;Correlation;Computational modeling;Wind speed;Estimation;Artificial neural network;Kano;Katsina;station;CROPWAT model;reference evapotranspiration},
  doi={10.1109/ICMEAS52683.2021.9692357},
  ISSN={},
  month={July},}@INPROCEEDINGS{10630353,
  author={Babalola, Asegunloluwa and Ojokoh, Bolanle and Adetunmbi, Adebayo and Taiwo, Olutosin},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={Non-dominated Sorting Genetic Algorithm–II Based Optimization for Healthy Meals}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={There is a growing recognition of the fact that healthy food directly influences the quality of life, as it provides and promotes good health. However, due to the hectic pace of daily life, many people find it difficult to eat healthily, causing increasingly alarming diet-related diseases which have led to about two-thirds of all deaths due to chronic conditions such as diabetes, cardiovascular diseases, and kidney disease. Nevertheless, these conditions can be prevented and minimized if each individual takes meals suited to his body, thereby reducing mortality rate and improving well-being. Setting up healthy meals for different individuals could be tedious and complicated because of the different requirements and preferences that would require consideration of several objectives ranging from energy, cost of meal, food preference to seasonal availability, hence showcasing healthy meal generation as a Multi-Objective problem. This research presents a daily meal optimization that adopts Non-dominated Sorting Genetic Algorithm (NSGA-II), a Multi-Objective Evolutionary Algorithm (MOEA) for user-tailored and optimal meals, capable of simultaneously maximizing energy composition of food items and minimizing the cost of meals. The dataset used comprises two hundred Nigerian foods obtained from Nigerian food composition table. NSGA-II was able to find suitable solutions in reasonable time because of its outstanding diversity metric preventing it from converging to local optimum, and its ability to maintain a set of non-dominated solutions. The output of the algorithm indicates that our proposed method is suitable for optimizing and suggesting timely food combinations and can thus enhance healthy living.},
  keywords={Costs;Evolutionary computation;Distance measurement;Planning;Diabetes;Sustainable development;Optimization;diet;multi-objective optimization;nsga-ii;evolutionary algorithm;meal planning},
  doi={10.1109/SEB4SDG60871.2024.10630353},
  ISSN={},
  month={April},}@INPROCEEDINGS{10188505,
  author={Rahman, Senjuti and Sarkar, Ajay Krishno},
  booktitle={2022 International Conference on Recent Progresses in Science, Engineering and Technology (ICRPSET)}, 
  title={Comparative Analysis of Different Approaches For Detecting Epilepsy}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Electroencephalograms (EEGs) can be used to diagnose conditions involving the brain, such as epilepsy. Computerized EEG data processing has the potential to improve patient care because conventional interpretation requires a lot of time, labor, and expense. Finding out whether the brain activity is unusual or typical is the main goal of this essay. We propose a normal approach using the welch power spectral density for feature extraction and different classifiers (Kernel SVM, Naïve bayes, Random Forest, Decision tree) using 5- fold cross validation on the EEG datasets available on Zenodo organization (Nigerian and Guinea-Bissau data). The value of accuracy, loss, confusion matrix, sensitivity and specificity has been determined for each of the four above mentioned classifier. The maximum accuracy was found while using kernel SVM (99.1 % for Nigerian) and Random Forest (69.5% for Guinea-Bissau). Furthermore, we suggest ChronoNet, a novel recurrent neural network (RNN) design in which each one-dimensional (1-D) convolution layer makes use of multiple filters with progressively longer lengths. The deep gated recurrent unit (GRU) layers are then positioned on top of one another and are tightly connected. The proposed ChronoNet method has been implemented on the dataset available on the TUH EEG Corpus using two frameworks namely Keras and Pytorch giving accuracy of about 97.78 % and 68% respectively.},
  keywords={Support vector machines;Brain;Recurrent neural networks;Epilepsy;Logic gates;Sensitivity and specificity;Electroencephalography;EEG;Welch Power Spectral Density;ChronoNet;GRU;Pytorch;Keras},
  doi={10.1109/ICRPSET57982.2022.10188505},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9926924,
  author={Ramesh, Jayroop and Sankalpa, Donthi and Khamis, Amar and Sagahyroon, Assim and Aloul, Fadi},
  booktitle={2022 IEEE-EMBS International Conference on Biomedical and Health Informatics (BHI)}, 
  title={Explainable Machine Learning for Vitamin A Deficiency Classification in Schoolchildren}, 
  year={2022},
  volume={},
  number={},
  pages={01-04},
  abstract={Vitamin A deficiency is one of the leading causes of visual impairment globally. While blood tests are common approaches in developed countries, various socioeconomic and public perspectives render this a challenge in developing countries. In Africa and Southeast Asia, the alarming rise of preventable childhood blindness and delayed growth rates has been dubbed as an “epidemic”. With the proliferation of machine learning in clinical support systems and the relative availability of electronic health records, there is the potential promise of early detection, and curbing ocular complication progression. In this work, different machine learning methods are applied to a sparse dataset of ocular symptomatology and diagnoses acquired from Maradi, Nigeria collected during routine eye examinations conducted within a school setting. The goal is to develop a screening system for Vitamin A deficiency in children without requiring retinol serum blood tests, but rather by utilizing existing health records. The SVC model achieved the best scores of accuracy: 75.7%, sensitivity:83.7%, and specificity: 74.9%. Additionally, Shapley values are employed to provide post-hoc clinical explainability (XAI) in terms of relative feature contributions with each classification decision. This is a vital step towards augmenting domain expert reasoning, and ensuring clinical consistency of shallow machine learning models.},
  keywords={Pediatrics;Electric potential;Visualization;Visual impairment;Sociology;Static VAr compensators;Machine learning;Electronic Health Records;Decision Making;Machine Learning;Ophthalmology;Optometry;Refractive Errors;Vitamin A;XAI},
  doi={10.1109/BHI56158.2022.9926924},
  ISSN={2641-3604},
  month={Sep.},}@INPROCEEDINGS{10927349,
  author={Martins, Funsho Michael and Gana Kolo, Jonathan and Ibitoye, Michael Olaitan and Oritseweyimi Omagbemi, Paul},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Development of a Solar-Powered Embedded System for Waste Management In Rural Communities}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Waste disposal remains a significant challenge globally, with most smart waste management systems focusing on urban areas. However, rural communities have been largely overlooked in these innovations, necessitating targeted solutions for effective waste management in these underserved regions. This research presents a smart waste management embedded system designed for rural communities. The system uses an Arduino Nano development board integrated with sensors, actuators, and a communication module within a waste bin. Ultrasonic sensors detect object proximity and content levels in the bin. A servo motor opens or closes the lid based on object distance and fullness. A SIM800L GSM module, operating on a 2G network, sends text messages to the waste management organization when the bin is full. The system was powered by a 12V solar panel and a 9V Lithium-Ion battery, ensuring reliable operation in areas with unstable electricity. To address delayed pickups, two bins were stationed at the exact location. The system was tested in Gidan Kwano Village of Niger State, Nigeria, where it showed response times of 5.67 seconds in areas with strong signal strength, 14.87 seconds with average network strength, and 83.47 seconds with poor signal strength. The results indicate that the system is effective and sustainable for rural communities, improving waste disposal and supporting economic growth.},
  keywords={GSM;Economics;Embedded systems;Electricity;Web and internet services;Urban areas;Sensor systems;Time factors;Waste disposal;Intelligent sensors;smart waste management;embedded systems;microcontroller;sensor;solar power},
  doi={10.1109/NIGERCON62786.2024.10927349},
  ISSN={2377-2697},
  month={Nov},}@ARTICLE{10815724,
  author={Erasmo Ndomba, Goodwill and Edmund Mswahili, Medard and Jeong, Young-Seob},
  journal={IEEE Access}, 
  title={Tokenizers for African Languages}, 
  year={2025},
  volume={13},
  number={},
  pages={1046-1054},
  abstract={Despite incredible development in the field of natural language processing (NLP), there has been a huge gap in the performance of NLP tasks between high-resource languages (HRLs) and low-resource languages (LRLs). African languages belong mainly to the LRLs, and one of the major contributing factors to the performance gap is tokenization, which plays a crucial role in NLP performance in general. Many recent studies on African languages often rely on multilingual tokenizers or general-purpose tokenizers, which are not optimized for African languages. This may lead to suboptimal performance in downstream NLP tasks. In this paper, we systematically analyze the performance of language-specific tokenizers for three African languages: Swahili, Hausa, and Yoruba. By experimental results on two classification tasks (i.e. sentiment classification and news classification), we found that the language-specific tokenizers for African languages consistently outperformed other monolingual tokenizers, with performance gaps of up to 5.43% in sentiment classification and 4.58% in news classification. We also found that multilingual tokenizers generally work well if they are trained in many African languages rather than global HRLs. For instance, African multilingual tokenizers outperformed global multilingual tokenizers by an average of 1.70% in sentiment classification and 1.41% in news classification. The largest observed improvement was 2.61% in news classification using Logistic Regression (LR). Based on the results, we suggest a method for choosing tokenizers when analyzing data or developing models for African languages.},
  keywords={Tokenization;Multilingual;Natural language processing;Training;Vectors;Complexity theory;Vocabulary;Accuracy;Support vector machines;Standards;Tokenizer;classification;African language;Swahili;Yoruba;Hausa},
  doi={10.1109/ACCESS.2024.3522285},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11252119,
  author={Nortje, Leanne and Oneata, Dan and Pîrlogeanu, Gabriel and Kamper, Herman},
  booktitle={2025 International Conference on Speech Technology and Human-Computer Dialogue (SpeD)}, 
  title={Improved visually prompted keyword localisation in real low-resource settings}, 
  year={2025},
  volume={},
  number={},
  pages={46-51},
  abstract={Given an image query, the goal in visually prompted keyword localisation (VPKL) is to find occurrences of the depicted word in a speech collection. This can be useful when transcriptions are not available for a low-resource language (e.g. if it is unwritten). Previous work showed that VPKL can be performed with a visually grounded speech model trained on paired images and unlabelled speech. But all experiments were done on English. Moreover, transcriptions were used to get positive and negative pairs for the contrastive loss. This paper introduces a few-shot learning scheme to mine pairs automatically without transcriptions. On English, this results in only a small drop in performance. We also – for the first time – consider VPKL on a real low-resource language, Yorùbá. While scores are reasonable, here we see a bigger drop in performance compared to using ground truth pairs because the mining is less accurate in Yorùbá.},
  keywords={Training;Visualization;Adaptation models;Attention mechanisms;Accuracy;Image retrieval;Buildings;Few shot learning;visually grounded speech models;multimodal learning;keyword localisation;speech–image retrieval},
  doi={10.1109/SpeD67700.2025.11252119},
  ISSN={2771-5787},
  month={Oct},}@INPROCEEDINGS{9134041,
  author={Shoewu, Oluwagbemiga Omotayo and Akinyemi, Lateef Adesola and Oborkhale, Lawrence},
  booktitle={2019 IEEE AFRICON}, 
  title={Towards Developing Path loss Models for Dryland and Wetland Environments}, 
  year={2019},
  volume={},
  number={},
  pages={1-7},
  abstract={Path loss propagation models developed in recent times are presented in this paper. Since it is a necessity for efficient and accurate planning during deployment, it is imperative to review some of the models. The model development started from Japan but Nigeria has been one of the third world countries that benefited immensely from the models developed in Japan. The Japanese models were developed for Rural, Urban and Suburban areas. Research has shown that path loss model could be developed for metropolitan areas. Wireless design of accurate and reliable communication systems hinges upon the suitability of the path loss prediction choice and the adaptability of the enhanced methods in various classified environment of discourse. The effort of this paper is based on obtaining adequate propagation model for wetland and dryland areas in Lagos State. Measurement was conducted for four weeks in Rural Suburban and Urban environment. The frequency assignment for the measurement was 700MHz range that is on of the main band for the placement of long time evolution(LTE).},
  keywords={Predictive models;Mathematical model;Computational modeling;Wetlands;Urban areas;Propagation losses;Wireless communication;Pathloss;Models;Environment;Dryland;Wetland},
  doi={10.1109/AFRICON46755.2019.9134041},
  ISSN={2153-0033},
  month={Sep.},}@INPROCEEDINGS{7303073,
  author={Ulaganathen, Kesavan and Assis, Mauro S.},
  booktitle={2015 1st URSI Atlantic Radio Science Conference (URSI AT-RASC)}, 
  title={Rain attenuation measurements in Malaysia}, 
  year={2015},
  volume={},
  number={},
  pages={1-1},
  abstract={Within a research programme dealing with the development of a 5.8 GHz link to be used as redundancy for a 26 GHz terrestrial point-to-point microwave link in the equatorial region, two problems are discussed in this paper. a) Drop size distribution (DSD) and the associated specific rain attenuation and b) Frequency scaling of rain attenuation statistics. Measurements were carried out in a 1.3 km long radio link located in the Skudai campus of Universiti Teknologi Malaysia (UTM). Simultaneous rainfall rate measurements were carried out in the same site with a Casella tiping bucket size of 0.5 mm rain gauge along with one minute interval. Both measurements cover the period from June 2011 to May 2012. The specific attenuation due to rain As(dB/km) is obtained from the rainfal rate R(mm/h) using the power relationship, As = kRα where k and α are functions of frequency, rain drop size distribution (DSD), temperature e polarization of the radio wave. The most common DSD model used in temperate climate is the Marshall and Palmer negative exponential function, while the log-normal distribution applies to tropical and equatorial climates. In this paper the specific attenuation has been determined directly from the collected rain attenuation. Since the path length of the experimental link is 1.3 km, the distribution of rainfall has been assumed to be uniform along the propagation path. The nonlinear relationship between specific attenuation and the rainfall intensity given in the above equation was transformed into a linear form based on a logarithmic transformation. Then a linear regression model was fitted to the measured specific attenuation and the measured rainfall rate. Based on one year of rain attenuation measurements at both frequencies, the following values of k and α were estimated, f = 5.8 GHz k = 0.138 ; α = 0.63 f = 26 GHz k = 0.389 ; α = 0.89 On the other hand, scaling of rain attenuation statistics in frequency is a useful technique if attenuation data are available at the desired locality. Many scaling models have been developed from various propagation experiments. In this paper the Rain Attenuation Statistics (RAS) is modeled according to a simple power law model given by, RAS=(F2/F1)N where f1 is the lower frequency and f2 the higher one. Three pair of frequencies, 5.8 GHz, 15 GHz and 26 GHz have been analysed and compared. The rain attenuation data for 5.8 GHz and 26 GHz were taken from the same link used before for the specific attenuation study, while the 15 GHz data has used previous rain attenuation information from another radio link located also in UTM. This intermediate frequency has been also used as a check for the results derived from 5.8 and 26 GHz. In summary, the analysis of the rain attenuation data has indicated the value of n = 1.57 for the power law model to be used in the frequency range from 5 to 26 GHz. In the final paper the results presented here will be compared to data from several other tropical and equatorial countries, such as Brazil, India, Nigeria, Singapore and South Africa.},
  keywords={Rain;Attenuation;Attenuation measurement;Temperature measurement;Radio links;Meteorology;Mathematical models},
  doi={10.1109/URSI-AT-RASC.2015.7303073},
  ISSN={},
  month={May},}@INPROCEEDINGS{9988542,
  author={Amadasun, Kennedy and Agajo, James},
  booktitle={2022 International Conference on Electrical, Computer, Communications and Mechatronics Engineering (ICECCME)}, 
  title={Decision Support for GSM Co-location using Machine Learning}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Mobile phone communication systems is the fastest and easiest means of communication globally due to it conveniency and effectiveness. Nigeria telecommunication market is growing rapidly with a tele density 109.99 primarily intensified in built-up localities. Due to the ever-increasing number of subscribers, most mobile telecommunication operators in Nigeria are erecting new Base Transceiver Station (BTS)s, often without taking into cognisance of the current infrastructure on ground. This has led to a duplication of masts, causing unnecessary environmental pollution and operational issues. As an alternative approach, this work takes steps toward developing an AI-based decision support model for deciding the best position for siting co-located BTS for trio shared infrastructure for Global System for Mobile Communications (GSM). Five key parameters were considered for developing the AI-based model, namely Height of mast (HM), Utility cost (UC), Cell Coverage (CC), Antenna Radiation (AR) and Population density (PD). Collected data from a significant Telecommunication service provider. The data was used as a set of sequence for Artificial Neural Network (ANN) tool and to develop the hidden layers to adjust the various network weights. The regression result shows that training R was 0.999, Test R=0.99974, Validation R was 0.99954, and the overall regression result R was 0.99869, reflecting the model's good performance. Keywords-Telecommunication, Mast, Artificial Neural Network, Co-location, Transmitter},
  keywords={GSM;Training;Pollution;Transmitters;Sociology;Artificial neural networks;Transceivers;Telecommunication;Mast;Artificial Neural Network;Co-location;Transmitter},
  doi={10.1109/ICECCME55909.2022.9988542},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9803006,
  author={Braide, S. L. and Idoniboyeobu, D. C.},
  booktitle={2022 IEEE Nigeria 4th International Conference on Disruptive Technologies for Sustainable Development (NIGERCON)}, 
  title={Energy-Mix Dynamic for Optimization of Power Generation Strategy and Expansion in a Developing Economy Growth}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper applied decomposition techniques to determine the capacity combination for fossil fuel (hydrocarbon) consumption pattern as an objective cost function of power plants. The generating capacity are decomposed into different optimization options on the view to make operational cost saving in accordance to load demand and generating capacity of 2250 MW for Afam, 2350 MW for Sapele and 3000 MW for Egbin Station. Projection plans of 20 years was used for the analysis. Five optimization was developed for cost savings plan 1, 2, 3, 4 and 5 respectively. Possibility of utilizing Renewable Energy sources (solar and wind energy) with respect to hydrocarbon sources as a form of energy mix dynamic for electricity power generation are proposed in the new power structure, Nigeria. The consequences was as a result of changes in climatic scenarios due to burning of hydrocarbon, environmental pollution which necessitate deep reduction in greenhouse gases. Since Nigeria is endowed with Renewable Energy resources particularly wind and solar potentials of all 36 states and federal Capital Territory. The primary sources of information was accessed using data in the open literature about selected location in each state (table I and II). Determination of wind speed profile for wind-turbine generation required estimation of wind potential using Weilbull probability distribution. Similarly, solar irradiation values across several places in Nigeria considered energy demand which depends on population and economic activities of the locality of the sun-radiation potential, which are simulated with Hybrid Optimization Model of Renewable Energy Sources (HOMER).},
  keywords={Renewable energy sources;Electric potential;Costs;Wind energy;Wind speed;Solar energy;Hydrocarbons;optimization planning;generation expansion;decomposition techniques of electric power;profit;Photovoltaic hybrid;wind speed;renewable energy;Weilbull probability distribution function},
  doi={10.1109/NIGERCON54645.2022.9803006},
  ISSN={2377-2697},
  month={April},}@INPROCEEDINGS{11410485,
  author={Ifeanyi, Ugbaga Nkole and Ibemezie Ndubuisi, Paul Darlington},
  booktitle={2025 5th International Multidisciplinary Information Technology and Engineering Conference (IMITEC)}, 
  title={Impact of Digital Entrepreneurship for Youth Economic Independence in Industrial 4.0}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The Growing prevalence of digital entrepreneurship presents a valuable opportunity to combat youth unemployment and foster financial independence. In Nigeria, the youth unemployment rate is increasing daily; this has necessitated an increase in crime and insecurity in the whole country. This study investigates the relationship between digital entrepreneurship and access to funding, training, and education, supportive networks, government policies, and technological infrastructure in providing financial autonomy among young digital entrepreneurs in Nigeria. A structured questionnaire was distributed on different WhatsApp platforms involving lecturers, students, graduates, freelancers, and entrepreneurs, and 436 respondents were recorded. The collected data were analyzed using correlation and multiple linear regression techniques. The regression model yielded statistically significant results, demonstrating that these enablers collectively account for 8.4% of the variance in financial independence. Among the predictors, training and education exhibited the strongest standardized effect, followed by access to funding and supportive networks. These findings, although showed little importance of equipping youth with digital and entrepreneurial competencies in Nigeria through education and training, access to funds, encouragement of mentorship, and peer group support. The study concluded by suggesting that the government, private individuals, and companies increase their investments more through capacity-building and development of skill centers. They should ensure that training, funding, education, and other enablers, such as digital training, entrepreneurial expertise, get to the targeted youths, while also providing a monitoring system for the programme to be productive. Thus, in doing this, unemployment and crime will reduce drastically, if not eliminated.},
  keywords={Training;Government policies;Technological innovation;Correlation;Entrepreneurship;Companies;Transforms;Stability analysis;Digital intelligence;Unemployment;Digital Entrepreneurship;Youth Financial Independence;Nigeria},
  doi={10.1109/IMITEC67386.2025.11410485},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10790915,
  author={Ajah, Nnaemeka Genesis and Ugwu, Chibuike Nicholas and Eya, Candidus and Onyegbadue, Ikenna and Ejiogu, Emenike Chinedozi and Ndukwu, Chimaobi Ikenna},
  booktitle={2024 IEEE International Conference on Advanced Power Engineering and Energy (APEE)}, 
  title={Analysis and Evaluation of an Off-Grid Mini-Grid PV System for Rural Electrification}, 
  year={2024},
  volume={},
  number={},
  pages={176-181},
  abstract={In recent years, there has been a growing interest in using renewable energy sources to electrify rural areas in Nigeria. The major motivation for this study is the recognition of the huge potential of renewable energy to improve rural electricity access in the country. One promising option is to use off-grid photovoltaic (PV) mini grid systems. These systems are small, modular, and can be easily installed in remote areas. However, some studies have shown that these systems are posed with certain problems such as its inability to carry loads for prolonged periods of time when the sun is out. This work investigates the feasibility of an optimized off-grid PV mini grid system for electrification of rural areas in Nigeria. The paper made use of the HOMER pro, SAM and MATLAB software. The HOMER pro software was to design a proposed mini grid for a case community in the northern part of Nigeria. The results of the HOMER pro simulations showed that the system generated high NPC and low LCOE. The proposed system for the northern generated an NPC of $\mathrm{N}\!\!\!\!\!\!{=}$380,498,512 and an LCOE of 37.01$\mathrm{N}\!\!\!\!\!\!{=}$/kWh. The results of the SAM software showed that the PV array of the proposed models was able to generate sufficient electricity for the community. The results of the MATLAB software showed that a short-term load forecasting carried out using the ANN Levenburg-Marquardt algorithm gave results more accurately for the short-term load demand of the community. This exchange rate at the time of this work was $\mathrm{N}\!\!\!\!\!\!{=}$769.5 to $1.},
  keywords={Renewable energy sources;Costs;Electricity;Software algorithms;Electrification;Software;MATLAB;Sun;Standards;Power engineering and energy;HOMER pro;Load forecasting;LCOE;Mini-grid MATLAB;PV system;Rural community;SAM},
  doi={10.1109/APEE60256.2024.10790915},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10051442,
  author={Cletus, Felicia and Baha, B. Y. and Sarjiyus, Omega},
  booktitle={2022 5th Information Technology for Education and Development (ITED)}, 
  title={Prediction of Mosquito Prevalence in a Warm Semi-Arid Climate using Artificial Neural Network (ANN)}, 
  year={2022},
  volume={},
  number={},
  pages={1-8},
  abstract={Mosquito is a disease-causing organism that causes harm to humans and animals alike. Over the years, vector control measures such as the use of insecticides, treated mosquito net, and the prediction of mosquito prevalence using statistical tools and Artificial Neural Network models in different weather terrain have not completely eradicated the problems associated with prevalence of mosquito. More so, there is no research available in literature to predict the prevalence of mosquito using artificial neural network in a warm semi-arid climate such as that of Yola, Northeastern Nigeria. This research endeavored to achieve this aim. This study built a prototype artificial neural network model that is capable of predicting mosquito prevalence. The model is a feed forward multi-layer perceptron that was implemented using the supervised learning method and optimized using the back propagation algorithm. The model has four (4) input features, which are weather data (maximum temperature, minimum temperature, relative humidity and rainfall) which were adopted for the research. After compilation, the new model was trained and validated using sourced data by the researcher. To train the model, 80% of the data was used while 20% was used for the validation. The proposed model is a keras sequential classification model that was built in anaconda using the python programming language. The optimal model has three hidden layers of 40 30 and 20 neurons with Sigmoid and ReLu activation function respectively. The simulation of the prototype model recorded 96.67% accuracy with good fit. This research shows that the artificial neural network model is an effective tool in predicting mosquito prevalence in a warm semi-arid climatic region and thus recommends the use of more data and training epochs to increase accuracy and subsequent implementation of the model in real life for prediction of mosquito prevalence.},
  keywords={Temperature distribution;Animals;Biological system modeling;Neurons;Prototypes;Artificial neural networks;Humidity;Mosquitoes;Prevalence;Prototype;Testing;Training;Visualization},
  doi={10.1109/ITED56637.2022.10051442},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10968427,
  author={Igulu, Kingsley T. and Singh, Thipendra P and Olayinka, Tosin C. and Onyijen, Ojei H. and Onatuyeh, Edwin and Nwankwo, Wilson},
  booktitle={2025 10th International Conference on Signal Processing and Communication (ICSC)}, 
  title={An Intelligent Approach to Cost-effective Management of Typhoid Fever in Children}, 
  year={2025},
  volume={},
  number={},
  pages={265-271},
  abstract={Typhoid fever poses a significant health concern among children, due to its potential for severe complications and high treatment costs. This paper proposes an intelligent approach to modelling the prognosis and management of paediatric typhoid infections leveraging machine learning and data analytics to optimize healthcare resources and improve patient outcomes. The dataset was sourced from hospitals in Edo State, Nigeria. The dataset comprises laboratory tests of blood samples of children, from age zero (0) to five (5) years. Six (6) attributes that exhibit the highest information gain: widal test, malaria count, monocyte, platelets, HB, eosinophils, cost of treatment respectively, were selected and ranked thus: 0.6759, 0.4936, 0.3147, 0.2843, 0.2416, 0.2127, and 0.20. Five different classification algorithms (J48_Consolidated, LMT, RepTree, MultiBoost Decision Stump) were employed. and Random Forest) and their results were compared. Performance analysis on the five (5) classifiers shows that Multiboost Decision Stump exhibited the best accuracy of 94% and least MAE of 0.0604. The finding shows that the developed model when integrated into automated disease diagnostic workflows will provide an enhanced and flexible solution for quick prognosis of typhoid fever in children in the tropics with significant cost savings with respect to hospitalization. The finding presupposes that we can enhance the efficiency of typhoid fever management while ensuring the delivery of quality care to children in resource-limited settings.},
  keywords={Pediatrics;Machine learning algorithms;Costs;Signal processing algorithms;Predictive models;Prediction algorithms;Classification algorithms;Performance analysis;Prognostics and health management;Random forests;Typhoid fever;machine learning algorithms;information gain;disease detection},
  doi={10.1109/ICSC64553.2025.10968427},
  ISSN={2643-444X},
  month={Feb},}@INPROCEEDINGS{6565243,
  author={Isacenkova, Jelena and Thonnard, Olivier and Costin, Andrei and Balzarotti, Davide and Francillon, Aurelien},
  booktitle={2013 IEEE Security and Privacy Workshops}, 
  title={Inside the SCAM Jungle: A Closer Look at 419 Scam Email Operations}, 
  year={2013},
  volume={},
  number={},
  pages={143-150},
  abstract={Nigerian scam is a popular form of fraud in which the fraudster tricks the victim into paying a certain amount of money under the promise of a future, larger payoff. Using a public dataset, in this paper we study how these forms of scam campaigns are organized and evolve over time. In particular, we discuss the role of phone numbers as important identifiers to group messages together and depict the way scammers operate their campaigns. In fact, since the victim has to be able to contact the criminal, both email addresses and phone numbers need to be authentic and they are often unchanged and re-used for a long period of time. We also present in details several examples of Nigerian scam campaigns, some of which last for several years - representing them in a graphical way and discussing their characteristics.},
  keywords={Electronic mail;Security;Europe;Joining processes;Data mining;Business;Communities;419Nigerian scam;online fraud;email campaigns;cybercrime;cyberscam},
  doi={10.1109/SPW.2013.15},
  ISSN={},
  month={May},}@INPROCEEDINGS{7068095,
  author={Oladeji, Olamide and Onoja, Vincent A.},
  booktitle={2014 IEEE 6th International Conference on Adaptive Science & Technology (ICAST)}, 
  title={Techno-economic analysis of biogas based micro-generation for a university facility}, 
  year={2014},
  volume={},
  number={},
  pages={1-5},
  abstract={The inadequate capacity of the Nigerian grid has necessitated the use of distributed energy resources for on-site generation. Alternative energy sources such as biogas may offer a more economic and environmentally-friendly approach to meeting energy demand when compared to fossil-based on-site generation such as the use of gasoline or diesel generators. Hybrid energy systems may also be more beneficial economically and technically. In this paper, we use HOMER, a micropower modelling and optimization software, to determine the optimal configuration of a biogas-based power system for a facility in a Nigerian University. A feasible, optimal hybrid configuration for the system was determined, considering biogas generation, diesel generation, and battery storage under certain constraints. Simulation results showed that the biogas and battery configuration is the most suitable techno-economic configuration for our design.},
  keywords={Generators;Batteries;Biological system modeling;Analytical models;Load modeling;Power systems;Renewable energy sources;biogas;hybrid systems;microgeneration;DERs;HOMER},
  doi={10.1109/ICASTECH.2014.7068095},
  ISSN={2326-9448},
  month={Oct},}@INPROCEEDINGS{7103226,
  author={Jimoh, A.A. and Surajudeen-Bakinde, N.T. and Faruk, Nasir and Ayeni, Adeseko A. and Obiyemi, Obiseye O. and Bello, Olayiwola W.},
  booktitle={2015 6th International Conference on Information and Communication Systems (ICICS)}, 
  title={Performance analysis of empirical path loss models in VHF & UHF bands}, 
  year={2015},
  volume={},
  number={},
  pages={194-199},
  abstract={In this work, signal path loss prediction from nine different empirical path loss models were statistically compared with those measured from four television transmitters along five routes that span through urban and rural environments of Osun State, Nigeria. In this respect, results obtained show that both Hata and Davidson prediction models provide best fit prediction consistently along the five measurement routes with 90% to 98% prediction accuracy, Ilorin, CCIR, Cost 231, Ericsson 9999 and ECC-33 show prediction accuracy within the range of 65% to 80% while SUI and Okumura models offer prediction accuracy within the range of 15% to 21%. Generally the results show that Davidson and Hata models have better results in all the five routes examined. SUI and Okumura models show the least performance results.},
  keywords={Loss measurement;Predictive models;Propagation losses;Mathematical model;Frequency measurement;Antenna measurements;TV;Empirical models;Path loss;Davidson model and Hata model},
  doi={10.1109/IACS.2015.7103226},
  ISSN={},
  month={April},}@INPROCEEDINGS{9803130,
  author={Etuk Uyoata, Uyoata},
  booktitle={2022 IEEE Nigeria 4th International Conference on Disruptive Technologies for Sustainable Development (NIGERCON)}, 
  title={LoRa Network Planning Using Empirical Path Loss Models}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Novel wireless network technologies such as LoRa can benefit from network planning. In this preliminary study to investigate the suitability of Low Power Wide Area Network for IoT deployment in Nigeria, we present the performance of various classical empirical path loss models for LoRa and offer insight into the suitability of these models in various environments. In this study, path loss simulation results are presented for Okumura-Hata, COST 231, COST-WI, Ericsson, SUI and 3GPP models under urban, rural and suburban outdoor propagation environments. 433 MHz, 868 MHz and 912 MHz carrier frequencies are considered for 1 and 3 metres of mobile end node heights. Simulation results show that COST-WI and Okumura-Hata models are good candidates for network planning in rural and sub-urban environments whereas Ericsson and 3GPP models join that list for urban environments.},
  keywords={Wide area networks;Simulation;Wireless networks;Urban areas;Drives;Propagation losses;Planning;Network planning;Empirical models;LoRa;LPWAN;LoRaWAN;IoT},
  doi={10.1109/NIGERCON54645.2022.9803130},
  ISSN={2377-2697},
  month={April},}@INPROCEEDINGS{9004303,
  author={Ighravwe, Desmond Eseoghene and Mashao, Daniel},
  booktitle={2019 6th International Conference on Soft Computing & Machine Intelligence (ISCMI)}, 
  title={Neural Network Based Estimation of Electricity Generated During a Waste-to-energy Process: Estimation of Generated Electricity}, 
  year={2019},
  volume={},
  number={},
  pages={56-60},
  abstract={Many emerging economies are embarking on the production of electricity from food wastes. And this has rekindled the interest of waste-to-energy engineers in these economies. They are confident that machining learning algorithms will help them to reduce the computation cost for this process. Here, an artificial neural network (ANN) model is used to estimate the amount of electricity generated during a waste-to-energy process. The selected model is a single hidden layer model with five inputs including methane gas, compression efficiency, boiler efficiency and more - the model's output is electricity generated. This study evaluated ten ANN architectures for the prediction purpose; data from nine cities in Nigeria were used to achieve this purpose. The results obtained show that a 5-4-1 ANN architecture performs better than the other architectures during their training and testing phases. This model's training and testing mean square error is 6.96 × 10-5 and testing 3.62 × 10-5, respectively. Based on the ANN performance, it was concluded that it can be used to monitor a waste-to-energy process.},
  keywords={Mathematical model;Artificial neural networks;Computer architecture;Training;Predictive models;Testing;Data models;waste-to-energy;electricity generation;artificial neural network;developing countries},
  doi={10.1109/ISCMI47871.2019.9004303},
  ISSN={2640-0146},
  month={Nov},}@INPROCEEDINGS{10282954,
  author={Engstrom, Ryan and Owusu, Maxwell and Nair, Arathi and Jafari, Amir and Thomson, Dana and Kuffer, Monika},
  booktitle={IGARSS 2023 - 2023 IEEE International Geoscience and Remote Sensing Symposium}, 
  title={Evaluating the Ability to Use Contextual Features to Map Deprived Areas ‘Slums’ in Multiple Cities}, 
  year={2023},
  volume={},
  number={},
  pages={3620-3623},
  abstract={Population living in deprived conditions continues to grow, highlighting the urgent need for accurate high-resolution maps and detailed statistics to plan interventions and monitor changes. Unfortunately, data on deprived areas or "slums" is often unavailable, incomplete, or outdated. Leveraging satellite imagery can offer timely, and consistent information on deprived areas over large area However, there are limited studies that use free and open source data that can be used to map deprived areas over large areas and across multiple cities. To address these challenges, this study examines a scalable and transferable modeling approach to map deprived areas using contextual features extracted from freely available Sentinel-2 data. Models were trained and tested on three Sub-Sahara cities: Lagos Nigeria, Accra Ghana, and Nairobi, Kenya. The results indicate that models in individual city achieved F1 scores from 0.78-0.95 for the three cities. Additionally, the results indicate that the proposed approach may allow for the ability to transfer models from city to city allowing for large area and across city mapping.},
  keywords={Urban areas;Sociology;Geoscience and remote sensing;Feature extraction;Data models;Satellite images;Data mining;Deprived areas;slums;contextual features;Sentinel-2;machine learning},
  doi={10.1109/IGARSS52108.2023.10282954},
  ISSN={2153-7003},
  month={July},}@INPROCEEDINGS{9232374,
  author={Durodola, O. M. and Macaulay, O. S. and Makama, E. K.},
  booktitle={2020 XXXIIIrd General Assembly and Scientific Symposium of the International Union of Radio Science}, 
  title={Characteristics Of Tropospheric Scintilation For Satellite Applications In Jos}, 
  year={2020},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper presents the results of the hourly variation of refractivity based on measurement of temperature, atmospheric pressure and relative humidity in Gold and Base, Jos (09°58’N, 008°57’E, 1192m), (near Air Force Military School-AFMS), Nigeria. Twelve months meteorological data were measured with DAVIS Vantage Vue weather station; and were used to compute the surface radio refractivity and the scintillation fade depth following the ITU-R P.834 prediction model. Correlation values showed that the average hourly variations of refractivity in the dry season remained low, mainly as a result of the low values of the wet component humidity; while the average daily values of surface radio refractivity in the rainy season varied mainly as a result of both variations in the dry (pressure) and wet (humidity) components of surface radio refractivity. Diurnal curves in the dry season showed minimum values in the mid-morning to late afternoons (10:00–16:00), and maximum values from evening to early morning hours (18:00-08:00); while the rainy season has a fairly constant average refractivity index of about 345 units. Seasonal values of surface radio refractivity varied between 276 and 330 units during dry season; while the values varied between.348 and 338 units during rainy season Also, scintillation fade depth ranged from 0. 95dB to 2. 05dB during dry season; and from 1. 788dB to 2. 20dB in the wet season. For future research, it is suggested that different single-parameter models could be developed for dry season and during the rainy season. While an inverse temperature-dependent model is required for dry season, a pressure-dependent model would suffice for rainy season.},
  keywords={Temperature measurement;Atmospheric measurements;Military computing;Atmospheric modeling;Satellite broadcasting;Refractive index;Humidity;Meteorological parameters;Wet-term Refractivity;Scintillation fade depth;ITU-R},
  doi={10.23919/URSIGASS49373.2020.9232374},
  ISSN={2642-4339},
  month={Aug},}@INPROCEEDINGS{9428862,
  author={Matthew, Ugochukwu O. and Kazaure, Jazuli S. and Onyebuchi, Amaonwu and Daniel, Ogobuchi Okey and Muhammed, Ibrahim Hassan and Okafor, Nwamaka U.},
  booktitle={2020 IEEE 2nd International Conference on Cyberspac (CYBER NIGERIA)}, 
  title={Artificial Intelligence Autonomous Unmanned Aerial Vehicle (UAV) System for Remote Sensing in Security Surveillance}, 
  year={2021},
  volume={},
  number={},
  pages={1-10},
  abstract={Adapting artificial intelligence autonomous systems required a policy specification, policy enforcement and policy management on the key prioritized functions based on the inherent policy enforcement and self-definitive programmed knowledge by an autonomous system. In the current research, attempt was made to model an autonomous unmanned aerial vehicle (UAV) system to be able to detect humans within the thickest forest region amidst the escalating tension of bokoharam and bandits abductions within the Nigeria geographic space. The autonomous artificial intelligence UAVs was designed using laser-range detectors for location evaluation and pathway finding with very accurate precision. While the UAVs hovers in the neighborhood, it establishes an individualized 3-D map of its surrounding. The central objective of this study is to explore the scientific opportunities available for artificial intelligence unmanned aerial vehicle (Drones) modeled with machine learning (convolution neural network) on Internet of Things $(\mathbf{IoTs})$ framework and adapt it to revolutionize the mission on environmental & remote sensing, security surveillance, rescue and search mission. The paper established that Nigeria security forces could adopt artificial intelligence UAV to extradite terrorists within the Lake Chad Basin where bokoharam insurgency and banditry are prevalent. The paper further highlight that UAV could be very instrumental in search and rescue mission by the security forces.},
  keywords={Space vehicles;Adaptation models;Autonomous systems;Surveillance;Neural networks;Medical services;Search problems;Artificial Intelligence;Machine Learning;Robots;Cloud Computing;Unmanned Aerial Vehicles;Internet of Thing;Autonomous System;Drones Technology},
  doi={10.1109/CYBERNIGERIA51635.2021.9428862},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{8521062,
  author={Ucheaga, Emeka G. and John, Temitope M. and Wara, S.T},
  booktitle={2018 IEEE PES/IAS PowerAfrica}, 
  title={Evaluating the Cost Effectiveness of Energy Efficient Appliances}, 
  year={2018},
  volume={},
  number={},
  pages={313-318},
  abstract={One of the reasons Africa has struggled to attain its full economic potentials is because of lack of energy. Optimization of available energy is a very important tool for sustainable development in Africa. Nigeria is currently the largest economy in Africa and one of the largest producers of crude oil in the continent yet it has visibly struggled with energy shortages. An improvement in the energy efficiency of appliances in buildings will significantly reduce energy wastage and improve the distribution and use of energy in the country. This paper aims to design a framework to improve energy efficiency in appliances in a selected residential building in Nigeria. It was revealed that energy efficiency in appliances leads to improved energy savings, liberating huge capital for investments in the country. The calculated retrofitted model for energy efficiency resulted into a 56.8 percent reduction on the cost incurred on energy used yearly. Lastly, a model for calculating the appropriateness of appliances to be installed in households was given in this paper.},
  keywords={Buildings;Energy efficiency;Water heating;Home appliances;Energy consumption;Fans;Electrical products;Energy Efficiency;Energy Analytics;Residential building;Retrofitting;Pay-back period;Electrical appliances;Sustainable development goals;SDGs},
  doi={10.1109/PowerAfrica.2018.8521062},
  ISSN={},
  month={June},}@INPROCEEDINGS{10927140,
  author={Egbuwe, Kelvin Olamide and Onibonoje, Moses Oluwafemi and Ikpeze, Onyinye Florence and Salau, Ayodeji Olalekan and Adediji, Oluwapamilerin Elizabeth and Chima, Wisdom Enyiche},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Developing an Electrical Surge Protector Maintenance System}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Electricity is an essential commodity in every society, particularly in developing countries like Nigeria with its ever-growing populace. However, Nigeria struggles to meet its citizens' electrical power demands due to an unstable power grid and inadequate infrastructure, leading to frequent blackouts and an increased risk of power surges. To address this issue, the use of Surge Protective Devices (SPDs) is heavily encouraged. Ensuring adequate maintenance of these devices is crucial, as many users may not have the expertise to detect when SPDs need maintenance or repairs. This paper presents an effective method for monitoring the operational status of SPDs using sensors to measure key parameters such as power, voltage, current, and temperature. The measured values are transmitted to a web-based platform developed using Flutter and Firebase, and can be accessed via MATLAB/SIMULINK. The system was first modeled and simulated to verify its functionality before physical implementation. The SPD was modeled to handle a clamping voltage of 240V, with simulations using an 8/20 μs surge waveform to replicate real-world surge conditions. The simulation results showed that the SPD effectively clamped the surge voltage to 240V, successfully protecting the connected load. The temperature sensor recorded an increase of up to 75°C during surge events, indicating the need for real-time monitoring to prevent overheating. The current sensor measured surge currents peaking at 10 kA, well within the SPD's absorption capacity. These results demonstrate the system's capability to mitigate the effects of electrical surges through proactive maintenance, significantly enhancing the reliability of electrical systems and reducing the risk of equipment failure and associated costs},
  keywords={Temperature measurement;Temperature sensors;Voltage measurement;Current measurement;Surge protection;Real-time systems;Mathematical models;Maintenance;Surges;Protection;electrical;maintenance;modelling;protection;simulation;surge},
  doi={10.1109/NIGERCON62786.2024.10927140},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{10927395,
  author={Fasipe, Oladimeji O. and Olabisi, Patrick O. and Folorunso, Augustine O.},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Review of Energy Requirement and Load Forecasting for A Medium Agro-Based Industrial Settlement: A Case Study of Oke-Agbo and Imota Villages}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Initiatives at promoting sustainable economic growth, enhanced competitiveness of home-grown companies, and job creation have been severely hampered by the unpredictable electric power supply. Utility sector decision-makers must predict the future demand for energy with a minimum error percentage using various predictive models with a lower percentage of inaccuracy if they will be able to load-shrink while maintaining the uninterrupted power supply to consumers and to save cost for utility companies. Efforts at forecasting electricity demand rather make use the hybrid approach which combines two or more predictive models to achieve enhanced prediction performances. The performances are compared in terms of Mean Absolute Error (MAE), Root Mean Squared Error (RMSE), and Mean Absolute Percentage Error (MAPE). The two communities of Oke-agbo and Imota provided first-hand information about the trend of energy demand and the market analysis of the transformer and other distribution network components will be done. Additionally, information was also acquired with the aid of former Nigeria Electricity Power Authority (NEPA), Power Holdings Company of Nigeria (PHCN), and Ikeja Electric (IE) employees who had extensive knowledge of all the networks in and around the case towns.},
  keywords={Support vector machines;Energy consumption;Load forecasting;Electricity;Computational modeling;Companies;Predictive models;Transformers;Stakeholders;Load modeling;Load forecast;ANN;SVM;MAE;RMSE;MAPE;AI algorithms;Machine Language},
  doi={10.1109/NIGERCON62786.2024.10927395},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{1158722,
  author={Immanuel, I. and Immanuel, G.-Y.},
  booktitle={32nd Annual Frontiers in Education}, 
  title={Design and construction pedagogy of the future: the Open AEC University}, 
  year={2002},
  volume={3},
  number={},
  pages={S4B-},
  abstract={This work focuses on distance learning in the design and construction university curriculum. The aim is to "open up" the curriculum to design and construction professionals who would like to acquire more skills, thus giving access to students that could not normally participate. The first phase of this work reviews the antecedents of deployment of Internet collaboration in the Architecture, Engineering and Construction (A/E/C) industry. The intent is to extract a model of Internet collaboration to be used as a starting point for building a model for Internet curriculum. The second phase tests out this new model in a pilot program. The pilot will be a collaborative, educational endeavor between Immanuel Solutions and three categories of collaborators: university partnerships, Internet Project Management and Collaboration (IPMAC) service providers, and Nigerian government agencies. The objective of this project is the development of a framework that can be applied to international standards for the 'Open A/E/C University' curriculum. The criteria for framework development are: (1) to test and exploit the global abilities of the A/E/C university collaboration effort on the Internet, and (2) to prove the viability of educational standards that cut across diverse locations.},
  keywords={Collaboration;Collaborative work;Testing;Standards development;Computer aided instruction;Construction industry;Buildings;Web and internet services;Project management;Government},
  doi={10.1109/FIE.2002.1158722},
  ISSN={0190-5848},
  month={Nov},}@INPROCEEDINGS{11200746,
  author={Thejeswari, K and Sunderraj, D Arthur Jebastine and Salini, Y and Deepthi, Pericherla and Prasad, Veera Siva and Kumar, Samparthi V S},
  booktitle={2025 4th International Conference on Innovative Mechanisms for Industry Applications (ICIMIA)}, 
  title={Enhancing Sentiment Analysis in Under-Resourced Languages using Cross-Lingual Transfer Learning and Contextual Adaptation}, 
  year={2025},
  volume={},
  number={},
  pages={1967-1973},
  abstract={The growing amount of user-generated material has made the sentiment analysis important, but low-resource languages still have issues with the lack of annotated material, linguistic tools, and powerful computational models. This paper proposes a transformer-based context-aware sentiment model design that is low resource specific. The model at issue can eliminate major shortcomings in semantic representation and model generalizability using pre-trained multilingual languages like XLM-RoBERTa, integration of context-enhancement mechanisms, and incorporation of algorithms such as data augmentation and cross-lingual transfer learning. It was tested in four under-resourced languages, Swahili, Hindi, Yoruba, and Amharic and found that the framework is much better (6%-10%) in terms of F1-score compared to the traditional approaches. Also, the model showed that compared to the baseline model, context modeling increased accuracy by 9 percent and cross-lingual adaptation increased the accuracy by 11 percent (+9% and +11%). A comparison of resources showed that IndicBERT has the most optimal trade-off in terms of resource-limited settings, whereas XLM-RoBERTa outperformed all of them. It shows that with contextual adaptation and limitations in resources, transformers-based solutions are capable of filling the gap in NLP, in underrepresented linguistics areas.},
  keywords={Sentiment analysis;Adaptation models;Analytical models;Accuracy;Computational modeling;Transfer learning;Semantics;Transformers;Data models;Context modeling;Transformer Models;Sentiment Analysis;Low-Resource Languages;Context-Aware NLP;Cross-Lingual Transfer Learning},
  doi={10.1109/ICIMIA67127.2025.11200746},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11499970,
  author={Kariyakaranage, Vihanga Supasan and Athuraliya, Banuka},
  booktitle={2026 IEEE International Research Conference on Smart Computing and Systems Engineering (SCSE)}, 
  title={CAL-Log: Calibration-Aware Logarithmic Cost Modeling for Active Learning in Low-Resource NLP}, 
  year={2026},
  volume={9},
  number={},
  pages={1-6},
  abstract={Building robust NLP systems for low-resource languages remains constrained by the high cost of expert annotation rather than model architecture availability. This paper proposes CAL-Log, a cost-calibrated active learning strategy that jointly accounts for (i) human annotation time and (ii) model miscalibration in early rounds, extending our prior framework for costaware active learning [23] to genuinely low-resource multilingual settings. CAL-Log introduces a logarithmic annotation-cost model to avoid the “cost-collapse” behavior of linear utility-pertoken heuristics, coupled with a calibration-aware uncertainty signal. We evaluate on $\mathbf{1 0}$ low-resource text classification datasets spanning 8 languages (Sinhala, Tamil, Hindi, Telugu, Yoruba, Amharic, Swahili, Xhosa) over 3 independent random seeds. Results show that CAL-Log achieves an Efficiency Score of 0.281 F1 per 1,000 minutes (mean ± std: $0.432 \pm 0.217$ F1 at $1,535 ~{\min}$), maintaining robust performance across all datasets. Multi-seed ablation confirms that removing the cost model raises annotation cost by $\mathbf{3 9 \%}(+597 ~{\min})$ and lowers efficiency to 0.180, while removing temperature calibration yields a less stable learning trajectory. Our stability analysis demonstrates that CAL-Log prevents the seed-dependent performance collapse observed in linear cost models (cross-seed std up to $\pm 0.296$ on MasakhaNEWS-sw for CAL-Linear) and achieves superior consistency on morphologically complex tasks such as Sinhala Sentiment $(0.547 \pm 0.033$ vs. $0.422 \pm 0.061)$. To our knowledge, this is the first active learning framework to jointly formalize annotation cost collapse and integrate model calibration error into the acquisition function under realistic human-time constraints for low-resource multilingual NLP.},
  keywords={Filtering;Filters;Active filters;Band-pass filters;Protocols;HTTP;Modulation;Radio access networks;Regional area networks;Communication systems;Active learning;cost-aware annotation;text classification;low-resource language;model calibration},
  doi={10.1109/SCSE70081.2026.11499970},
  ISSN={2997-7363},
  month={March},}@INPROCEEDINGS{6639084,
  author={Ghoshal, Arnab and Swietojanski, Pawel and Renals, Steve},
  booktitle={2013 IEEE International Conference on Acoustics, Speech and Signal Processing}, 
  title={Multilingual training of deep neural networks}, 
  year={2013},
  volume={},
  number={},
  pages={7319-7323},
  abstract={We investigate multilingual modeling in the context of a deep neural network (DNN) - hidden Markov model (HMM) hybrid, where the DNN outputs are used as the HMM state likelihoods. By viewing neural networks as a cascade of feature extractors followed by a logistic regression classifier, we hypothesise that the hidden layers, which act as feature extractors, will be transferable between languages. As a corollary, we propose that training the hidden layers on multiple languages makes them more suitable for such cross-lingual transfer. We experimentally confirm these hypotheses on the GlobalPhone corpus using seven languages from three different language families: Germanic, Romance, and Slavic. The experiments demonstrate substantial improvements over a monolingual DNN-HMM hybrid baseline, and hint at avenues of further exploration.},
  keywords={Hidden Markov models;Training;Acoustics;Speech;Feature extraction;Speech recognition;Neural networks;Speech recognition;deep learning;neural networks;multilingual modeling},
  doi={10.1109/ICASSP.2013.6639084},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{10630308,
  author={Atoyebi, Temitope Olufunmi and Olanrewaju, Rashidah Funke and Blamah, N. V. and Uwazie, Emmanuel. C.},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={Comparison of Multinomial Naive Bayes (MNB), Gaussian Naive Bayes (GNB) and Random Forest (RF) Algorithm in Malaria Disease Diagnosis}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Malaria, caused by Plasmodium parasites and transmitted by infected female Anopheles mosquitoes, is still a major worldwide health problem. Millions of people are affected by the disease, which causes life-threatening symptoms and can be deadly in tropical locations. Effective malaria prevention and treatment need early and precise identification. As a result, this study investigates the ability of three machine learning algorithms including Multinomial Naïve Bayes (MNB), Gaussian Naive Bayes (GNB) and Random Forest (RF), in improving performance of malaria diagnosis. The MNB, GNB and RF classifiers are trained to identify malaria cases using a diversified dataset with factors such as "pregnancies," "treated net," "water breeding," "infected mosquitoes," and "age." The dataset consists of patients' health records from General Hospitals in Bwari Area Council and Abuja Municipal Area Council, Abuja, Nigeria. The dataset is gotten from year 2017 to 2021 and it includes both numerical and categorical variables. A 10-fold cross-validation procedure is used to evaluate the model. The experimental findings show that the Random Forest and Gaussian naïve Bayes algorithms performed well with 100% accuracy while the Multinomial Naive Bayes classifier performed better with 97% accuracy. The findings from this study can guide the selection of appropriate machine learning algorithms for real-world malaria diagnosis tasks based on their performance and also tend to addressing paradigm shift from laboratory to the applied Computing field.},
  keywords={Pregnancy;Accuracy;Machine learning algorithms;Malaria;Gaussian processes;Naive Bayes methods;Classification algorithms;Malaria Disease;Machine Learning;Naive Bayes;Random Forest;Plasmodium parasites},
  doi={10.1109/SEB4SDG60871.2024.10630308},
  ISSN={},
  month={April},}@ARTICLE{10916731,
  author={Dwivedi, Shubham and Pandey, Kartikeya and Shubham, Kumar and Pandey, Om Jee and Tripathi, Achyut Mani and Sandhan, Tushar and Hegde, Rajesh M.},
  journal={IEEE Transactions on Artificial Intelligence}, 
  title={MalaNet: A Small World Inspired Neural Network for Automated Malaria Diagnosis}, 
  year={2025},
  volume={6},
  number={9},
  pages={2486-2497},
  abstract={In this work, a novel neural network architecture called MalaNet is proposed for the detection and diagnosis of malaria, an infectious disease that poses a major global health challenge. The proposed neural network architecture is inspired by small-world network principles, which generally involve the introduction of new links. A small-world neural network is realized by establishing new connections, thereby reducing the average path length and increasing clustering coefficient. These characteristics are known to enhance interconnectivity and improve feature propagation within the network. In the context of malaria diagnosis, these characteristics of MalaNet can enhance detection accuracy and enable better generalization in scenarios with limited data availability. Broadly, two variants of MalaNet are proposed in this work. First, a small-world-inspired feed-forward neural network (FNN) is developed for symptom and categorical feature-based diagnosis, providing an accessible solution when blood smear images are unavailable. Subsequently, a small-world-inspired convolutional neural network (CNN) is developed for precise and automated diagnosis when blood smear images are available. Both variants of MalaNet are rigorously validated using the National Institute of Health Malaria dataset, a clinical dataset from Federal Polytechnic Ilaro Medical Centre, Nigeria, and the APTOS dataset. Comparative results against several state-of-the-art neural network models in the literature demonstrate MalaNet’s superior performance, generalization capability, and computational efficiency. The small-world neural network architecture proposed in this work enhances feature learning, diagnostic accuracy, and adaptability in limited-data and resource-constrained settings, motivating its application in disease diagnosis where timely and accurate results are critical.},
  keywords={Malaria;Accuracy;Convolutional neural networks;Diseases;Feature extraction;Computer architecture;Computational modeling;Classification algorithms;Support vector machines;Mortality;Biomedical analysis;malaria;neural networks;Newman–Watts algorithm;small world networks},
  doi={10.1109/TAI.2025.3549406},
  ISSN={2691-4581},
  month={Sep.},}@INPROCEEDINGS{10337283,
  author={Tresner-Kirsch, David and Mikkelson, Amanda Azari and Yinka-Banjo, Chika and Akinyemi, Mary and Goyal, Siddhartha},
  booktitle={2023 IEEE 11th International Conference on Healthcare Informatics (ICHI)}, 
  title={Intent Recognition on Low-Resource Language Messages in a Health Marketplace Chatbot}, 
  year={2023},
  volume={},
  number={},
  pages={457-459},
  abstract={In this paper we explore intent recognition models of user messages sent to a chatbot that primarily uses system-initiated navigation. The chatbot (askNivi) discusses sexual and reproductive health topics for educational purposes and to facilitate healthcare access. It is deployed in four languages, three of which are considered low-resource languages (Hausa, Hindi, and Swahili; the fourth language is English). Although the primary navigation mode is system-initiated, many users attempt to take initiative by expressing various intents with natural language messages. This paper describes a multi-lingual corpus of those initiative attempts manually annotated with intent labels as well as results of modeling experiments on the classification of these intents using context-dependent supervised machine learning.},
  keywords={Navigation;Medical services;Machine learning;Chatbots;Informatics;Context modeling;Natural Language Processing (NLP);dialogue systems;intent recognition;sexual and reproductive health},
  doi={10.1109/ICHI57859.2023.00066},
  ISSN={2575-2634},
  month={June},}@INPROCEEDINGS{9043271,
  author={Miyim, Abubakar Muhammad and Wakili, Abubakar},
  booktitle={2019 15th International Conference on Electronics, Computer and Computation (ICECCO)}, 
  title={Performance Evaluation of LTE Networks}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={The explosion of mobile data usage due to the increase of mobile subscribers and emergence of new applications such as mobile TV and online gaming, which requires high quality of service is the driving force for developing Long-Term Evolution (LTE) mobile networks by 3GPP. Service providers are migrating to this network due to its promising quality of service to assist them meet the growing end-user demand for more bandwidth, high security and faster connectivity. Service providers in Nigeria claimed to have rolled out 4G (LTE) nationwide, yet mobile subscribers are still unhappy with network operators over slow network connection and poor quality of service. Base on this motive, OMNeT++ simulator was used to evaluate performance of LTE networks by varying number of user equipment (UE) connected to evolved Node Base station (eNB), distance of UE from eNB and mobility speed of UE. Performance metrics used are throughput, end-to-end delay and packet loss. We observed that the LTE network is capable of providing good quality voice call. Though, its quality is affected with increasing distances between UE and eNodeB, number of connected users, and mobility speed of user.},
  keywords={Packet loss;Quality of service;Mobile TV;Jitter;Throughput;Performance metrics;Delays;Performance analysis;Security;Long Term Evolution;LTE;Performance evaluation;Throughput;Delay;Packet loss},
  doi={10.1109/ICECCO48375.2019.9043271},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{6970097,
  author={Azeta, A. A. and Omoregbe, N. A. and Ayo, C. K. and Raymond, A. and Oroge, A. and Misra, Sanjay},
  booktitle={2014 Global Summit on Computer & Information Technology (GSCIT)}, 
  title={An anti-cultism social education media system}, 
  year={2014},
  volume={},
  number={},
  pages={1-5},
  abstract={Social media online forum is one of the most popular platforms used by students to communicate. Unfortunately, these media have been hijacked by people to plan and commit online fraud and societal evils. Some of the secondary and university campuses in Nigeria have been turned to cultist environments leading to killings and anarchy amongst students. This situation has defied solutions in most tertiary institutions in the country, particularly in the public institutions. The objective of this paper is to provide an anti-cultism social media educational system that will be accessed using three modes: Web, Mobile and Voice. The system will support learning and interaction on campus while at the same time helping to curb cultism on campus through filtering of communicated social media keywords that are cultism or crime related, among students. In carrying out this project, appropriate research methods and implementation tools were deployed. The project offers a multimodal platform that will foster and encourage active learners' participation in the school system.},
  keywords={Educational institutions;Registers;Education;Anti-Cultism;Filtering;Socialmedia},
  doi={10.1109/GSCIT.2014.6970097},
  ISSN={},
  month={June},}@INPROCEEDINGS{6680162,
  author={Zingerle, Andreas and Kronman, Linda},
  booktitle={2013 International Conference on Cyberworlds}, 
  title={"Faceless Patrons" -- An Augmented Installation Exploring 419-Fictional Narratives}, 
  year={2013},
  volume={},
  number={},
  pages={388-388},
  abstract={Summary form only given. Scamming is a global phenomenon and victims can be found everywhere with no difference in gender or race. To persuade the victim into paying money upfront, the scammers create story worlds with 'get rich quick' schemes that seem 'too good to be true'. The scammers draw on emotions like greed, empathy or love. The different narratives are situated in the grey area between reality and fiction [1]. Story worlds can get very detailed and involve several characters and are often related to real life. We wanted to take a closer look on these scam narratives a type of cybercrime stories that we coined '419-fiction', '419' relating to the criminal code in Nigeria that deals with fraud. These stories reflects the dystopian side of computer mediated communication where the Internet enables a world of false representations, abuse of trust, humiliation and desperation for opportunities. An augmented installation setup consists of five photo-frames hanging on a wall. Each frame connects to a correspondence with a scammer and holds a photograph and a fake cheque that was received as an advance payment for Anna Masquers photos. By using a smartphone or a tablet that can be provided for demonstration purpose the visitor can scan each photograph via a third party AR-Browser. Each physical photograph is then overlaid with an AR layer containing a video compilation of images. These images are the result of an Online search in an attempt to confirm or invalidate the authenticity of the scammers character and his online representations. These images attempt to give a face to the faceless scammer, yet fails while the posed art buyer can be anyone or no one of the persons found within the search. Additionally to the images the video contains a voice over narrating parts of the email correspondence, enabling the visitor to follow the whole narrative paths of the 'overpayment check scam' scheme.},
  keywords={Art;Computer crime;Electronic mail;Internet;Educational institutions;Computer mediated communication;Wires},
  doi={10.1109/CW.2013.44},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10629907,
  author={Agagu, Modupe and Gbadebo, Samuel Damilare},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={A Web-based Sentiment Analyzer for Tweets Using Machine Learning Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={In today's digital age, people often communicate and engage online during elections. Twitter is a popular social media platform that enables people to interact, share views and ideas, and give comments. It is a valuable source of data for sentiment analysis, as it provides a real-time snapshot of public opinion on a wide range of topics, including elections. This study is centered on electoral events. The primary focus was on Twitter data, specifically examining tweets related to Nigeria's recently concluded 2023 presidential election. Leveraging a pre-trained machine learning model from the Hugging Face library (Sentiment_Analyzer) and the Naïve Bayes algorithm, this dataset was diligently trained. With the exponential growth of online content, there is an increasing demand for efficient and accurate sentiment analysis tools. This paper provides a web-based sentiment analysis system that utilizes two machine learning algorithms, Naive Bayes and the Hugging Face transformers model, to classify the sentiment of text data.A comparative analysis of the Naive Bayes and Hugging Face transformer model and their performance evaluation in terms of accuracy, and results were conducted. The results demonstrate that the Hugging Face transformers model (Sentiment_Analyzer) outperforms the Naive Bayes algorithm, achieving higher classification accuracy and better overall performance.},
  keywords={Sentiment analysis;Analytical models;Machine learning algorithms;Accuracy;Social networking (online);Voting;Machine learning;Web-based Sentiment Analysis;Machine Learning Algorithm;Hugging Face transformer model;Naïve Bayes Algorithm;Twitter Tweets;Electoral Events},
  doi={10.1109/SEB4SDG60871.2024.10629907},
  ISSN={},
  month={April},}@INPROCEEDINGS{8770886,
  author={Kumar Verma, Arun and Nandan, Ranbir and Verma, Aditi},
  booktitle={2018 IEEE Indian Conference on Antennas and Propogation (InCAP)}, 
  title={Regional variability of Specific rain attenuation in mm wave region for Indian Sub-tropical climate}, 
  year={2018},
  volume={},
  number={},
  pages={1-4},
  abstract={The radio signal in mm wave region is affected by rain characteristics such as rain rate, rain drop size distribution, spatial and temporal structure apart from polarization of signal. Thus, rain causes attenuation of radio signal in the mm wave region (30 GHz to 300 GHz), which becomes important as fade margin for the design of reliable communication. The rain drop size distribution (RDSD), which varies for different climatic conditions at the same rain rate, plays very important role for attenuation of radio signals in mm wave region. The tropical region such as India, Malaysia, Brazil, Nigeria, South Africa and Singapore follows log-normal rain drop size distribution. In this paper, various lognormal RDSD models of Indian Climate based on rain drop size spectra measurement at Dehradun, Kharagpur, Shillong, Ahmedabad, Hassan and Trivandrum have been discussed in respect of rain drop size spectra and compared with lognormal RDSD models of other tropical countries. Further, the specific rain attenuation model developed from different RDSD models of Indian tropical climate is described, which shows the regional variability in the specific attenuation at mm wave region due to variation in the rain characteristics. It is observed that specific rain attenuation at 100 GHz decreases less compared to 60 GHz with the increase of rain rate. The specific rain attenuation at 100 GHz is less compared to 60 GHz beyond the rain rate of 30 mm/hr depending upon the locations due to different RDSD characteristics in the Indian tropical region.},
  keywords={Rain;Attenuation;Size measurement;Bandwidth;Scattering;Data models;Rain Drop Size Distribution;mm wave frequency;specific rain attenuation},
  doi={10.1109/INCAP.2018.8770886},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8333322,
  author={Igwe, K. C. and Oyedum, O. D. and Ajewole, M. O. and Aibinu, A. M.},
  booktitle={2017 13th International Conference on Electronics, Computer and Computation (ICECCO)}, 
  title={Received signal strength computation for broadcast services using artificial neural network}, 
  year={2017},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper investigates the influence of weather parameters on very high frequency (VHF) radio signals. Received signal strength (RSS) data were obtained from four broadcast stations in Niger State, transmitting at 91.2 MHz, 92.3 MHz, 100.5 MHz and 210.25 MHz while atmospheric parameters of temperature, pressure, relative humidity and wind speed data were obtained from the Tropospheric Data Acquisition Network (TRODAN) situated at the Federal University of Technology, Bosso Campus, Minna, Nigeria. The measurements were carried out for six months (January - July). An artificial neural network (ANN) model was designed to compute received signal strength using the measured atmospheric parameters. The training of the network was performed using Levenberg-Marquardt feed-forward backpropagation algorithm. The training process was performed by the evaluation of different effects of activation functions at the hidden and output layers, number of neurons in the hidden layer and data normalisation. The results obtained showed that the ANN model performed satisfactorily for the four broadcast stations as the computed signal strength values from the ANN model were reasonably close to the measured signal strength values with minimal errors. Also, the model performed well when tested on different data sets not used for the ANN training.},
  keywords={Neurons;Artificial neural networks;Training;Atmospheric measurements;Refractive index;Temperature measurement;Wind speed;Artificial neural network;received signal strength;VHF},
  doi={10.1109/ICECCO.2017.8333322},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9025147,
  author={Ighravwe, Desmond Eseoghene and Mashao, Daniel},
  booktitle={2019 IEEE 2nd International Conference on Renewable Energy and Power Engineering (REPE)}, 
  title={Assessment of Renewable Energy Technology Financing Models in Developing Countries Using Sustainability Metrics}, 
  year={2019},
  volume={},
  number={},
  pages={145-149},
  abstract={Renewable energy technology (RET) project is a capital investment; hence, enough fund must be made available to prevent either delay or abandoning of the project. It is, therefore, compulsory that stakeholders consider all alternatives for RET funding before the commencement of a RET project. This article presents a framework that improves how RET financing models are analyzed under uncertainty conditions. The framework integrates best worst (BW) method and extended Technique for Order of Preference by Similarity to Ideal Solution (TOPSIS) method; these methods were selected because they improve the optimality of a decision-making process. Selected social, technical, economic, environmental and policy (STEEP) indicators were used to evaluate RET financing models. BW method was used to evaluate these indicators importance. The implementation of solar photovoltaic (PV) micro-grid project in a remote community in Nigeria was used as a case study. Based on literature knowledge, three RET financing models (debt -P1, private equity -P2, and public funds -P3) were selected based on their unique attributes to public projects success in developing countries. From a STEEP perspective, these models were ranked as follows: P1>P2>P3.},
  keywords={Biological system modeling;Mathematical model;Linguistics;Stakeholders;Sustainable development;Renewable energy sources;Economics;Sustainability;Public-Private Partnership;Renewable Energy Technology;Extended TOPSIS},
  doi={10.1109/REPE48501.2019.9025147},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11472316,
  author={Famoriji, Oluwole John and Shongwe, Thokozani},
  booktitle={2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)}, 
  title={Deep Learning Assisted Radiowave Propagation Loss Prediction in the Tropics}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Predicting path loss is a crucial task for proper link planning and budgeting in mobile communication. Numerous studies are being conducted to forecast path loss in diverse places with varied obstacles, and there are numerous path loss prediction models available in the literature. Accurately predicting path loss in various locations is a continuing issue because path loss models are site-specific. The earlier models either used specific parameters or collected data to generalize path loss. Recently, there has been interest in researching the application of artificial intelligence, which is distinct from the existing heuristic methodologies. In this paper, a deep learning methodology is used to develop a path loss prediction method. A measurement campaign is carried out in the tropics with a particular reference to Akure metropolis, Nigeria), taking into account numerous environmental conditions influencing measurement, and used in the developed deep learning models' training. The findings show the degree of accuracy and efficiency of the developed deep learning technique when predicting path losses.},
  keywords={Satellite images;Earth Observing System;Antennas;Propagation losses;Transmitting antennas;Electromagnetic propagation;Receiving antennas;Antenna arrays;Feeds;Antenna feeds;EM propagation;propagation loss prediction;deep learning;tropical region;mobile communications},
  doi={10.1109/ICECET63943.2025.11472316},
  ISSN={},
  month={July},}@INPROCEEDINGS{8521004,
  author={Adetokun, B.B and Somefun, T.E and Adekitan, A.I and Aligbe, A. and Orimogunje, A.M},
  booktitle={2018 IEEE PES/IAS PowerAfrica}, 
  title={Development of an ANN-Based Estimated Electricity Billing System}, 
  year={2018},
  volume={},
  number={},
  pages={96-101},
  abstract={This paper presents an Artificial Neural Network (ANN) model to determine the estimated monthly payment for electricity consumed by residential consumers. The network was trained, validated and tested with five consumer input attributes which comprises type of apartment, number of occupants, average daily power supply, scored categories of electrical appliances and scored behavioural energy usage pattern. The corresponding output data comprises of the average monthly payment obtained from metered residential customers. A combined R-value of 0.99923 was obtained for the trained network. This indicates a very accurate ANN training. The developed network was then utilised to compute the estimated monthly amount to be paid by unmetered residential consumers. Comparisons were also made with the rather unclear and controversial estimated amount utilised by the electricity distribution companies in Nigeria. This work therefore provides a better method for estimated billing in the absence of prepaid meter, which has been of inadequate supply to electricity users in developing countries like Nigeria.},
  keywords={Training;Artificial neural networks;Electrical products;Companies;Meters;Mathematical model;Neurons;electricity bill;prepaid meter;artificial neural network;estimated billing;residential consumers;energy usage},
  doi={10.1109/PowerAfrica.2018.8521004},
  ISSN={},
  month={June},}@INPROCEEDINGS{9219838,
  author={Folorunso, Samuel S. and Onibonoje, Moses Oluwafemi and Wara, Samuel Tita},
  booktitle={2020 IEEE PES/IAS PowerAfrica}, 
  title={A Mitigation Concept for Energy-Demand Based Carbon Footprint in a University Campus}, 
  year={2020},
  volume={},
  number={},
  pages={1-5},
  abstract={Energy generation and its consequent environmental impact due to the resulting carbon footprint is in the forefront of global researches. The power poverty in Nigeria has immensely enabled Universities to embark on diesel-powered generators to provide the energy requirement for teaching, researches and community services. Hence, the campuses are becoming hotspots for emission of carbon dioxide and other greenhouse gases, thereby contributing to global warming and environmental degradation. This study developed a management regime for carbon footprint in Afe Babalola University, Ado Ekiti (ABUAD), Nigeria. It audited the various activities and units that directly or indirectly promote green gases on the campus environment over a period of twelve months. The carbon footprint over the period was estimated to be 15,335,017.41 kgCO2e, with the bulk of the emissions (15,272,803.68 kgCO2e) coming from electricity generation and use. The data was modelled and analysed to arrive at veritable mitigation strategies},
  keywords={Renewable energy sources;Gases;Costs;Greenhouse effect;Green products;Carbon dioxide;Generators;Carbon Footprint;Energy;Environment;Greenhouse gases;University Campus},
  doi={10.1109/PowerAfrica49420.2020.9219838},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{9905304,
  author={Atilola, O. F. and Akorede, M. F. and Olarinoye, G. A. and Oladeji, A. S.},
  booktitle={2022 IEEE PES/IAS PowerAfrica}, 
  title={Optimal Sizing and Techno-economic Analysis of an Off-grid Solar Photovoltaic System for Rural Electrification}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={The economics of generating electricity is becoming a great challenge to the developing countries, thereby making electricity difficult to be assessed in rural areas that are completely off-grid. For this reason, there is a need to extend electricity to these rural areas by exploring the available renewable energy source in Nigeria. This work was carried out using a remote community in Nigeria as a case study. The electrical load survey of the community was carried out to determine the load demand of the area. The value of S4.6 kWh was obtained as the daily load demand considering the future expansion that will be included in the nearest future, hence the load curve was determined. This work also considered the modelling and optimization of the system components prior to the economic analysis of the project. The BAT algorithm was used as an optimization tool to determine the number of PV modules, battery banks and the capacity of the inverter to be used. At different scenarios, the number of the components varied with the days of autonomy of the energy storage system and PV power rating. The Levelised Cost of Energy (LCOE) was determined to be 0.5034 ${\$}$/kWh. Finally, the results were validated against the HOMER software.},
  keywords={Photovoltaic systems;Renewable energy sources;Costs;Power demand;Software algorithms;Solar energy;Software;Economics;Renewable energy;Electrical load survey;BAT algorithm;Levelised cost of energy;HOMER software},
  doi={10.1109/PowerAfrica53997.2022.9905304},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{6133181,
  author={Sule, Mary-Jane},
  booktitle={2011 IEEE Third International Conference on Cloud Computing Technology and Science}, 
  title={A Conceptual Framework of Deploying Cloud IaaS in Higher Educational Institutions}, 
  year={2011},
  volume={},
  number={},
  pages={489-493},
  abstract={All cloud services require the fundamental layer known as Infrastructure as a service (IaaS). Clouds have the benefit of being cost effective, while improving productivity. This paper is focused on a proposed conceptual model for deploying Cloud IaaS in Higher Educational Institutions in Africa with Nigeria as a Case Study. As an IT professional working in the educational sector in this region the investigator has experience the gains of ICT in both learning and dissemination of information Though the focus of this research is on Nigeria, the resulting structure can be implemented across the African continent and other developing countries.},
  keywords={Availability;Communities;Cloud computing;Educational institutions;Bandwidth;Data models;Data Centres;Power;Cost;Services;scalable},
  doi={10.1109/CloudCom.2011.72},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10926964,
  author={Badrudeen, Tayo Uthman and Nwulu, Nnamdi I. and Salau, Ayodeji Olalekan and Peter Adeagbo, Ayooluwa},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Optimisation of Localized Power Generation from Hybrid Renewable Energy Sources for Agri-food Production}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The recent rising cost of farm produce in Nigeria could be linked to low rainfall as a result of climate change amongst other factors. This research proposes an autonomous irrigation system from a standalone hybrid renewable energy sources (RESs) for Obafemi Awolowo University Farm, Ile-Ife, Nigeria, to combat hunger and climate change. The study considers solar PV, wind and battery storage system for robust energy generation while upholding the ecological and environmental benefits from these RESs. The proposed off-grid architecture was designed and optimized using HOMER Pro software. The evaluation metrics are levelized cost of electricity (LCOE), and greenhouse gas emission reduction. The modeling parameters of the farm’s load profile are average daily load demand, daily load demand, peak load, and load factor with the corresponding values of 62.91 kWh/d, 2.62 kW, 9.10 kW and 29%, respectively. The results from the simulation revealed that LCOE of wind turbine and PV solar of the study area are 5.60 $/kWh and 0.169 $/kWh, respectively, for an estimated lifecycle of 15 years. Based on the available surface meteorological data of the study area from NASA, the optimized cost result for proposed farm is given to be solar PV and battery storage system.},
  keywords={Wind energy generation;Renewable energy sources;Irrigation;Climate change;Costs;Rain;Software;Batteries;Wind turbines;Sustainable development;sustainable development goals (SDGs);renewable energy;food security;sustainable environment;carbon tax;irrigation farming},
  doi={10.1109/NIGERCON62786.2024.10926964},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{8609185,
  author={Ometan, O. O. and Omotosho, T.V and Akinwumi, S. A. and Boyo, A. O.},
  booktitle={2018 IEEE International Symposium on Antennas and Propagation & USNC/URSI National Radio Science Meeting}, 
  title={Impact of Rain on Earth-Space Communication Link in West-Africa}, 
  year={2018},
  volume={},
  number={},
  pages={2489-2490},
  abstract={The impairment of radio signal at Ku band and above by rain is a key factor in satellite communication and radar remote sensing modelling. The major effect of rain on electromagnetic signals is by absorption and scattering. This effect is noticed both on the uplink and downlink at 0.01 % unavailability in an average year. The data bank used for the computation of the rain attenuation for a link to Nigeria Communication satellite (NigComsat II) for selected locations in West Africa was obtained from the International Telecommunication Union Radio Propagation Recommendation [10]. The input parameters obtained from ITU-R study group 3 data base were used in this study. The various results of the rain attenuation values at C, Ku, Ka, and V bands were presented on contour map. The results reveal lowest value is at C-band which gradually increases at Ku and Ka bands while the highest values of total attenuation are experienced at V-band for all the locations. Both uplink and downlink results at V-bands show constantly that total attenuation is more severe in countries like Togo, Liberia, Ghana, Benin, Ivory Coast, and Nigeria. It should be noted that all these countries are in the tropical region of West Africa where rain accumulation and rain rate is very high.},
  keywords={Attenuation;Rain;Africa;Uplink;Downlink;Electromagnetic scattering;satellite communication;rain attenuation prediction;West Africa and radiowave propagation},
  doi={10.1109/APUSNCURSINRSM.2018.8609185},
  ISSN={1947-1491},
  month={July},}
