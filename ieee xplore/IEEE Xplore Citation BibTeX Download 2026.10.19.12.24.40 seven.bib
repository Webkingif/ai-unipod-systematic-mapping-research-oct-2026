@INBOOK{11003128,
  author={Ekpe, Unwana Macaulay},
  booktitle={Reconfigurable Intelligent Surfaces for 6G and Beyond Wireless Networks}, 
  title={RIS&#x2010;Empowered Terrestrial and Non&#x2010;terrestrial Wireless Communication Systems}, 
  year={2025},
  volume={},
  number={},
  pages={525-550},
  abstract={Summary <p>Dr. Unwana Macaulay Ekpe received his Bachelor of Engineering degree in Electrical and Electronic Engineering from the University of Uyo in 2004. In 2007 and 2012, respectively, he received the Master of Science degree in Satellite Communication Engineering and the Doctor of Philosophy in Electronic Engineering from the University of Surrey, United Kingdom. He was promoted to Senior Lecturer in October 2016 and served as Head, Department of Electrical and Electronic Engineering, Akwa Ibom State University, Ikot Akapden, Nigeria from October 2018 to September 2022. He is now an Associate Professor at the Akwa Ibom State University and a Visiting Senior Lecturer in the Department of Electrical and Computer Engineering at the Makerere University, Kampala, Uganda.</p> <p>Dr. Ekpe's research interests include optimization of land&#x2010;mobile communication networks, virtualization of sixth&#x2010;generation non&#x2010;terrestrial networks, and grid&#x2010;integration of renewable energy resources. Dr. Ekpe has supervised and graduated over 60 postgraduate and undergraduate students and has won several research grant awards. He has authored 2 book chapters and over 20 technical articles in peer&#x2010;reviewed international journals and conference proceedings.</p> <p>Research into the use of reconfigurable intelligent surfaces (RISs) has been gathering momentum in recent years mainly because of their potential to enhance the performance of wireless communication systems without incurring penalties in terms of increased energy consumption and system complexity. This chapter starts by briefly presenting the building blocks of RIS, being metamaterials, metasurfaces and their control mechanisms. The supporting technologies for deploying RIS in terrestrial and non&#x2010;terrestrial wireless communication systems are then presented. To ensure that the variables used are consistent for both environments, the free space path loss model is presented before detailing a complete geometry&#x2010;based system model. Using these models, the architecture for implementing RIS&#x2010;empowered terrestrial communication systems enhanced by multiple&#x2010;input multiple&#x2010;output and orthogonal frequency division multiplexing techniques in the terrestrial environment is presented. For the non&#x2010;terrestrial environment, RIS&#x2010;empowered aerial networks comprising unmanned aerial vehicles and high&#x2010;altitude platforms are summarized. Following these, architectures involving satellites are presented followed by a multilayered integrated RIS&#x2010;empowered system involving both terrestrial and non&#x2010;terrestrial components. The chapter concludes by presenting lessons learnt and discussing future research directions.</p>},
  keywords={Reconfigurable intelligent surfaces;Metasurfaces;Metamaterials;Wireless communication;Magnetic materials;Schottky diodes;PIN photodiodes;Energy efficiency;Varactors;Propagation losses},
  doi={10.1002/9781394250141.ch16},
  ISSN={},
  publisher={IEEE},
  isbn={9781394250134},
  url={https://ieeexplore.ieee.org/document/11003128},}@ARTICLE{11299808,
  author={Ramesh, Jayroop and Sabu Thomas, Stalin and Khamis, Amar Hassan and Sagahyroon, Assim and Aloul, Fadi and Rushood, Adel},
  journal={IEEE Access}, 
  title={Interpretable Machine Learning Models for Vitamin A Deficiency Screening in School-Aged Children}, 
  year={2025},
  volume={13},
  number={},
  pages={212999-213015},
  abstract={Vitamin A deficiency (VAD) is one of the leading causes of visual impairment globally. While blood tests are common approaches in developed countries, socioeconomic and public perspectives render this a challenge in developing countries. In Africa and Southeast Asia, the alarming rise of preventable childhood blindness and delayed growth rates has been classified as an “epidemic”. With the proliferation of machine learning in clinical support systems and the relative availability of electronic health records, there is a potential promise of early detection to curb ocular complication progression. In this work, the aim is to observe the feasibility of detecting Vitamin A deficiency in children by utilizing existing records using machine learning techniques instead of requiring retinol serum tests. For this purpose, a heterogeneous tabular dataset consisting of 18,423 unique patient records across 25 features belonging to the non-invasive ocular symptomatology and ophthalmological diagnoses was acquired from a children’s hospital in Maradi, Nigeria. Extensive empirical comparisons between traditional machine learning and deep learning methods are provided with their corresponding interpretability through attributions and shapley values. The achieved results indicate that in the case of sparse datasets, after rectification for class imbalances using SMOTE-NC, Random Forest, Light Gradient Boosting Model achieved the highest balanced scores of accuracy: 86.0%, sensitivity: 81.8%, specificity: 86.4% and F1-score: 72.7% respectively. To the best of the authors’ knowledge, this is one of the first studies exploring the utility of routine eye examination records to screen for Vitamin A deficient individuals in a school-aged population. We conclude that machine learning can aid in identifying possible candidates for prioritized testing, dietary supplementation and treatment.},
  keywords={Machine learning;Pediatrics;Visualization;Electronic medical records;Developing countries;Accuracy;Random forests;Ophthalmology;Correlation;Blood;Electronic health records;ophthalmology;machine learning;vitamin a deficiency;deep learning},
  doi={10.1109/ACCESS.2025.3644236},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10629694,
  author={Oguntimilehin, Abiodun and Babalola, Gbemisola O. and Akinduyite, Christianah O. and Obamiyi, Stephen E. and Okebule, Toyin and Oyelami, Funmilayo H. and Abiola, Oluwatoyin B. and Badeji-Ajisafe, Bukola and Abang, Efaibinokpabi},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={A Machine Learning Driven Malaria Fever Medical Consultation Chatbot}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Nearly half of the world's population is at risk of malaria fever. There were reported 247 million cases of malaria fever as at the year 2021 with 619000 deaths. This shows malaria is yet a serious burden to the world. Patients now have additional options for receiving medical information and services as a result of the increased use of chatbot systems in the healthcare delivery. In this work, a Machine Learning technique -Decision Tree was trained using malaria dataset collected from Adetoyin Hospital, Ado-Ekiti, Nigeria. The decision rules from the decision tree were then used to train the medical chatbot using Feed Forward Neural Network (FNN) Natural Language Processing (NLP) technique. Performance evaluation results of both the Decision Tree model and the medical chatbot were encouraging. The developed system is intended to discuss normally with patients and obtain pertinent medical history and symptoms of malaria fever and thereafter offers medical diagnosis. This experiment shows medical chatbot systems have the potential to improve patient access to healthcare services by giving patients a quick, easy, and personalized source of medical advice; these technologies can aid in the digital revolution of healthcare.},
  keywords={Performance evaluation;Malaria;Sociology;Neural networks;Machine learning;Chatbots;Decision trees;Malaria Fever;Machine Learning;Chatbot;FFNN;NLP},
  doi={10.1109/SEB4SDG60871.2024.10629694},
  ISSN={},
  month={April},}@INPROCEEDINGS{11631475,
  author={Olofin, Daniel and Abdulwahab, Olajumoke and Ige, Olaoluwasubomi and Oyemaja, Ayomide and Garuba, Moshood and Ogundiran, Oluwafikunayomi and Alhassan, Tahidu},
  booktitle={2026 7th International Conference on Artificial Intelligence, Robotics, and Control (AIRC)}, 
  title={Deep Temporal Learning for HIV Forecasting: Modeling Epidemic Dynamics with Long Short Term Memory Networks}, 
  year={2026},
  volume={},
  number={},
  pages={476-481},
  abstract={Accurate forecasting of HIV prevalence is essential for epidemic surveillance and public health planning. This study develops a deep temporal learning framework using a Long Short-Term Memory (LSTM) network to predict monthly HIV prevalence from hospital data collected between 2010 and 2021 in Kaduna State, Nigeria. The series was differenced, converted to a supervised format, and normalized prior to modeling. Seventy percent of observations were used for training and 30% for out-of-sample testing. Forecasting performance was evaluated against a classical ARIMA baseline. The LSTM model achieved RMSE/MAE values of 5.81/4.69 on the training set and 4.22/3.48 on the test set, achieving lower forecasting errors than the ARIMA baseline. Predictions closely tracked observed patterns, capturing both short- and long-term dynamics. These findings demonstrate the potential of deep temporal learning models as reliable data-driven tools for HIV forecasting and highlight their applicability for supporting proactive public health monitoring and decision-making in resource-constrained settings.},
  keywords={Human immunodeficiency virus;Modeling;Forecasting;Long short term memory;Equations;Training;Timing;Testing;Tagging;Learning (artificial intelligence);HIV prevalence;long short-term memory (LSTM);deep temporal learning;time-series forecasting;epidemic dynamics;epidemiological surveillance;Nigeria},
  doi={10.1109/AIRC69745.2026.11631475},
  ISSN={},
  month={April},}@INPROCEEDINGS{10630395,
  author={Elemile, O. O. and Olajide, O. S. and Arowolo, M.O. and Ejigboye, O. P. and Ibitogbe, E. M. and Ajayi, E. O. and Akinola, A.O. and Ogunrinde, O.A.},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={Prediction of Noise Pollution in Omu-Aran Township Using Artificial Neural Network}, 
  year={2024},
  volume={},
  number={},
  pages={1-14},
  abstract={Human health is unprotected upon constant exposure to impermissible noise. In Nigeria, several studies have suggested different models to validate noise pollution, but there is none carried out on noise levels in Omu-Aran, therefore this study, was aimed at validating noise levels in Omu-Aran Township using Artificial Neural Network. Data was collected from 21 selected locations in the morning, afternoon, and evening during the school and holiday periods for 3-weeks with a sound level meter model SL4010. ANN architecture was designed to incorporate 19 noise-determinant factors as the input, which were collected using the descriptive field investigation method. A total of 1134 data was loaded to the model, by random sampling, 70% of the data was used to train the network, and 30% being used for testing. Importation of algorithms and selection of epoch value is based on two hidden layers chosen. ArcGIS was adopted for mapping the noise level of all locations. The average mean noise levels in the mornings, afternoons and evenings were 67.82± 2.1, 68.7± 1.87, and 69.53± 2.24 dB respectively. There was a significant difference in noise levels during the working hours at the most concentrated locations, which were all above the permissible noise level given by OSHA and WHO. The ANN validation gives one of the best results with an increase in input data when compared to other publications with a prediction accuracy of 97.84%, and the root means a square error were given to be (RMSE =0.1096). Population and human activities are not the only determinant factors of noise pollution, but also biological factors have impact on the noise levels at the different locations in Omu-Aran Township. Hence, there is a need for proper urban planning and law enforcement at the local level to regulate noise pollution to permissible limits.},
  keywords={Pollution;Noise;Urban planning;Artificial neural networks;Data models;Sustainable development;Statistics;Noise Levels;Artificial Neural Networks;Noise Map;Decibel;Omu-Aran},
  doi={10.1109/SEB4SDG60871.2024.10630395},
  ISSN={},
  month={April},}@INPROCEEDINGS{10777284,
  author={Abdurahman, Hamza Shukri and Yimer, Amare Kassaw},
  booktitle={2024 International Conference on Information and Communication Technology for Development for Africa (ICT4DA)}, 
  title={Barriers and Challenges in Clinical Application of Machine Learning Algorithms}, 
  year={2024},
  volume={},
  number={},
  pages={96-101},
  abstract={According to the World Health Organization’s 2022 report, pneumonia is the primary cause of death for children, with over five million under-five deaths, while Nigeria, India, Pakistan, the Democratic Republic of the Congo, and Ethiopia account for half of these deaths. Currently, this disease is diagnosed manually by a radiologist using a chest x-ray image. However, through this method, the identification of pneumonia is difficult due to the overlapping features of various conditions of the lower respiratory tract. Recently, there have been plenty of machine learning models developed to diagnose pneumonia. Nevertheless, none of these models were used for support in the diagnosis of pneumonia in a healthcare setting. By collecting chest CXR images from local healthcare facilities as well as global sources and creating a CNN model, the main barriers and challenges associated with machine learning algorithms in clinical applications were identified in this work. The key barriers and challenges were identified as data, algorithms and clinical utilities, strategy and financing, and technology. The association between clinical diagnosis and machine learning algorithms was also investigated, including the radiologist’s attitude toward machine learning, performance analysis on pneumonia detection, limitations of clinical diagnosis, limitations of machine learning diagnosis, and machine learning-aided diagnosis. Finally, a clinical diagnosis of pneumonia supported by machine learning algorithms is recommended as the only viable option for accurate treatment.},
  keywords={Analytical models;Pneumonia;Machine learning algorithms;Soft sensors;Machine learning;Radiology;Data models;Clinical diagnosis;Medical diagnostic imaging;X-ray imaging;Barrier and Challenges;Chest x-ray image;Healthcare setting;Machine learning algorithm;Pneumonia},
  doi={10.1109/ICT4DA62874.2024.10777284},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11582009,
  author={Arkhurst, Anthony Vincent and Sani, Hadiza Nass and Mangaliso, Dlamini Lihle and Ayipah, Prince Smith},
  booktitle={2026 ICEENG International Conference for Innovations in Intelligent Computing and Cybersecurity (IICC)}, 
  title={Quantum Risk Intelligence for Border Security & Migration Prediction in Africa}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={African border security and migration systems operate under extreme uncertainty, nonlinear interactions and chronic data sparsity. Classical risk-assessment and surveillance models largely designed for data rich environments tend to struggle. This is to capture emergent behaviors such as coordinated irregular crossings, adaptation of smuggling networks and seasonal migration surges driven by climate and conflict. This paper seek to introduce a hybrid classical–quantum modeling framework for educational and research purposes. The framework reformulates border security and migration dynamics as an inverse boundary problem. The primary contribution of this work is not a general prediction tool, but a specific hybrid pipeline that solves the ’data desert’ problem by treating migration as an inverse boundary problem. We validated this by (1) reconstructing a 380-node risk field for Nigeria and (2) demonstrating that a QAOA-based allocation achieves an optimal risk reduction score of 3.2 on a 10-node test set, significantly outperforming classical sampling in query complexity. Rather than proposing operational deployment, the study focuses on methodological feasibility and computational complexity: how quantum-based representations can improve modeling fidelity, scenario exploration and decision robustness in complex security systems.},
  keywords={Modeling;Equations;Optimization;Security;Limiting;Tagging;Printing;Algorithms;Encoding;Africa;Quantum Algorithms;Predictive Security;Migration;Intelligence;Classical Benchmarking},
  doi={10.1109/IICC69623.2026.11582009},
  ISSN={},
  month={May},}@INPROCEEDINGS{9803069,
  author={Amadi, Emmanuel Chukwudi and Chukwudebe, Gloria and Ayogu, Ignatius and Ikerionwu, Charles and Okafor, K. C.},
  booktitle={2022 IEEE Nigeria 4th International Conference on Disruptive Technologies for Sustainable Development (NIGERCON)}, 
  title={Implementation of a Web Application for Stakeholder Inclusion for Sustainable Waste Management}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents Waste Management and Hazard Alert System (WM-HAS) web application as a novel business model supporting all stakeholders in the waste management ecosystem for seamless participation in the waste business. The innovative business model is developed for stakeholder inclusion to address the challenges of sustainable waste management in developing countries. The identified stakeholders include the Waste Generators, Pickers, Collectors, and Recyclers. Although, the informal sector has unofficially joined the waste eco-system to do business (i.e., picking, recycling, etc), there is no cohesion or regard for safety. WM-HAS runs on a regular computer or a mobile device and offers all stakeholders a user-friendly interface for doing business. It also integrates an Eyewitness interface and has an Internet of Things (IoT) report page that connects to IoT nodes located at dumpsites to detect hazardous gases. The scrum-Agile methodology is employed with the Laravel model view controller (MVC) framework for both frontend and backend services. Results show user's interface flexibility for ease of business engagements. The audience at a Stakeholder forum Demo in Nigeria expressed a desire to use the WM-HAS App once it goes live.},
  keywords={Waste management;Costs;Government;User interfaces;Hazards;Recycling;Stakeholders;Sustainable Waste Management;Stakeholder Inclusion;WM-HAS App;Waste Ads;IoT display;and Eyewitness interface},
  doi={10.1109/NIGERCON54645.2022.9803069},
  ISSN={2377-2697},
  month={April},}@INPROCEEDINGS{11589575,
  author={Moses, Williams Adebayo and Ogbuozobe, Onyeka G. and O, Olusanya Olamide and O, Igbinosa Godwin},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={A Comparative Review of Artificial Intelligence Based System for Electricity Theft Detection and Research Outlook}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Electricity theft is a significant contributor of nontechnical losses that undermine energy security, deter investment and overloads weak power systems resulting in over ${\$}$96 billion of losses annually globally. Theft is also rife despite prepaid and smart meters in Nigeria and in Lagos State, meter bypass and illegal tapping is widespread in the state. This paper summarizes the statistical, machine learning (ML), deep learning (DL), hybrid, and adaptive models of electricity theft detection using the PRISMA framework to review more than 150 studies (2014-2024) according to their accuracy, scalability, and their application in practice. Statistical algorithms had an accuracy of 60-75% whereas more developed DL models were above 98% in controlled conditions but in the real world, poor data, poor infrastructure and evolving theft methods are the challenges. The hybrid CNN-LSTM models were very promising and explainable $A I$ and adaptive systems were critical to the practical implementation. Significant areas of weakness are that it lacks standardized datasets, flexibility to new theft patterns, large rates of false positives, and poor socioeconomic integration. The review is oriented to lightweight, adaptive, and context-aware solutions of sustainable electricity theft detection.},
  keywords={Signal detection;Electricity;Modeling;Printing;Reviews;Artificial intelligence;Machine learning;Energy;Deep learning;Machining;Electricity theft;non-technical losses (NTLs);Smart meters;Machine learning;Deep learning;Adaptive learning;Explainable AI (XAI);Nigeria;Systematic review;PRISMA},
  doi={10.1109/CTUS-EMEA68989.2025.11589575},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{6969437,
  author={Duan, Xiaohui and Zhao, Kun and Liu, Weiguo},
  booktitle={2014 IEEE International Parallel & Distributed Processing Symposium Workshops}, 
  title={HiPGA: A High Performance Genome Assembler for Short Read Sequence Data}, 
  year={2014},
  volume={},
  number={},
  pages={576-584},
  abstract={Emerging next-generation sequencing technologies have opened up exciting new opportunities for genome sequencing by generating read data with a massive throughput. However, the generated reads are significantly shorter compared to the traditional Sanger shotgun sequencing method. This poses challenges for de novo assembly algorithms in terms of both accuracy and efficiency. And due to the continuing explosive growth of short read databases, there is a high demand to accelerate the often repeated long-runtime assembly task. In this paper, we present a scalable parallel algorithm - HiPGA to accelerate the de Bruijn graph-based genome assembly for high-throughput short read data. In order to make full use of the compute power of both shared-memory multi-core CPUs and distributed-memory systems, we have used a parallelized file I/O scheme as well as a hybrid parallelism for the whole assembly pipeline. Evaluations using three real paired-end datasets and the Yoruba individual dataset show that compared to two other well parallelized assemblers: ABySS and PASHA, HiPGA achieves speedups up to 7 while delivering comparable accuracy on 64 CPU cores of a compute cluster.},
  keywords={Assembly;Genomics;Bioinformatics;Vectors;Pipelines;Parallel processing;Couplings;Genome Assembly;de Bruijn Graph;Short Read Data;MPI;Multi-threading},
  doi={10.1109/IPDPSW.2014.68},
  ISSN={},
  month={May},}@INPROCEEDINGS{11592103,
  author={Lawal, Samuel Oluwaseun and Onifade, Taiwo A. and Ajewole, Joshua Boluwatife and Ogunlola, Kayode Akinwale and Ogundipe, Olorunshogo Benjamin and Abolarinwa, Bamgbola O. and Alao, Paul Opeyemi and Dada, Jacob Babatunde and Odunoluwa, Adetayo O.},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={A Metropolitan Analysis of Power Line Telecommunication}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This study presents the analysis of power line telecommunication (PLT) systems in a metropolis of Kwara State, Nigeria. Moreover, the technological framework of PLT in the area is expounded. The significance and synopsis of the Home Plug standards associated with PLT is specified. This research demonstrates that the narrowband PLT systems are evidenced in the studied area; however, epileptic communication systems are experienced. Moreover, how the existing PLT can be improved is also analysed. Broadband PLT technologies are recommended, and a beacon/h Orthogonal Frequency Division Multiplexing was suggested to be introduced in the metropolis for fast data transfer. This is a range of frequencies for every channel depicting the standard signalling frequency channel.},
  keywords={Telecommunications;Printing;Frequency;Distance measurement;Modeling;Narrowband;Noise;Media Access Control;Technology;Timing;telecommunication system;technology;power line;standards;home plug;narrowband;broadband;OFDM},
  doi={10.1109/CTUS-EMEA68989.2025.11592103},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11592245,
  author={Gbenga, Bolarinwa J. W. and Oluwaseun, Bamido A. and Nosagieagbon, Imarhiagbe O. and Obiora, Gerard N. and Godwin, Igbinosa O.},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Power and Energy Engineering Leveraging IoT Sensors and Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Nigeria’s intrinsic energy problems of power systems inefficiencies, wasteful grid use, energy theft, and geometrically growing trends of loads and associated demands have remained unreasonably sustained. The implementation of Internet of Things (IoT) technology in the power and energy sectors has now become a significant, edgecutting innovation for efficiency, automation, and real-time decision-making. This article explains how IoT sensors, networks, and edge-cloud architecture revolutionize conventional energy monitoring and control systems. Based on the literature review study design, the article draws on evidence from peer-reviewed journals published between 2018 and 2025, as well as new case studies. Latency, energy efficiency, fault detection accuracy, cost, and drivers of communication reliability are compared, for comparison purposes, with IoT solutions and traditional systems, whose results support performance improvements. Message Queuing Telemetry Transport (MQTT) - and Narrowband Internet of Things (NB-IoT-based IoT deployments) reduced latency from 850 ms to 490 ms and achieved 94% peak accuracy in anomaly detection. Low-cost hardware like ESP32 microcontrollers and open-source software enabled low-cost scalability. The reliability of communication was more than 95 percent with MQTT and LoRaWAN. Such architecture effectiveness and economic viability of such systems are proven and compared. The research establishes that the IoT-based energy systems are not only better than the traditional systems but also provide feasible guidelines towards the modernization of the smart grid. The paper ends with a recommendation to widen the application of IoT in the energy infrastructure, considering its capability to provide intelligent, automated, and reliable energy management plans. Among the deliverables in the successful and more successful optimization of renewable energy resources, which we must draw on to achieve a reasonable degree of infrastructural development where needed, are reliability and sustainability.},
  keywords={Internet of Things;Energy;Image sensors;Printing;Smart grids;Real-time systems;Timing;Monitoring;Costing;Costs;Internet of Things (IoT);Smart Energy Systems;Edge Computing;Energy Monitoring and Control;MQTT /LoRaWAN / NB-IoT;Power System Automation;Smart Grid Architecture},
  doi={10.1109/CTUS-EMEA68989.2025.11592245},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9766818,
  author={Sanusi, Ismaila Temitayo and Olaleye, Sunday Adewale},
  booktitle={2022 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={An Insight into Cultural Competence and Ethics in K-12 Artificial Intelligence Education}, 
  year={2022},
  volume={},
  number={},
  pages={790-794},
  abstract={As artificial intelligence education (AI) continues to be integrated into the mainstream educational system across countries, cultural competence and ethical considerations should be emphasized to ensure effective AI learning. Literatures has established that integrating elements of cultural competence within technology mediums has helped students understand difficult topics from computer science concepts learned in class. It is also argued that student with an ethical orientation of AI education is more likely to learn more about impacts and implications of AI. Hence, this study was conducted to understand how students’ cultural competence, and ethics combine to influence AI content. We surveyed Nigerian high school students after an experimental teaching session. A total of 596 students provided useful responses for the analysis that was done using WarpLS software. We performed structural equation modelling to understand the relationship among the variables utilized in the study. The result shows that cultural competence and ethics significantly influence AI content. This study’s results further shows that the association between ethics of AI and AI content has the highest predictive value which emphases the vital role of ethics in AI learning. This study also tested school location differences in the research model and discovered that urban students’ perception is higher than their rural counterpart on the adopted variables in relation to AI content. Overall, the results suggest that stakeholders and educators should emphasize cultural elements and humanistic thinking as well as ethical considerations in the design of AI content and instructional materials. We discuss the findings and propose future directions.},
  keywords={Computer science;Ethics;Conferences;Learning (artificial intelligence);Mathematical models;Software;Cultural differences;AI education;high school;cultural competence;ethics;Africa},
  doi={10.1109/EDUCON52537.2022.9766818},
  ISSN={2165-9567},
  month={March},}@INPROCEEDINGS{7920662,
  author={Kolajo, Taiwo and Daramola, Olawande},
  booktitle={2017 Conference on Information Communication Technology and Society (ICTAS)}, 
  title={Leveraging big data to combat terrorism in developing countries}, 
  year={2017},
  volume={},
  number={},
  pages={1-6},
  abstract={Terrorism is a matter of great concern in many nations because of its impact on sustainable development, which is critical for developing countries. Efforts on the part of security agencies need to stay a step ahead of threats of terrorism to effectively prevent their occurrence. Many research efforts that sought to combat terrorism using big data have been reported in the literature. However, most of them have targeted data from only one type of social media per time. This paper proposes a model that harnesses data from multiple social media sources in order to detect terrorist activities by using Apache Spark technology for implementation. This paper describes the Social Media Analysis for Combating Terrorism (SMACT) model as a plausible approach that leverages Big Data analytics to address terrorism problems in developing nations. SMACT is further illustrated by a practical use case from the Nigerian context in order to depict its viability as a potential panacea for handling terrorism threats.},
  keywords={Terrorism;Big data;Media;Sparks;Distributed databases;Data models;Terrorism;Big Data;Developing Countries;Apache Spark;Social Media Feeds},
  doi={10.1109/ICTAS.2017.7920662},
  ISSN={},
  month={March},}@INPROCEEDINGS{11633287,
  author={Tijjani, Aminu and Nyoungue, Aime and Hajej, Zied},
  booktitle={2026 6th International Conference on Electrical, Computer and Energy Technologies (ICECET)}, 
  title={Degradation-Aware MPC for Lifecycle Cost Optimisation of Hybrid Solar–Wind Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Hybrid solar-wind energy systems are increasingly deployed to increase renewable penetration, yet component degradation and stochastic operational uncertainties constrain their long-term economic viability. This paper proposes a degradation-aware optimisation framework that integrates ANN-based power forecasting, virtual-age-based reliability modelling, and Model Predictive Control (MPC). Unlike traditional decoupled approaches, the framework introduces a control-aware virtual-age formulation that explicitly couples operational dispatch decisions with component wear rates. We formulate a joint MPC optimisation to co-optimise power dispatch and preventive maintenance scheduling over a $\mathbf{6 0}$-month horizon, incorporating a Monte Carlo robustness layer to propagate stochastic weather and parameter uncertainties. Numerical results for a Nigerian hybrid solar-wind case study demonstrate that the framework achieves a total lifecycle cost of approximately $\$ 403,000$ at an optimal maintenance frequency $(\mathbf{N}=\mathbf{6})$. Compared with reactive baselines, the proposed approach significantly reduces cost variance and enhances system reliability, providing a computationally tractable solution for practical asset management in hybrid renewable applications.},
  keywords={Modeling;Costing;Costs;Optimization;Aging;Degradation;Maintenance;Equations;Energy;Printing;Hybrid renewable energy systems;Model predictive control;Monte Carlo simulation;Preventive maintenance optimisation;Reliability modelling;Virtual age degradation},
  doi={10.1109/ICECET65726.2026.11633287},
  ISSN={},
  month={July},}@INPROCEEDINGS{11592300,
  author={Alabi, Oluwadamilola and Alabi, Adewale and Rahmon, Saheed and Olaolorun, Ayomide and Ipuole, Prosper and Ekundayo, Opeyemi and Udomeh, Tochukwu and Izala, Nathaniel},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Relationship Between University Environment and Mental Health among Students: A Quantitative Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={University campuses are consequential socio-physical settings for student wellbeing, yet evidence linking specific campus design, social and institutional features to mental health in private universities remains limited. This crosssectional quantitative study surveyed 294 resident undergraduates at a private Nigerian university using validated instruments that measured perceptions of the physical (PHY), social (SOC), and institutional (INS) environment, perceived Person-environment (P-E) fit, and dual-continuum mental-health outcomes (flourishing and symptom scales). Item-level means highlighted strengths (visible green space, outdoor safety, family support) alongside concerns (hostel ventilation, noise, loneliness, and heavy academic workload). Bivariate analyses showed meaningful associations between environmental domains and mentalhealth indicators, with planned multivariate models as specified to test direct and mediated pathways via perceived fit, with sociodemographic moderators. Multivariate regression models, controlling for sociodemographic, identified the institutional domain ($\beta=-0.32, \mathrm{p}$ &lt;.01) as the strongest independent predictor of negative mental health outcomes, while the physical environment was a significant predictor of flourishing ($\beta=0.24$, p &It;.05). The findings underscore practicable entry points for architects, campus planners, and university managers, such as improving indoor environmental quality, expanding restorative green space, creating decentralized student hubs, and reviewing assessment scheduling and counselling provision, to support student wellbeing. Future longitudinal, multi-site, and objective environmental studies are recommended to strengthen causal inference and generalisability.},
  keywords={Mental health;Educational institutions;Modeling;Printing;Reviews;Employee welfare;Feed in tariff;Fitting;Human factors;Stress;Campus environment;Student mental health;Built environment;Person-Environment (P-E) fit;University policy;Nigeria},
  doi={10.1109/CTUS-EMEA68989.2025.11592300},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{7942965,
  author={Dele-Ajayi, Opeyemi and Strachan, Rebecca and Sanderson, Jonathan and Pickard, Alison},
  booktitle={2017 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={A modified TAM for predicting acceptance of digital educational games by teachers}, 
  year={2017},
  volume={},
  number={},
  pages={961-968},
  abstract={The use of digital games in education is growing. Digital games with their elements of `play' and `challenge' are increasingly viewed as a successful medium for engaging and motivating students, in situations where students may be uninterested or distant. One such situation is mathematics education in Nigeria where young people in schools can be unenthusiastic about the subject. The introduction of digital educational games is being trialed to see if it can address this issue. A key element for ensuring the success of the introduction of new technologies is that the users are prepared and ready to accept the technology. This also applies to the introduction of digital educational games in the classroom. Technology Acceptance Models (TAMs) have been widely employed to explore users' attitudes to technology and to highlight their main concerns and issues. The aim of this study is to investigate if a modified TAM can be successfully developed and deployed to explore teachers' attitudes to the introduction of digital educational games in their classroom. The study employs a mixed methods approach and combines the outcomes from previous research studies with data gathered from interviews with teachers to develop the modified TAM. This approach of combining the results from previous studies together with interviews from the targeted group enabled the key variables/constructs to be identified. Independent evaluation by a group of experts gave further confidence in the model. The results have shown that this modified TAM is a useful instrument for exploring the attitude of teachers to using digital games for learning and teaching, and highlighting the key areas which require support and input to ensure teachers are ready to accept and use this technology in their classroom practice.},
  keywords={Games;Interviews;Mathematics;Bibliographies;Engineering education;Conferences;technology acceptance model;technology enhanced learning;digtal classroom;educational game;mathematics;digital literacy;teacher support;teacher attitude},
  doi={10.1109/EDUCON.2017.7942965},
  ISSN={2165-9567},
  month={April},}@INPROCEEDINGS{9570906,
  author={Lusinga, Moses and Mokoena, Tshepiso and Modupe, Abiodun and Mariate, Vukosi},
  booktitle={2021 IEEE AFRICON}, 
  title={Investigating Statistical and Machine Learning Techniques to Improve the Credit Approval Process in Developing Countries}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={The implementation of machine learning models that lie at the heart of traditional financial institutions like banks has primarily remained a "black box". Techniques such as extreme gradient boosting, random forest and support vector machines are challenging to interpret. This restricts the commercial application of these techniques as they lack transparency and often hide potential biases inherited by the machine learning algorithms. Ultimately, this further limits the ability of these techniques to assess an individual’s ability to pay for a loan. The biases lead to credit applications being rejected or individuals being offered "unfair" credit terms based on their credit risk. Recently there have been attempts to predict credit default risk in literature. However, the majority of studies are conducted using data from developed countries, where most individuals are banked and data is complete. Therefore, this study aims to investigate and compare statistical classification techniques and machine learning techniques, with the focus being on interpreting the results and explaining which features contribute to the credit approval processes that may excel in both developed and developing countries. To achieve this goal, we explored three datasets from FinTech organisations, namely Home Credit, Xente, and Super Lender. Two of the datasets are from Uganda and Nigeria (developing countries in Africa) and one from the USA (a developed country in North America). We adopted Shapley Additive exPlanation (SHAP) to interpret the models. Using SHAP, we identified that for all three datasets, the external ratings, total due and loan duration increase the likelihood of an individual defaulting on a loan. Additionally, we also found that the tree-based algorithms, particularly the extreme gradient boosting algorithm outperforms logistic regression, random forest and other statistical learning techniques.},
  keywords={Support vector machines;Analytical models;Machine learning algorithms;Additives;Finance;Africa;Developing countries;machine learning;interpretability;finance;credit risk;financial technology;developing countries},
  doi={10.1109/AFRICON51333.2021.9570906},
  ISSN={2153-0033},
  month={Sep.},}@ARTICLE{9047907,
  author={Dogara, Gimba and Kamin, Yusri Bin and Saud, Muhammad Sukri Bin},
  journal={IEEE Access}, 
  title={The Impact of Assessment Techniques on the Relationship Between Work-Based Learning and Teamwork Skills Development}, 
  year={2020},
  volume={8},
  number={},
  pages={59715-59722},
  abstract={The purpose of this study was to investigate the mediating effect of assessment techniques on the relationship between work-based learning and teamwork skills development at technical colleges in Nigeria. The sample consists of 257 technical teachers. The CFA models were developed to obtain the Chi-square values, modification indices, and standardized estimates using AMOS. Structural Equation Modeling (SEM), employing AMOS version 22 was utilized to test the mediation effect and also the relationship between work-based learning and teamwork skills development among students of technical colleges. The findings of the study revealed that work-based learning has a direct significant negative relationship with teamwork skills development among students of technical colleges, while, it has a direct insignificant positive relationship with assessment techniques. However, when the mediation hypothesis was tested, the result indicates that assessment techniques have a significant positive indirect impact on teamwork skills development, that is, it fully mediates the relationship between work-based learning and teamwork skills development among students of technical colleges. This study implies to educators that there is a need to appropriately enforce the assessment techniques for effective development of teamwork skills among TVET students. It is therefore, confirmed that teamwork skills should be enhanced when work-based learning is used in collaboration with appropriate assessment techniques.},
  keywords={Teamwork;Mathematical model;Mediation;Training;Numerical analysis;Assessment techniques;structural equation modeling;work-based learning;teamwork skills development},
  doi={10.1109/ACCESS.2020.2983487},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{6713668,
  author={Larsen, Raymond S. and Podmore, Robin and Lacourciere, Michelle and Ryan, Patrick and Welbourn, Derek G. and Wessner, Daniel},
  booktitle={2013 IEEE Global Humanitarian Technology Conference (GHTC)}, 
  title={The CSI story: IEEE PES Community Solutions Initiative}, 
  year={2013},
  volume={},
  number={},
  pages={129-134},
  abstract={The IEEE PES Community Solutions Initiative is dedicated to helping IEEE reach the Humanitarian Technology Challenge (HTC) -United Nations (UN) goal of achieving a major impact in global poverty reduction of which energy poverty is a major factor. The CSI vision emulates the goals of many like-minded groups of building bottom-up community prosperity through training and empowering local entrepreneurs to manage profitable businesses capable of growing to serve a million people in the first 5 years of operation. A successful business and technology model has been demonstrated at a seed funding level in Haiti and now is striving to attract further investment from both aid agencies and Social investment venture capitalists to expand marketing and production to full scale. The first initiative in Haiti is now three years old and new initiatives in Nigeria, Cameroon and South Sudan started in July 2012. In addition, CSI with a growing list of partners is dedicated to leveraging basic electricity to support a variety of uses including interconnectivity and interactive web-based affordable education at many levels in off-grid areas. Further incubation of technology, business and education models is also being pursued in collaboration with sustainable development NGOs committed to enabling the 1.4 billion at the economic Base of the Pyramid (BOP).},
  keywords={Batteries;Communities;Electricity;Training;Generators;Investment},
  doi={10.1109/GHTC.2013.6713668},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10578171,
  author={Setyawan, Nanang Hari and Sulistyo, Selo and Hartanto, Rudy},
  booktitle={2024 International Conference on Smart Computing, IoT and Machine Learning (SIML)}, 
  title={A Review E-Government Implementation: Its Impact on Public Value Creation and Citizen Perspectives}, 
  year={2024},
  volume={},
  number={},
  pages={137-144},
  abstract={The global expansion of e-government services reflects the rising demand for efficient government services among digital citizens. Governments must prioritize understanding public perspectives and values for effective citizen-centric e-government, involving all stakeholders for sustainable development and utilizing innovative technologies to overcome challenges. This systematic literature review (SLR) aims to explore citizen-centric e-government implementation worldwide, focusing on its impact on public value creation and citizen perception. By analyzing 69 papers from 2017 to 2023 using the PRISMA method, the review revealed diverse research landscapes and highlighted the importance of inclusive services. Key variables such as Information Quality, System Quality, and Trust in e-government significantly influenced citizen attitudes. Behavioral Intention to Use, Citizen Satisfaction, and Public Value emerged as prominent dependent variables. Notable countries like China, India, Nigeria, and Pakistan were extensively studied, employing various analytical techniques like Structural Equation Modeling (SEM) and thematic analysis. Frameworks such as UTAUT, TAM, and IS Success Model were commonly used, reflecting the multifaceted nature of e-government research and the need for comprehensive approaches.},
  keywords={Data analysis;Systematics;Reviews;Numerical analysis;Smart cities;Focusing;Mathematical models;public perspectives;e-government;public value;framework;citizen perception},
  doi={10.1109/SIML61815.2024.10578171},
  ISSN={},
  month={June},}@INPROCEEDINGS{8281897,
  author={Ebhota, Virginia Chika and Isabona, Joseph and Srivastava, Viranjay M.},
  booktitle={2017 IEEE 3rd International Conference on Electro-Technology for National Development (NIGERCON)}, 
  title={Signal power loss prediction based on artificial neural networks in microcell environment}, 
  year={2017},
  volume={},
  number={},
  pages={250-257},
  abstract={In a bid to predict the propagation loss of electromagnetic signals, different models based on empirical and deterministic formulas have been used. In this study, different artificial neural network models which are very effective for prediction were used for the prediction of signal power loss in a microcell environment, Obio-Akpor, Port Harcourt, Nigeria. The signal power loss of the area is studied based on three artificial neural network algorithms with nine training functions. For the training of the artificial neural network, the input data were the distance from the transmitter and the signal power loss. Training of neural network is a demanding task in the field of supervised learning research. This is because the main difficulty in adopting artificial neural network is in finding the most suitable combination of learning and training functions for the prediction task. We compared the performance of three training algorithms in feedforward back propagation multi layer perceptron neural network. Nine training functions under three training algorithms were selected: the Gradient descent based algorithms, the Conjugate gradient based algorithms and the Quasi-Newton based algorithms. The work compared the training algorithms on the basis of mean square error, mean absolute error, standard deviation, correlation coefficient, regression on training and validation and the rate of convergence. The general performance of the training functions demonstrates their effectiveness to yield accurate results in short time. The conclusion on the training functions is based on the simulation results using measurement data from the micro environment.},
  keywords={Training;Artificial neural networks;Prediction algorithms;Predictive models;Algorithm design and analysis;Neurons;Computational modeling;Artificial Neural Network;Muti layer perceptron neural network;Gradient descent algorithms;Conjugate gradient algorithms;Quasi-Newton algorithms},
  doi={10.1109/NIGERCON.2017.8281897},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{10731020,
  author={Sani, Nura Muhammad and Satpute, Reena S.},
  booktitle={2024 IEEE 3rd World Conference on Applied Intelligence and Computing (AIC)}, 
  title={Review on Snake Species Identification on Snake Bite Marks using Deep Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1075-1079},
  abstract={Snakebite incidents pose significant public health challenges, particularly in regions like Kaltungo, Nigeria, where identifying the snake species responsible for bites is crucial for administering proper treatment. Traditional methods relying on verbal descriptions or blood sample analysis are often inaccurate or impractical. Leveraging deep learning techniques, particularly Convolutional Neural Networks (CNNs), offers a promising solution for automated snake species identification from snake bite marks. This review explores the application of CNNs and Siamese Network Models for this purpose, emphasizing the need for improved datasets, model interpretability, and validation methods. The proposed methodology combines CNNs for initial feature extraction and classification with Siamese Networks for refining classification through image comparisons. By addressing challenges such as limited datasets and variable snake characteristics, this approach aims to enhance the accuracy and efficiency of snake species identification, thereby facilitating timely medical responses and ecological monitoring.},
  keywords={Deep learning;Training;Accuracy;Reviews;Biological system modeling;Computational modeling;Neural networks;Data models;Robustness;Convolutional neural networks;Deep Learning;convolutional neural network (CNN);Siamese Network Model;Snake Bite Marks},
  doi={10.1109/AIC61668.2024.10731020},
  ISSN={},
  month={July},}@INPROCEEDINGS{11058596,
  author={Odedeyi, Temitope and Kolawole, Olalekan and Ugoji, Chike and Ayankanmi, Toye and Okhuoya, Oziegbe and Rabbit, Ismail and Asante, Kwaku Onwona-Hwesofour and Darwazeh, Izzat},
  booktitle={2025 IEEE International Conference on Smart Computing (SMARTCOMP)}, 
  title={Multi-Source Data Integration and IoT-Based Sensing for Crop Yield Modelling and Optimisation}, 
  year={2025},
  volume={},
  number={},
  pages={294-299},
  abstract={This paper presents the development and implementation of an IoT-enabled environmental sensing system designed for crop yield modelling and optimisation across diverse agro-ecological zones in Nigeria. The system integrates in-situ soil and atmospheric sensors, drone-based observations, and farm-level data using a multi-layered communication architecture, including cellular, Long Range Wide Area Network (LoRaWAN), and novel UAV-based mesh networks. Preliminary analysis of the collected data reveals strong correlations between cassava fresh yield and environmental factors such as soil water content, temperature, and electrical conductivity. The system demonstrates the potential of data-driven approaches to inform site-specific agronomic decisions and breeding strategies. While the system is still in the early phase of data collection, future work will involve expanded data integration, AI-based predictive modelling, and enhanced decision support for climate-smart agriculture.},
  keywords={Cloud computing;Computational modeling;Data integration;Soil;Predictive models;Data collection;Real-time systems;Sensors;Optimization;Crop yield;Precision agriculture;Climate-smart agriculture;Crop yield modelling;Environmental monitoring;IoT;Sensor networks;Cloud analytics},
  doi={10.1109/SMARTCOMP65954.2025.00094},
  ISSN={2693-8340},
  month={June},}@INPROCEEDINGS{7449474,
  author={Sanusi, Usman and Corne, David},
  booktitle={2015 IEEE 8th International Workshop on Computational Intelligence and Applications (IWCIA)}, 
  title={Feature selection for accurate short-term forecasting of local wind-speed}, 
  year={2015},
  volume={},
  number={},
  pages={121-126},
  abstract={There is increasing demand for accurate short-term forecasting of weather conditions at specified locations. This demand arises partly from the growing numbers of renewable energy facilities. In order successfully to integrate renewable energy supplies with grid sources, the short term (e.g. next 24 hrs) output profile of the renewable system needs to be forecast as accurately as possible, to avoid over-reliance on fossil fuels at times when renewables are available, and to avoid deficit in supply when they aren't. In particular, the inherent variability in wind-speed poses an additional challenge. Several approaches for wind-speed forecasting have previously been developed, ranging from simple time series analysis to the use of a combination of global weather forecasting, computational fluid dynamics and machine learning methods. For localized forecasting, statistical methods that rely on historical location data come to the forefront. Recent such work (building localized forecast models with multivariate linear regression) has found that accuracy can gain significantly by learning from multiple types of local weather features. Here, we build on that work by investigating the potential benefits of simple additional `derived' features, such as the gradient in wind-speed or other variables. Following extensive experimentation using data from sites in Nigeria (primarily), Scotland and Italy, we conclude that the ideal forecasting model for a given location will use a judicious combination of direct and derived features.},
  keywords={Forecasting;Predictive models;Weather forecasting;Renewable energy sources;Context;Learning systems;forecasting;prediction;renewables;regression;feature selection;feature derivation},
  doi={10.1109/IWCIA.2015.7449474},
  ISSN={1883-3977},
  month={Nov},}@INPROCEEDINGS{10390090,
  author={Mohamed, Aezeden and Goru, Donovan and David, Japheth and Liet, Zachariah},
  booktitle={2023 3rd International Conference on Technological Advancements in Computational Sciences (ICTACS)}, 
  title={Convolutional Neural Network Based Intelligent Methods for Early Detection of Groundnut Leaf Spot}, 
  year={2023},
  volume={},
  number={},
  pages={219-226},
  abstract={After China, the United States, and Nigeria, India is the leading producer of groundnuts and oil. On 20,000 acres, Konkan groundnut yields 1,800 kg ha-1. Konkan has an abundance of groundnuts. Leaf spots are the most influential biotic factors on groundnut yield and quality. Depending on the timing and conditions, both leaf marks can result in losses exceeding fifty percent. This disease inhibits photosynthesis by causing leaflet abscission and severe defoliation [2]. Image processing methods based on artificial neural networks, back propagation neural networks, support vector machines, and other methods. Convolutional Neural Network (CNN) and Artificial Neural Network (ANN) models are most frequently used for plant disease diagnosis in agriculture due to their superior computation and precision [3]. Utilizing convolutional neural networks and artificial neural networks, a disease detection model for groundnut early leaf spot caused by Cercospora arachidicola will be developed.},
  keywords={Support vector machines;Backpropagation;Plant diseases;Computational modeling;Biological system modeling;Oils;Image processing;Convolutional Neural network;Artificial Neural network;machines learning;Mobiroller;Multiplayer Perceptron;Conjugate Descent gradient},
  doi={10.1109/ICTACS59847.2023.10390090},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{8281970,
  author={Idrissa, Adamu and Nwazor, Nkolika O.},
  booktitle={2017 IEEE 3rd International Conference on Electro-Technology for National Development (NIGERCON)}, 
  title={Optimisation of energy management in a process industry: A case study}, 
  year={2017},
  volume={},
  number={},
  pages={1075-1082},
  abstract={This work is on the optimization of energy management in a process industry using Port Harcourt Refining Company, PHRC, and Nigeria as a case study. Every industry requires efficient energy management to perform optimally. PHRC has sufficient energy supply but is facing the challenge of high energy consumptions resulting in high production costs. Specifying the impact factor of composite variables in a production process is important for efficient energy management. Mathematical models for predicting the yearly energy consumption of the company was developed using multiple regression and validated. The model in conjunction with Cumulative Sum, CUSUM analysis was used to specify the contributions of each petroleum product to the energy consumption of the company. Coke (petroleum product) had the highest contribution notwithstanding the fact that its energy consumption was the least in the company's data. Therefore to optimize energy management and reduce utility bill, its production should be reduced.},
  keywords={Energy management;Energy consumption;Production;Companies;Mathematical model;Raw materials;Optimization;Optimization;Energy Management;Models;CUSUM analysis;Port Harcourt Refining Company (PHRC)},
  doi={10.1109/NIGERCON.2017.8281970},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{8281913,
  author={Gambo, Ishaya and Ikono, Rhoda and Adeoni, Olusegun and Ogundare, Timilehin},
  booktitle={2017 IEEE 3rd International Conference on Electro-Technology for National Development (NIGERCON)}, 
  title={Ensuring quality web based seaport billing system through an engineering process: A case study}, 
  year={2017},
  volume={},
  number={},
  pages={443-450},
  abstract={This study formulated a framework for implementing a web based seaport billing system to assist seaport customers in preparing and processing their bills at the seaport with ease and to make their records save and easy to retrieve. The research employed qualitative research approaches. Requirements were elicited from billing and accounting department of the Apapa seaport, Nigeria using interview, observation and content analysis as secondary data. The model was specified in Unified Modelling Language, and the system was implemented using HTML 5, hypertext pre-processor (PHP), Cascading style sheet and JavaScript. The result of this is the seaport billing system where different bills pertaining to clearing of cargo at the seaport are raised, and customers records are retrieved and used for further processing. Also, the results provided a module where the administrator of the system will be able to view details of customers, generate a report based on weekly, monthly, or quarterly basis, thereby, assisting them to observe the trending pattern in terms of queue and time of bill processing as compared to the manual mode of bill processing. The result also showed a graph of weekly transaction report indicating which day of the week attracts business, and a two years quarterly billing report indicating the period the seaports actually experience the highest transaction for quality decision making. It is expected that the prototype system system implemented will help determine and evaluate a progression or retrogression in the billing activity in the seaport. Thus, the billing and accounting department of the seaport can send a well detailed and precise report of the billing activity of the seaport to higher authority.},
  keywords={Computer science;Tools;Conferences;Manuals;Decision making;Personnel;Software;Seaport billing system;engineering process;database;design specification;requirements engineering;QoPS},
  doi={10.1109/NIGERCON.2017.8281913},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{5753010,
  author={Tiihonen, Tuija and Luukkonen, Irmeli and Korpela, Mikko},
  booktitle={2010 IST-Africa}, 
  title={Modelling the context of information systems}, 
  year={2010},
  volume={},
  number={},
  pages={1-10},
  abstract={Information systems are socio-technical systems consisting of people, processes, information and technology. For successfully developing information systems for organizations, the whole context where the system is to be used has to be recognized and understood as well as possible. This is particularly pertinent when developing information systems in developing countries (DCs), and even more so when the systems developers come from a widely different context. Most commonly used information systems development (ISD) approaches and methods do not facilitate achieving the understanding of issues belonging to the wider scope, the context of information systems. In this paper we present the LACASA (Levels of Analysis, Scopes of Analysis, and Categories of Analysis) model which attempts to cover the areas of contexts which are the most important in “doing ISD in DCs”. The procedure of applying the model is described in general and illustrated by a case between Finland and Nigeria.},
  keywords={Context;Information systems;Organizations;Context modeling;Biological system modeling;Analytical models;Modelling;Information Systems;Context},
  doi={},
  ISSN={},
  month={May},}@INPROCEEDINGS{11652198,
  author={Muneer, Gamal and Mohammed, Osamah S. and Mohammed, Osaid S.},
  booktitle={2026 6th International Conference on Emerging Smart Technologies and Applications (eSmarTA)}, 
  title={Comparative Evaluation of Machine Learning Models for Pluvial Flood Susceptibility Assessment: A Case Study of Ibadan}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Pluvial flooding is a major urban hazard that occurs when intense rainfall exceeds the capacity of drainage systems, leading to surface water accumulation and disruption to urban activities. This paper examines pluvial flood susceptibility in Ibadan metropolis, Nigeria, using GIS-based data and a machine learning approach to evaluate flood risk levels. The study classifies flood susceptibility into five categories: Very High, High, Moderate, Low, and No Flood, based on flood-conditioning factors related to location, terrain, runoff behavior, drainage conditions, and rainfall. The data were divided into 80% for training and 20% for testing, and multiple machine learning models were evaluated within a consistent experimental framework using accuracy, macro and weighted precision, recall, F1-score, and confusion matrix analysis. The results show that all models achieved strong predictive performance, with Random Forest achieving the highest accuracy of 97.76% and the most consistent performance across classes. Most classification errors occurred between adjacent categories, such as Very High and High, indicating that uncertainty is mainly concentrated near class boundaries. This pattern reflects the gradual transition of environmental conditions, where neighboring susceptibility classes may share similar characteristics. The resulting five-class flood susceptibility map provides a practical tool for supporting drainage management, urban planning, and emergency preparedness in flood-prone areas.},
  keywords={Floods;Machine learning;Modeling;Machining;Printing;Equations;Geographic information systems;Random forests;Accuracy;Urban areas;Pluvial flooding;flood susceptibility mapping;geographic information systems (GIS);machine learning;urban flood risk},
  doi={10.1109/eSmarTA70636.2026.11652198},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11592237,
  author={Olawoye, B. O. and Onifade, M. K. and Fiemobebefa, C. B. and Obiora, G. N. and Olabisi, P. O. and Igbinosa, G. O.},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Performance Evaluation of FM Radio Signal Propagation in Multipath and Terrain-challenged Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This study evaluates the performance of FM radio signals in multipath and ter-rain-challenged environments in Nigeria. The study adopted drive field measurements for received signal strength in Ikorodu Lagos, characterized with varying topologies and environmental conditions using Arinst spectrum analyzer as research instrument. The data were analyzed using Longley-Rice models to evaluate path loss, diffraction, reflection, and multipath effects. The study revealed that using multipath propagation adds substantial unpredictability into FM radio performance in urban terrain, leading the received signal to deviate substantially from theoretical predictions in the urban area while in the rural, there is considerate degradation of signal due to long distance from the base of transmit-ter, vegetations and uneven surfaces. However, with Longley-Rice Model, the path loss increased logarithmically as the distance increases.},
  keywords={Modeling;Equations;Frequency modulation;Propagation;Broadcasting;Distance measurement;Printing;Transmitters;Waves;Interference;Performance evaluation of FM radio signal;multipath propagation;terrain effects;path loss analysis;signal strength measurement;broadcast coverage;Longley-Rice model},
  doi={10.1109/CTUS-EMEA68989.2025.11592237},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{7067084,
  author={da Silva, Cecilia C. and de Alcantara, Barbara Gabrielle M. and Olimpio, Julio Cesar S. and de Gusmao, Cristine M. G. and da Silva Filho, Abel G. and dos Santos, Wellington P.},
  booktitle={2014 IEEE 3nd International Conference on Serious Games and Applications for Health (SeGAH)}, 
  title={Ilera-Aiye: A virtual world for the development of serious games for health education and promotion in the Northeastern Brazilian countryside}, 
  year={2014},
  volume={},
  number={},
  pages={1-8},
  abstract={The level of basic care in Brazil's Unified Health System is a community-based attention model composed by Family Health Units, small teams of health professionals intended to solve low-complexity problems at a territory delimitated by a certain number of families, attended by Communitary Health Agents. Despite the large amount of social inequalities in Brazilian countryside, smartphones and tablets are becoming more widespread among rural population. According to Popular Education, the teaching-learning process is improved when the educator is part of the process as a facilitator, considering the prior knowledge of learners and their social, cultural and historical background, in a relationship mediated by affection, which can be reached by using games. This work proposes Ilera-Ayie (from Yoruba language, Land of Health), a virtual world to support 3D serious games for health education and promotion, focused on the communitary health agents and the young population of rural settlements at Brazil's northeastern countryside. Non-functional requirements elicitation was performed by using participatory workshops involving participants of two rural settlements at the Northern Forest region of the State of Pernambuco, northeast of Brazil. Taking into account Popular Education and Participatory Design as theoretical backgrounds, design elements of the virtual world were defined using participatory workshops, considering identity aspects of communities, such as the local vegetation, animals, houses, historic buildings of the Brazil's Empire age of slavery, and musical elements, trying to make a link between local and universal cultural elements.},
  keywords={Education;Games;Communities;Conferences;Cultural differences;Context;Three-dimensional displays},
  doi={10.1109/SeGAH.2014.7067084},
  ISSN={},
  month={May},}@INPROCEEDINGS{9627311,
  author={Bukar, Abba Lawan and Tan, Chee Wei and Lau, Kwan Yiew and Toh, Chuen Ling and Ayop, Razman and Dahiru, Ahmed Tijjani},
  booktitle={2021 IEEE Conference on Energy Conversion (CENCON)}, 
  title={Energy Management Strategy and Capacity Planning of an Autonomous Microgrid: A Comparative Study of Metaheuristic Optimization Searching Techniques}, 
  year={2021},
  volume={},
  number={},
  pages={190-195},
  abstract={Electricity generation using renewable energy-based microgrid (REM) is a prerequisite to achieve one of the cardinal objectives of sustainable development goals. Nonetheless, the optimum design and sizing of the REM is challenging. This is because the REM needs to supply the fluctuating demand considering the sporadic behaviour of the renewable energy sources (RES). This paper, therefore, proposes a nature-inspired metaheuristic optimization searching technique (MOST) to optimize the components of an autonomous microgrid integrating a diesel generator ${\left(D_{\text{GEN}}\right)}$, battery bank, photovoltaic and wind turbine. In this regard, a cycle-charging energy management scheme (CEMS) control is proposed and implemented using a rule-based algorithm. The proposed CEMS provide a power delivery sequence for the different components of the microgrid. Subsequently, the CEMS is optimized using the metaheuristic optimization searching techniques (MOSTs). To benchmark, the paper compares the success of six different MOSTs. The simulation is performed for the climatic conditions of Yobe State, in northern Nigeria using MATLAB software. The comparative results show that the grasshopper optimization algorithm is found to yield a better result because it gives the least fitness function relative to other studied MOSTs. Remarkably, it outperforms the grey wolf optimizer, the ant lion optimizer, and the particle swarm optimization by ~ 3.0 percent, ~ 5.8 percent, and ~ 3.6 percent (equivalent to a cost savings of $8332.38, $4219.87, and $5144.64 from the target microgrid project). Results also indicate that the proposed CEMS adopted for the microgrid control strategy has led to the implementation of a clean and affordable energy system, as it's significantly minimized CO2 (by 92.3%), fuel consumption (by 92.4%), compared fossil fuel-based ${D_{\text{GEN}}}$.},
  keywords={Renewable energy sources;Metaheuristics;Software algorithms;Microgrids;Software;Wind turbines;Fuels;Metaheuristics;energy management strategy;microgrid;PV;optimal sizing;CO2},
  doi={10.1109/CENCON51869.2021.9627311},
  ISSN={},
  month={Oct},}@ARTICLE{7890429,
  author={Okeowo, Modurodoluwa Adeyinka and Lee, Hyongki and Hossain, Faisal and Getirana, Augusto},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={Automated Generation of Lakes and Reservoirs Water Elevation Changes From Satellite Radar Altimetry}, 
  year={2017},
  volume={10},
  number={8},
  pages={3465-3481},
  abstract={Limited access to in-situ water level data for lakes and reservoirs have been a major setback for regional and global studies of reservoirs, surface water storage changes, and monitoring the hydrologic cycle. Processing satellite radar altimetry data over inland water bodies on a large scale has been a cumbersome task primarily due to the removal of contaminated measurements as a result of surrounding land. In this study, we proposed a new algorithm to automatically generate time series from raw satellite radar altimetry data without user intervention. With this method, users with a little knowledge on the field can now independently process radar altimetry for diverse applications. The method is based on K-means clustering, interquartile range, and statistical analysis of the dataset for outlier detection. Jason-2 and Envisat radar altimetry data were used to demonstrate the capability of this algorithm. A total of 37 satellite crossings over 30 lakes and reservoirs located in the U.S., Brazil, and Nigeria were used based on the availability of in-situ data. We compared the results against in-situ data and root-mean-square error values ranged from 0.09 to 1.20 m. We also confirmed the potential of this algorithm over rivers and wetlands using the southern Congo River and Everglades wetlands in Florida, respectively. Finally, the different retracking algorithms in Envisat; Ice-1, Ice-2, Ocean, and Sea-Ice were compared using the proposed algorithm. Ice-1 performed best for generating water level time series for in-land water bodies and the result is consistent with previous studies.},
  keywords={Reservoirs;Lakes;Satellites;Altimetry;Time series analysis;Clustering algorithms;Lakes;outlier detection;reservoirs;satellite altimetry;water level},
  doi={10.1109/JSTARS.2017.2684081},
  ISSN={2151-1535},
  month={Aug},}@INPROCEEDINGS{9776102,
  author={Suleiman, Rahanatu and Anane, Rachid},
  booktitle={2022 IEEE 25th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={Institutional Data Analysis and Machine Learning Prediction of Student Performance}, 
  year={2022},
  volume={},
  number={},
  pages={1480-1485},
  abstract={Concern over student progression and retention is driving the systematic analysis of the vast amount of student data recorded in institutional data sets and in learning management systems (LMS) data sets. This is motivated by the belief that student analytics will help uncover patterns of behaviour and predict student performance, and thus facilitate the deployment of supportive educational interventions. This paper is concerned with the investigation of the institutional data of a Nigerian university, and the predictive impact of its attributes on student performance, measured in terms of cumulative grade point average (CGPA). The statistical analysis of the data set reveals that age and marital status have no significant relationship with final CGPA, whereas gender and pre-entry score have a weak relationship but are not good predictors. The application of four representative machine learning methods, namely linear regression, support vector regression, decision tree and random forests indicate that the third year CGPA is a good predictor of final year CGPA. A higher accuracy is achieved by using the aggregate value of the CGPAs of three previous years. Support vector regression has the best performance in predicting the final CGPA, whereas decision tree is the least performing model.},
  keywords={Support vector machines;Learning management systems;Systematics;Machine learning algorithms;Statistical analysis;Aggregates;Linear regression;machine learning;regression;student analytics;student performance;educational data},
  doi={10.1109/CSCWD54268.2022.9776102},
  ISSN={},
  month={May},}@INPROCEEDINGS{7360516,
  author={Ugwoke, F. N. and Okafor, K. C. and Chijindu, V. C.},
  booktitle={2015 International Conference on Cyberspace (CYBER-Abuja)}, 
  title={Security QoS profiling against cyber terrorism in airport network systems}, 
  year={2015},
  volume={},
  number={},
  pages={241-251},
  abstract={Attacks on airport information network services in the form of Denial of Service (DoS), Distributed DoS (DDoS), and hijacking are the most effective schemes mostly explored by cyber terrorists in the aviation industry running Mission Critical Services (MCSs). This work presents a case for Airport Information Resource Management Systems (AIRMS) which is a cloud based platform proposed for the Nigerian aviation industry. Granting that AIRMS is susceptible to DoS attacks, there is need to develop a robust counter security network model aimed at pre-empting such attacks and subsequently mitigating the vulnerability in such networks. Existing works in literature regarding cyber security DoS and other schemes have not explored embedded Stateful Packet Inspection (SPI) based on OpenFlow Application Centric Infrastructure (OACI) for securing critical network assets. As such, SPI-OACI was proposed to address the challenge of Vulnerability Bandwidth Depletion DDoS Attacks (VBDDA). A characterization of the Cisco 9000 router firewall as an embedded network device with support for Virtual DDoS protection was carried out in the AIRMS threat mitigation design. Afterwards, the mitigation procedure and the initial phase of the design with Riverbed modeler software were realized. For the security Quality of Service (QoS) profiling, the system response metrics (i.e. SPI-OACI delay, throughput and utilization) in cloud based network were analyzed only for normal traffic flows. The work concludes by offering practical suggestion for securing similar enterprise management systems running on cloud infrastructure against cyber terrorists.},
  keywords={Airports;Computer crime;Atmospheric modeling;Air traffic control;Floods;Attacks;Cloud Datacenters;DoS;DDoS;Vulnerabilities;AIRMS;Mitigation Techniques;Aviation Industry},
  doi={10.1109/CYBER-Abuja.2015.7360516},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{8835220,
  author={Joslin, Matthew and Li, Neng and Hao, Shuang and Xue, Minhui and Zhu, Haojin},
  booktitle={2019 IEEE Symposium on Security and Privacy (SP)}, 
  title={Measuring and Analyzing Search Engine Poisoning of Linguistic Collisions}, 
  year={2019},
  volume={},
  number={},
  pages={1311-1325},
  abstract={Misspelled keywords have become an appealing target in search poisoning, since they are less competitive to promote than the correct queries and account for a considerable amount of search traffic. Search engines have adopted several countermeasure strategies, e.g., Google applies automated corrections on queried keywords and returns search results of the corrected versions directly. However, a sophisticated class of attack, which we term as linguistic-collision misspelling, can evade auto-correction and poison search results. Cybercriminals target special queries where the misspelled terms are existent words, even in other languages (e.g., "idobe", a misspelling of the English word "adobe", is a legitimate word in the Nigerian language). In this paper, we perform the first large-scale analysis on linguistic-collision search poisoning attacks. In particular, we check 1.77 million misspelled search terms on Google and Baidu and analyze both English and Chinese languages, which are the top two languages used by Internet users. We leverage edit distance operations and linguistic properties to generate misspelling candidates. To more efficiently identify linguistic-collision search terms, we design a deep learning model that can improve collection rate by 2.84x compared to random sampling. Our results show that the abuse is prevalent: around 1.19% of linguistic-collision search terms on Google and Baidu have results on the first page directing to malicious websites. We also find that cybercriminals mainly target categories of gambling, drugs, and adult content. Mobile-device users disproportionately search for misspelled keywords, presumably due to small screen for input. Our work highlights this new class of search engine poisoning and provides insights to help mitigate the threat.},
  keywords={Search engines;Google;Deep learning;Toxicology;Recurrent neural networks;Linguistics;Drugs;search-engine-poisoning;recurrent-neural-network;pinyin;linguistic-collision-misspelling},
  doi={10.1109/SP.2019.00025},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{5434748,
  author={Yare, Y. and Venayagamoorthy, G. K.},
  booktitle={2010 Innovative Smart Grid Technologies (ISGT)}, 
  title={Real-time transient stability assessment of a power system during energy generation shortfall}, 
  year={2010},
  volume={},
  number={},
  pages={1-9},
  abstract={Real-time transient stability assessment (TSA) in power system is to determine a power system's ability to continue to provide service (electric energy) in case of an unforeseen catastrophic contingency in real-time. During system operation, the online determination of the dynamic security level is fundamental in order to take appropriate countermeasures, with the aim of restoring the system, if necessary, to a more secure operation condition. To assess the level of system strength or weakness relative to the occurrence of an undesired event, a quantitative measure based on transient stability index is often considered. In this paper, a practical generator maintenance scheduling (GMS) which is a reflection of power generation loss due to scheduled shutdown maintenance, load shedding and large unforeseen transient disturbance in form of three-phase fault are the credible contingencies considered. These contingencies are analyzed using prony method, transient energy function (TEF) analysis and real-time transient stability assessment indexes (TSAIs) of Nigerian power system modeled on the real-time digital simulator platform. The contribution of this paper is to implement the TSA in real-time, and investigate the effectiveness of the prony method, TEF analysis and real-time TSAIs as important tools for electric energy management when subjected contingencies.},
  keywords={Power system transients;Power system stability;Real time systems;Power generation;Power system security;Power system dynamics;Power system restoration;Transient analysis;Power system modeling;Power system simulation;Energy management;Generator maintenance scheduling;prony analysis;real-time digital simulator;real-time transient stability assessment;transient energy function},
  doi={10.1109/ISGT.2010.5434748},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{6970123,
  author={Oluwagbemi, Folakemi and Misra, Sanjay and Omoregbe, Nicholas},
  booktitle={2014 Global Summit on Computer & Information Technology (GSCIT)}, 
  title={Pervasive computing in classroom environments and applications}, 
  year={2014},
  volume={},
  number={},
  pages={1-6},
  abstract={Pervasive computing is an advanced computing paradigm which makes computing available everywhere and anywhere. It allows users to interact with computers. Such computers can exist in different forms such as laptops, tablets, a pair of glasses (wearable computers) and clothes or wearable fabrics that are sensor-embedded. It is essential to explore the different applications of pervasive computing to learning in classroom environments, in order to foster learning and promote well-being among students. One of the problems currently confronting some developing countries is a lack of adequate facilities to support proper learning in classroom environments. This has had a negative impact on the performance of students at various levels of educational learning. In this paper, a review of current trends, future trends and applications of pervasive computing was explored, particularly with respect to classroom learning environments, and a generic model of pervasive computing technology was proposed for adoption in classroom learning environments of developing countries, particularly the Nigerian tertiary institution's classroom learning environment.},
  keywords={Pervasive computing;Educational institutions;Market research;Games;Three-dimensional displays;Printing;pervasive computing;classroom environments;pervasive technologies;current trend;future trends},
  doi={10.1109/GSCIT.2014.6970123},
  ISSN={},
  month={June},}@INPROCEEDINGS{9565805,
  author={Asipade, Akolade I. and Thomas, Jakita O. and Rankin, Yolanda A.},
  booktitle={2021 IEEE 9th International Conference on Healthcare Informatics (ICHI)}, 
  title={Implementing Community-Based Participatory Design and Mixed Methods to capture and Analyze Mental Models of no/low Literate Users}, 
  year={2021},
  volume={},
  number={},
  pages={372-380},
  abstract={One of 21 Nigerian women still die from avoidable maternal death. Yet, one of the most critical intervention for safe motherhood is ensuring that women (even in the most remote areas) have access to and are well informed of antenatal and postnatal care information and services. Previous research reveals that Ilorin women depended more on each other for antenatal and postnatal care information than on skilled birth attendants. However, when designing for historically underserved populations, the adoption and scaling of the interventions can be truncated if the target population is not adequately considered and integrated into the design process. This paper describes including no/low literate users as co-designers through community based participatory design in the development process and mixed methods to analyze collected data. Our results inform best practices for developing information architecture for these populations based on their mental models.},
  keywords={Analytical models;Design methodology;Conferences;Sociology;Medical services;Cognitive science;Statistics;mental models;information architecture;mHealth;participatory design},
  doi={10.1109/ICHI52183.2021.00062},
  ISSN={2575-2634},
  month={Aug},}@INPROCEEDINGS{9698807,
  author={Fajuke, Ibukun Damilola and Raji, Atanda K. and Abiola, Adepoju Gafar},
  booktitle={2021 International Conference on Electrical, Computer and Energy Technologies (ICECET)}, 
  title={Optimal Sitting and Sizing of Static Synchronous Compensator on Longitudinal Transmission System for Power Loss Reduction using Firefly Algorithm}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={A set of linked lines that permits the large-scale transportation of electricity is generally referred to as a transmission system. However, this system is subject to issues of power losses and the need to minimize these losses becomes inevitable to boost the reliability of the system. This study aims to reduce the total power loss of transmission system by way of appropriate sitting and sizing of STATCOM using Firefly Algorithm (FA). The steady state model of STATCOM was included in Newtow-Raphson (NR) algorithm for power flow analysis, and then optimized using FA and implemented with MATLAB. The approach was implemented on Nigerian longitudinal transmission system. The results showed that the total power loss at base case, with STATCOM and STATCOM optimized with FA are 54.70 MW, 48.10 MW and 43.36 MW respectively. The best sitting and sizing of STATCOM in the network after optimization are buses 9, 13, 14 and 16 with compensation values of 26.54 MVar, 43.74 MVar, 15.71 MVar and 6.14 MVar respectively. The results have shown FA as an effective method for sitting and sizing of STATCOM in transmission system.},
  keywords={Measurement;Transportation;Propagation losses;Automatic voltage control;Mathematical models;Steady-state;Reliability;FACTS;STATCOM;Firefly Algorithm;Transmission System;Optimization},
  doi={10.1109/ICECET52533.2021.9698807},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9493529,
  author={Ahmed, Abubakar Mu’Azu and Abdullah, Nor Athiyah},
  booktitle={2021 International Congress of Advanced Technology and Engineering (ICOTEN)}, 
  title={Conceptual Paper: Behavioural Intention to Use MOOCs the Moderating Effect of Perceived Openness and Facilitating Condition}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={Massive Open Online Courses (MOOCs) have recently gained a lot of attention as a new e-learning paradigm. Despite its widespread use, the high percentage of students who do not use it raises concerns among institutions in developed countries who have spent considerable time and money developing it. As a result, it is critical to comprehend the variables that affect students' decisions to take MOOCs. This paper proposes a conceptual framework for assessing MOOC acceptance among students in Nigerian higher education institution, and it expands on the technology acceptance model (TAM). Five constructs and two moderators are identified and hypothesized and synthesis of related prior literature: perceived usefulness, perceived ease of use, reputation, subjective norm, facilitating condition, and technology awareness. The suggested conceptual framework in this research enriches existing literature on student’s intention to use MOOCs.},
  keywords={Computer aided instruction;Technological innovation;Electronic learning;Technology acceptance model;Bibliographies;Education;Openness;Facilitating condition;Behavioral Intention;MOOCs},
  doi={10.1109/ICOTEN52080.2021.9493529},
  ISSN={},
  month={July},}@ARTICLE{11493897,
  author={Adewale, Adeyinka Ajao and Onn Choo, Wou and Onwudiegwu, Ebubechukwu I. and Wejin, John Simon and Makhsetbay Zinatdin, Aitimbetov and Stephen Aderibigbe, Ojo},
  journal={IEEE Access}, 
  title={Development of a Low-Cost Flex-Sensor and Machine Learning-Based Sign Language Interpreter}, 
  year={2026},
  volume={14},
  number={},
  pages={68766-68778},
  abstract={Over the years, sign language has been a paramount approach for bridging the communication gap between people with normal hearing and those with hearing challenges, thereby achieving inclusive education and social integration. With the diversity of modern-day gestures and body positions during communication, developing automated Signed Language Interpreters (SLIs) and recognition systems is complex and challenging. Thus, scientists and researchers worldwide are developing simpler and more affordable SLI systems. This research addresses the issue of complex, unaffordable, and ineffective communication between hearing- and hearing-impaired communities by developing a wearable SLI using a flex-sensor-based glove and a machine learning algorithm. The primary aim is to assist individuals with hearing impairments by converting American Sign Language (ASL) finger spelling into text. The study focused on ASL due to its extensive research base, global reach, and historical ties with Nigerian sign language. The methodology involved designing and integrating flex sensors into a glove to capture hand gestures, which were then processed using a machine learning algorithm to interpret the ASL finger spelling. The hardware components included flex sensors, a NodeMCU-32S LUA development board (based on the ESP32 microcontroller), and an MPU6050 accelerometer. At the same time, the software implementation utilised Python and the Arduino Integrated Development Environment (IDE) for data acquisition and model development. The results demonstrated the system’s effectiveness in accurately interpreting ASL finger spelling, with significant improvements in training and test accuracy over multiple epochs. The system achieved satisfactory performance, indicating its potential for real-world applications in assisting communication for people who are deaf or hard of hearing. The implications of an accuracy of 92% indicate that a low-cost wearable device can interpret sign language correctly, bridging communication gaps for deaf people, thereby enhancing SLI availability and enabling hearing-challenged individuals to interact more freely and confidently across various social settings.},
  keywords={Antennas;Digital audio players;Digital audio broadcasting;Radio broadcasting;Frequency modulation;Flexible printed circuits;Microcontrollers;Microprocessors;Printed circuits;Circuits;Inclusive education;sign language;machine learning;microcontroller},
  doi={10.1109/ACCESS.2026.3686962},
  ISSN={2169-3536},
  month={},}@ARTICLE{10296482,
  author={Daugman, John and Downing, Cathryn and Akande, Oluwatobi Noah and Abikoye, Oluwakemi Christiana},
  journal={IEEE Transactions on Biometrics, Behavior, and Identity Science}, 
  title={Ethnicity and Biometric Uniqueness: Iris Pattern Individuality in a West African Database}, 
  year={2024},
  volume={6},
  number={1},
  pages={79-86},
  abstract={We conducted more than 1.3 million comparisons of iris patterns encoded from images collected at two Nigerian universities, which constitute the newly available African Human Iris (AFHIRIS) database. The purpose was to discover whether ethnic differences in iris structure and appearance such as the textural feature size, as contrasted with an all-Chinese image database or an American database in which only 1.53% were of African-American heritage, made a material difference for iris discrimination. We measured a reduction in entropy for the AFHIRIS database due to the coarser iris features created by the thick anterior layer of melanocytes, and we found stochastic parameters that accurately model the relevant empirical distributions. Quantile-Quantile analysis revealed that a very small change in operational decision thresholds for the African database would compensate for the reduced entropy and generate the same performance in terms of resistance to False Matches. We conclude that despite demographic difference, individuality can be robustly discerned by comparison of iris patterns in this West African population.},
  keywords={Iris recognition;Biometrics (access control);Databases;Ethnicity;Hamming distances;Entropy;NIST;Ethnicity;demographic differentials;african;biometric entropy;iris recognition;equity measure},
  doi={10.1109/TBIOM.2023.3327287},
  ISSN={2637-6407},
  month={Jan},}@INPROCEEDINGS{5307395,
  author={Momoh, James A. and Xia, Yan and Boswell, Garfield D.},
  booktitle={2008 40th North American Power Symposium}, 
  title={An approach to determine Distributed Generation (DG) benefits in power networks}, 
  year={2008},
  volume={},
  number={},
  pages={1-7},
  abstract={In this paper, an approach to determine the value-added benefits of distributed generation (DGs) on the performance of power system is proposed. It utilizes a robust optimization technique to compute marginal price contributions of distributed generation (DGs) in a typical power system network. An approach that is based on optimal power flow has been shown. It also features incorporating DG as constraints in the general formulation. The value measures or benefits based on marginal pricing are computed for different loading as well as system contingencies that threatens grid security. The overall scheme provides improved quantitative benefits of DG dispatch at specific locations and offers a justification for applications in grid expansion plans. The Power Holding Company of Nigeria (PHCN) power system network model was adopted for this research and improved to include large-scale penetration of DG at the sub-transmission levels.},
  keywords={Distributed control;Power system security;Power system measurements;Power system modeling;Robustness;Computer networks;Distributed computing;Load flow;Pricing;Grid computing;Distributed Generation (DG);Locational Marginal Prices (LMP)},
  doi={10.1109/NAPS.2008.5307395},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{1303972,
  author={Stephens, P. and Cooksley, J. and da Silva Curiel, A. and Boland, L. and Jason, S. and Northham, J. and Brewer, A. and Anzalchi, J. and Newell, H. and Underwood, C. and Machin, S. and Sun, W. and Sweeting, S.M.},
  booktitle={International Conference on Recent Advances in Space Technologies, 2003. RAST '03. Proceedings of}, 
  title={Launch of the international Disaster Monitoring Constellation; the development of a novel international partnership in space}, 
  year={2003},
  volume={},
  number={},
  pages={525-535},
  abstract={Three spacecraft for the UK, Turkey and Nigeria were launched together in September 2003, to join Algeria's satellite, AlSat-1, in the Disaster Monitoring Constellation (DMC). Surrey Satellite Technology Ltd. has designed, built and launched the world's first constellation to provide daily global Earth observation coverage at moderate resolution in three spectral bands. This international initiative will provide daily images for global disaster monitoring, as well as supporting each partner nation's indigenous remote sensing requirements. The DMC programme establishes a novel model for international collaboration, and demonstrates how small satellite missions can be employed for a wide range of applications. This paper shows the first in-orbit mission results from DMC satellites including examples of unique EO data products comprising up to 600/spl times/600 km images gathered at 32-metres GSD in 3 spectral bands.},
  keywords={Space technology;Satellites;Space vehicles;Remote monitoring;Image resolution;Java;Sun;Earth;International collaboration;Costs},
  doi={10.1109/RAST.2003.1303972},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9464598,
  author={Okaidat, Arwa and Melhem, Shatha and Alenezi, Heba and Duwairi, Rehab},
  booktitle={2021 12th International Conference on Information and Communication Systems (ICICS)}, 
  title={Using Convolutional Neural Networks on Satellite Images to Predict Poverty}, 
  year={2021},
  volume={},
  number={},
  pages={164-170},
  abstract={Since there are over a billion individuals worldwide below the international poverty line of less than $2 per day; the first goal of sustainable development is to eradicate poverty. The primary step before poverty can be eradicated is to understand the spatial distribution of poverty. However, the process of going around rural areas and manually tracking census data is time-consuming, needs a lot of human effort, and is expensive. On the other hand, high-resolution satellite images, are becoming largely available at a global scale and contains an abundance of information about landscape features that could be correlated with economic activity. Deep learning with satellite images provides a scalable way to make predicting the distribution of poverty faster, easier, and less expensive, and this helps in aiding organizations to distribute funds more efficiently and allow policymakers to enact and evaluate policies more effectively. This paper focuses on Africa as it is considered the poorest continent. The data, we have used, consist of three datasets which contain satellite images for three countries in Africa with different levels of poverty: Ethiopia, Malawi, and Nigeria. In order to classify the satellite images, two pre-trained Convolutional Neural Networks models (ResNet50 and VGG16) were implemented in addition to our novel structure of CNN. The test accuracy for CNN was 76% for the three countries. VGG16 average accuracy was 79.3% and ResNet average accuracy was 49.3%.},
  keywords={Economics;Deep learning;Satellites;Graphical models;Africa;Organizations;Convolutional neural networks;Convolutional Neural Networks (CNN);Satellite images;Poverty estimation;deep learning;Image classification},
  doi={10.1109/ICICS52457.2021.9464598},
  ISSN={2573-3346},
  month={May},}@ARTICLE{10494866,
  author={Islam, Md Didarul and Di, Liping and Zhang, Chen and Yang, Ruixin and Qu, John J. and Tong, Daniel and Guo, Liying and Lin, Li and Pandey, Aran},
  journal={IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing}, 
  title={A Decision Rule and Machine Learning-Based Hybrid Approach for Automated Land-Cover Type Local Climate Zones (LCZs) Mapping Using Multi-Source Remote Sensing Data}, 
  year={2024},
  volume={17},
  number={},
  pages={8271-8290},
  abstract={This article presents a streamlined, automated classification method to map land-cover-type local climate zones (LCZs). Using a two-phase hybrid approach, we first generated training samples through universal decision rules and subsequently, a machine learning (ML) algorithm was trained on the generated samples to classify LCZs. The proposed model harnesses plant height data, combined with spectral bands and remote sensing indices, to accurately classify various land-cover types, such as dense forest, scattered trees, bush/scrub, low plant/agricultural land, bare rocks/paved surface and bare soil/sands. Targeting global applicability, we tested our method across six diverse locations spanning four continents: Fresno (California), Central Michigan, Western Phoenix (Arizona), Khulna (Bangladesh), Lagos (Nigeria), and Western Sydney. In each location, after generating training samples with the decision rules, a random forest algorithm was employed for LCZ classification. Results showcase that data from sentinels 1 and 2, night-time light, and global ecosystem dynamics investigation relative height are effective in characterizing land-cover-type LCZs and decision-rules can be established. The decision-rules consistently auto-generate training samples, undeterred by varying geographical and climatic conditions. This automated system has achieved promising accuracy across all tested sites, suggesting its potential to map land-cover-type LCZs and vegetation globally with higher accuracy.},
  keywords={Forestry;Vegetation mapping;Remote sensing;Meteorology;Training;Earth;Land surface;Local climate zones (LCZs);machine learning (ML);multisource remotely sensed data;vegetation mapping},
  doi={10.1109/JSTARS.2024.3386389},
  ISSN={2151-1535},
  month={},}@INPROCEEDINGS{10475716,
  author={Kankia, Yasir Bashir and Che, Xianhui and IP, Barry and Ji, Wei},
  booktitle={2023 International Conference on Information Network and Computer Communications (INCC)}, 
  title={Student-Informed Technology Adoption in Higher Education of Developing Countries}, 
  year={2023},
  volume={},
  number={},
  pages={13-18},
  abstract={As traditional information technology systems become more costlier and complex to maintain, they are also no longer able to meet current educational requirements, notwithstanding issues with the lack of scalability and flexibility. Many of these issues can be addressed by the concept of Student-Informed Technology and a newly-proposed comprehensive technology readiness adoption (CTRAM) model. The five central components of CTRAM were assessed at six different universities in Nigeria which comprises of three public/Government-funded universities and three private-owned universities. The result of the study confirmed that subjective norms of students evidence a statistically significant relationship with student perceptions of cloud technology adoption in higher educational institutions in the country. All five CTRAM components: perceived innovation, perceived usefulness, perceived easiness, attitude toward technology and perceived reliability are statistically significant as a technological factor in determining students’ perception of cloud technology adoption. Results from multiple regression also clearly indicate the potential joint effect among all five factors. These findings support the existing body of knowledge regarding technological adoption in the educational sector, especially in developing countries towards their future investment and improvement.},
  keywords={Training;Cloud computing;Technological innovation;Computational modeling;Scalability;Developing countries;Data collection;student;informed technology adoption;higher education;developing countries},
  doi={10.1109/INCC58754.2023.00015},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10429861,
  author={I.G., Alberts and J.I., Emmanuel and F.O., Ngasoh and A., Bello and A.P., Onwualu and C.A., Vitalis},
  booktitle={2023 2nd International Conference on Multidisciplinary Engineering and Applied Science (ICMEAS)}, 
  title={Neem Leaf Extract As Corrosion Prevention And Inhibition Agent For Mild Steel In Acid Medium}, 
  year={2023},
  volume={1},
  number={},
  pages={1-6},
  abstract={Azadirachta Indica (Neem) plant extract was investigated as a non-toxic, green, biodegradable, and readily available, cost effective, organic green corrosion inhibitor (OGCI) for mild steel (MS) in 1M HCL and 1M H2SO4 acid media by Gravimetric (Mass Loss), Potentiodynamic Polarization Method (PDP) and Electrochemical Impedance Spectroscopy (EIS). Gravimetric, Potentiodynamic and Electrochemical Impedance Spectroscopy results indicate an increase in Neem extract dosage rate in both hydrochloric and tetraoxosulphate (IV) acid, resulting in an increase in inhibition efficiency. Increasing the extract concentration increases the charge transfer resistance (Rct) and decreases the double-layers capacitance (Cdl) because of the adsorption of N eem extract on the surface of mild steel (MS). The polarization results indicate that Neem extract exhibits mixed type inhibition behaviour on metal surface and adsorption fits well with Temkin isotherm model in H2SO4 solution. The adsorption kinetic and energy of adsorption indicate Neem is adsorbed by physisorption. The findings from different characterization techniques, indicate alignment and agreement with Gravimetric method, and confirm the high potential of Neem plant extract as inhibitor for carbon steel in corrosive media of HCL and H2SO4 and a competing alternate product to existing toxic, banned, and non-biodegradable chemical inhibitors currently in use in Nigeria and around the worldwide.},
  keywords={Surface impedance;Corrosion inhibitors;Adsorption;Surface resistance;Media;Steel;Electrochemical impedance spectroscopy;Azadirachta Indica (Neem);Extract;Carbon Steel;Mass Loss;Gravimetric;PDP;EIS;Adsorption;Corrosion Inhibition;Inhibition Efficiency;HCL;H2SO4},
  doi={10.1109/ICMEAS58693.2023.10429861},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10379247,
  author={Imam-Fulani, Yusuf Olayinka and Faruk, Nasir and Usman, Aliyu D. and Abdulkarim, Abubakar and Tekanyi, Abdoulie M.S and Yaro, Abdulmalik S. and Alozie, Emmanuel and Garba, Salisu and Adewole, Kayode S. and Oloyede, Abdulkarim A. and Sowande, Olugbenga A. and Abdullahi Baba, Bashir and Musa, Abdulwaheed and Imoize, Agbotiname Lucky and Adediran, Yinusa A. and Olagunju, Hawau I. and Taura, Lawan S.},
  booktitle={2023 2nd International Conference on Multidisciplinary Engineering and Applied Science (ICMEAS)}, 
  title={Investigation of the Impact of Height and Bandwidth on Path Loss Exponent of 5G FR1 Wireless Networks at 800, 3500, and 5900 MHz}, 
  year={2023},
  volume={1},
  number={},
  pages={1-5},
  abstract={5G communication systems provide an end-to-end wireless connection to billions of users and devices across the globe. The quality of signals received during radio communication is notably influenced by the behavior of the radio propagation channel. A major parameter used in characterizing this channel is the Path Loss Exponent (PLE). Several works that have estimated and analyzed the PLE mostly considered the effect of distance and carrier frequency. However, the effect of base station antenna height and channel bandwidth on the PLE for 5G networks have not been adequately considered. To address this, the impact of antenna height of base station and channel bandwidth on the PLE within the 5G Frequency Range 1 (FR1) frequencies was investigated in this study, specifically at 800, 3500, and 5900 MHz. The licensed EDX Signal Pro software® with Cirrus high resolution global terrain and clutter data base was utilized to model, simulate and analyze the PLE for Kano City, Nigeria. Results showed that for the tested frequencies, an increase in either base station height or channel bandwidth leads to a significant reduction in the PLE. This study can be utilized by network planning engineers and the wireless research community to further improve network implementation and optimization toward understanding the behavior of signal propagation in 5G networks and beyond.},
  keywords={Base stations;5G mobile communication;Wireless networks;Urban areas;Bandwidth;Data models;Software;Path Loss Exponent;FR1 band;EDX;5G networks;terrain;clutter;Kano City;Nigeria},
  doi={10.1109/ICMEAS58693.2023.10379247},
  ISSN={},
  month={Nov},}@ARTICLE{8532238,
  author={Adegbindin, I.A. and Owolawi, P.A. and Odhiambo, M.O.},
  journal={SAIEE Africa Research Journal}, 
  title={Intelligent Weather Awareness Technique for Mitigating Propagation Impairment at SHF and EHF Satellite Network System in a Tropical Climate}, 
  year={2016},
  volume={107},
  number={3},
  pages={136-145},
  abstract={This paper presents an Intelligent Weather Awareness Technique (IWT) based on fuzzy logic to achieve optimum signal quality when the impact of weather attenuations become manifest in Earth-satellite link. An adaptive measure of a decision support system is adopted using the point rainfall rate to predict rain-induced attenuation over three locations in the tropical region of Nigeria based on Moupfouma rain rate and attenuation model. In order to impact good Quality of Service (QoS) in the overall design of satellite communication networks, considerable efforts have to be made, such as the use of appropriate forward error correction codes, the choice of modulations and the range of uplink/downlink power controls. The IWT interacts with the input parameters to optimise the Signal to Noise Ratio (SNR) values while the input parameters are varying. The results show that in all three locations considered, a minimum fade margin of about 12 dB on the uplink and ~ 8 dB on the downlink may be allowed at the 99.5% availability for a worst case scenario at Ka-band. Analysis based on SNR and consumed power at the same weather conditions confirms the suitability of introduction of fuzzy logic for optimum availability of good QoS in a weather impaired satellite system. The overall results would provide tolerance margins needed for better QoS, especially during bad weather in the study locations.},
  keywords={Rain;Attenuation;Mathematical model;Signal to noise ratio;Satellites;Data models;SNR;tropical weather;Intelligent Weather Awareness Technique;satellite network},
  doi={10.23919/SAIEE.2016.8532238},
  ISSN={1991-1696},
  month={Sep.},}@INPROCEEDINGS{10926965,
  author={Ajao, Qasim and Sodiq, Oluwatobi Oluwaponmile and Sadeeq, Lanre},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Understanding Adoption and Integration of Autonomous EVs in Sub-Saharan Africa: Challenges and Technical Recommendations}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Transportation is critical to Sub-Saharan Africa’s (SSA) energy framework, with rising demand driven by population growth and economic progress. Over the past decade, transport emissions in Africa have surged by 90%, highlighting its significant energy consumption. In 2023, the sector accounted for 40% of SSA’s total energy consumption. Globally, there is a shift from internal combustion engines (ICE) to low-emission electric vehicles (EVs), including autonomous EVs, across various transport networks. This trend is also emerging in SSA, a region heavily reliant on imported used cars. EVs offer substantial benefits, including reduced emissions and improved air quality. However, as of 2022, South Africa and Nigeria together registered only around 1,000 EVs, reflecting significant adoption challenges. Concerns include potential strains on power grids and perceived financial inaccessibility. This paper proposes a nuanced approach, suggesting that EVs, including autonomous models, can significantly benefit SSA through tailored strategies, innovative technologies, and context-specific solutions. These approaches differ from those in high-income countries (HIC) and focus on aligning EVs with regional needs to support sustainable development goals.},
  keywords={Energy consumption;Technological innovation;Biological system modeling;Government;Transportation;Motorcycles;Africa;Electric vehicles;Sustainable development;Investment;Autonomous electric vehicles;Sustainable Future;Renewable energy;Transportation;Sub-Saharan Africa},
  doi={10.1109/NIGERCON62786.2024.10926965},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{9906471,
  author={Adedokun, Susan Oluropo and Luo, Zhenhua and Luk, Patrick and Balta-Ozkan, Nazmiye and Khan, Mohammad Farhan and Zhang, Xin},
  booktitle={2022 IEEE Design Methodologies Conference (DMC)}, 
  title={ML Self-Sufficient Sustainable Energy Resiliency Management System: Outage Forecasting, Classification and Restoration with Maintenance Indicators for All Types of Power Outages}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={Power systems resiliency studies focus largely on operational planning, optimization, and control strategies to restore critical loads, after blackouts from extreme incidents, and natural disasters, which characterize high-impact, low-probability events. There is a lacuna of resiliency studies of other events, including blackouts with high-impact, high-probability, which classify technical faults. However, the highest percentage of blackouts are from equipment failure technical related faults. Few ML studies cover both outage forecasting and restoration, including resiliency methods for all types of power outages. This study presents a resiliency management system framework, incorporating maintenance indicators, for all types of outages from different events, particularly in developing countries, where up to 60% of blackouts are technical related. A novel framework, with machine learning classification and regression is applied. The model is validated with real historic load flows and outage interruptions of four Nigeria states. Results reveal complex multiple power outages due to different causes at different locations. A relay target indication of 91.8%, an outage type classification accuracy of 85%, and a start time regression (R) value of one, signify that the onset of all types of power outages can be predicted accurately, including indication of maintenance targets where self-sufficient, sustainable energy resources can be applied to enhance power system resilience.},
  keywords={Monte Carlo methods;Energy resources;Machine learning;Maintenance engineering;Power system reliability;Planning;Forecasting;Machine Learning;Blackout Events;Power Outage Forecasting;Restoration;Self-Sufficient Sustainable Energy Resources;Resilience},
  doi={10.1109/DMC55175.2022.9906471},
  ISSN={},
  month={Sep.},}@ARTICLE{11287992,
  author={Mazurek, Szymon and Moore, Stephen and Crimi, Alessandro},
  journal={IEEE Open Journal of Engineering in Medicine and Biology}, 
  title={Graph Attention Networks for Detecting Epilepsy From EEG Signals Using Accessible Hardware in Low-Resource Settings}, 
  year={2026},
  volume={7},
  number={},
  pages={20-26},
  abstract={Goal: Epilepsy remains under-diagnosed in low-income countries due to scarce neurologists and costly diagnostic tools. We propose a graph-based deep learning framework to detect epilepsy from low-cost Electroencephalography (EEG) hardware, tested on recordings from Nigeria and Guinea-Bissau. Our focus is on fair, accessible automatic assessment and explainability to shed light on epilepsy biomarkers. Methods: We model EEG signals as spatio-temporal graphs, classify them, and identify interchannel relationships and temporal dynamics using graph attention networks (GAT). To emphasize connectivity biomarkers, we adapt the inherently node-focused GAT to analyze edges. We also designed signal preprocessing for low-fidelity recordings and a lightweight GAT architecture trained on Google Colab and deployed on RaspberryPi devices. Results: The approach achieves promising classification performance, outperforming a standard classifier based on random forest and graph convolutional networks in terms of accuracy and robustness over multiple sessions, but also highlighting specific connections in the fronto-temporal region. Conclusions: The results highlight the potential of GATs to provide insightful and scalable diagnostic support for epilepsy in underserved regions, paving the way for affordable and accessible neurodiagnostic tools.},
  keywords={Electroencephalography;Epilepsy;Brain modeling;Vectors;Recording;Feature extraction;Artificial intelligence;Training;Biomarkers;Random forests;Electroencephalography (EEG);epilepsy;graph attention network (GAT);low-cost;GCN},
  doi={10.1109/OJEMB.2025.3642070},
  ISSN={2644-1276},
  month={},}@INPROCEEDINGS{8356370,
  author={Abatan, Omotayo Kayode and Maharaj, Manoj},
  booktitle={2017 12th International Conference for Internet Technology and Secured Transactions (ICITST)}, 
  title={Change management and the integration of information technology: Research notes from selected African universities}, 
  year={2017},
  volume={},
  number={},
  pages={167-172},
  abstract={The aim of this article is to examine change management awareness (CMA) by evaluating the perceptions of academics regarding information technology integration in higher education in Africa. Data were collected from 592 academics at three prominent higher education institutions in Africa. These included two direct contact (or on-site) institutions, namely Lagos State University in Nigeria and the University of KwaZulu-Natal in South Africa, and an open distance learning (ODL) institution, the University of South Africa. Data were analysed using descriptive statistics. The requirements of effective integration of information technology and change management awareness in higher education were identified using a change management model. The findings indicated that academics are self-aware of the need for change in order to enhance technology integration in higher education. The study identified that universities should take responsibility in providing the strategies needed to implement change in the use of information technology.},
  keywords={Education;Information technology;Africa;Internet;Economics;Computers;Information services;academics;change management;higher education;information technolog;information and communication technologies},
  doi={10.23919/ICITST.2017.8356370},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{6875737,
  author={Ezeoke, Maurice and Tong, Kenneth and Mubea, Kenneth},
  booktitle={2014 IEEE Radar Conference}, 
  title={Electromagnetic characterisation of terrain for unconventional petroleum exploration}, 
  year={2014},
  volume={},
  number={},
  pages={0990-0995},
  abstract={A method to characterize the electromagnetic (EM) signature of barefaced terrain using 3D computer electromagnetic models (CEM) for radar applications is presented. Five barefaced terrain types with different electrical, physical and chemical properties were investigated. They include both homogeneous and heterogeneous terrain types particularly beach sand, gravel and pebble acquired locally and oil sands from Nigeria. The approach develops CEMs using reflectance spectroscopy and dielectric permittivity data. First geochemical signatures were determined using reflectance spectroscopy in the Near Infrared region while dielectric properties were experimentally determined at L-, C- and X-band for multi-frequency radar. Both viscous and hard oil sand indicated resonance effects in the upper C-band. The results provide new information on the complex electrical permittivity ε*(co) and loss tangent, tan ö. Finally a laboratory based approach to measure the relationship between sensor configuration and terrain backscatter for 0.013m3 of terrain samples using microwave measurement techniques in an anechoic chamber is outlined.},
  keywords={Permittivity;Hydrocarbons;Dielectrics;Permittivity measurement;Reflectivity;Frequency measurement},
  doi={10.1109/RADAR.2014.6875737},
  ISSN={2375-5318},
  month={May},}@INPROCEEDINGS{10836497,
  author={Olaleye, Banji Rildwan and Khumalo, Ntseliseng and Ayodele, Ademola Emmanuel},
  booktitle={2024 International Conference on Decision Aid Sciences and Applications (DASA)}, 
  title={Integrating Sustainable Behavior Into Construction Risk Management: Modeling Human Related Factors And Attitude}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This study aims to examine human-related elements and the impact of contractors' risk attitudes on construction risk management, while also addressing the moderating effect of sustainable behavior. This study used descriptive and inferential statistics to examine data collected from 317 contractors in Nigeria's construction business. We gathered the data using a convenience sample technique and analyzed using the “partial least-squares structural equation modelling” (PLS-SEM) technique. However, the findings demonstrated that acknowledged human-related factors have a positive impact on risk management in the construction sector. Additionally, researchers found that these factors positively influenced the risk attitudes of contractors. As a behavior, sustainable practices moderate the association between human-related factors and contractor risk management. However, eliminating risk is impossible and requires meticulous management. The approach's final innovative feature is the incorporation of sustainable behaviors in construction risk management.},
  keywords={Analytical models;Mathematical models;Data models;Behavioral sciences;Risk management;Business;Contractor's risk attitude;Construction risk management;Human-related factors;Sustainable behavior;Theory of Planned behavior},
  doi={10.1109/DASA63652.2024.10836497},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11410474,
  author={Akpan-Williams, David and Adoghe, Anthony U. and Oguntosin, Victoria},
  booktitle={2025 5th International Multidisciplinary Information Technology and Engineering Conference (IMITEC)}, 
  title={Design and Installation of a Smart Solar System for an Orphanage}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Institutions that work with children, like orphanages, need consistent access to energy, but Nigeria's grid supply is still erratic and largely depends on expensive, environmentally harmful diesel generators. The design, installation, and assessment of a 12 kVA solar-powered system created to supply lighting and cooling for an orphanage in Alagbado, Lagos, are shown in this project. A 96,000 Wh lithium iron phosphate (LiFePO4) battery bank, two 6 kVA Growatt hybrid inverters with Wi-Fi monitoring, 18 monocrystalline solar modules (665 W each), and two 125 A maximum power point tracking (MPPT) charge controllers make up the system. According to load evaluations, lighting, fans, and cooling appliances accounted for the majority of the daily energy demand, which was around 68.6 kWh. After taking the inverter into consideration, simulation and loss analysis calculated that the overall system efficiency was 74 %,taking into consideration losses from the inverter, temperature, wiring, dust, and storage. Stable inverter output, efficient load assistance during evening demand peaks, and a realistic 2.5-day battery autonomy were all demonstrated during a 48-hour performance study. The installed system ensured children's indoor comfort in Lagos' tropical climate while reducing dependency on the national grid and doing away with the need for generators. The initiative supports the Sustainable Development Goals of the UN (SDG 3: Good Health and Well-Being and SDG 7: Affordable and Clean Energy) in addition to its technical performance. It is a replicable model for other humanitarian facilities dealing with comparable energy issues because of its modular design, which enables future growth.},
  keywords={Temperature measurement;Maximum power point trackers;Temperature;Lighting;Inverters;Generators;Batteries;Solar system;kWh;Monitoring;Solar PV;Hybrid Inverter;Off-grid System;Orphanage;Energy Access;Sustainable Energy)},
  doi={10.1109/IMITEC67386.2025.11410474},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9803165,
  author={Atimati, Ehinomen and Crawford, David and Stewart, Robert and Achumba, Ifeyinwa and Ezema, Longinus and Diala, Uchenna},
  booktitle={2022 IEEE Nigeria 4th International Conference on Disruptive Technologies for Sustainable Development (NIGERCON)}, 
  title={An Interference Management System for a Shared Spectrum Access Network}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Internet access, in developing and underdeveloped countries, remains a huge challenge despite advancements in technology. Shared resources, amongst telecommunication systems, offer an affordability context to this problem. A shared spectrum interference management system is implemented by designing a geolocation database, for a television white space network, for a location in Nigeria. This is achieved using the Dynamic Spectrum Alliance framework (a rarely used methodology) and robust terrain-based propagation models. The designed spectrum coexistence manager (geolocation database) was created, presented, and evaluated, based on its channel availability, predictions, and ability to protect very weak TV signals. The result showed a 15% channel utilization of Analogue and Digital Terrestrial Television channels within the study area. Finally, key components of the framework, that can be adopted for further studies, were identified.},
  keywords={TV;Sensitivity;Databases;Transmitters;Geology;Interference;White spaces;spectrum;television white space;coexistence;internet access;dynamic spectrum access},
  doi={10.1109/NIGERCON54645.2022.9803165},
  ISSN={2377-2697},
  month={April},}@INBOOK{11505368,
  author={Aryee, Jeffrey Nii Armah and Davies, Patrick and Torsah, Godfred Abbey and Amekudzi, Leonard Kofitse},
  booktitle={Degrees of Change: What AI Means for Education and the Next Generation}, 
  title={Rethinking AI Accessibility in African Higher Education Institutions Through Inclusive Participation and Policy Reform}, 
  year={2026},
  volume={},
  number={},
  pages={94-112},
  abstract={Summary <p>Artificial intelligence (AI) adoption across the Global South, particularly in Africa, offers promising avenues for socioeconomic transformation. This chapter seeks to understand the scope of equitable access to AI education and fluency through systemic reform in African higher education institutions (HEIs). It employs a mixed methodology approach: a systematic review of scholarly records from Google Scholar, ScienceDirect, and Scopus databases, as well as policy documents from Africa. The chapter highlights spatial disparities in AI policy efforts, with limited attention to inclusive education, digital equity, and stakeholder engagement. Collaborative models that bring together HEIs, policymakers, and communities are essential to ensure that academic institutions help shape policies, develop meaningful curricula, and remain rooted in the needs of the people they serve. Countries such as Kenya, Rwanda, Nigeria, and Ghana have benefited from stronger infrastructure, active government involvement, and closer links to global AI projects, positioning East and West Africa as leaders in AI governance.</p>},
  keywords={Feedback;Circuits;Internet;Communication systems;Computer networks;Information and communication technology;Communications technology;Artificial intelligence;Computational and artificial intelligence;Learning (artificial intelligence)},
  doi={10.1002/9781394413096.ch8},
  ISSN={},
  publisher={Wiley},
  isbn={9781394413089},
  url={https://ieeexplore.ieee.org/document/11505368},}@INPROCEEDINGS{10927225,
  author={Biona Adeosun, Sunday Oluwaseun and Ajayi, Sunday Thomas and Olanrewaju, Oludolapo Akanni and Ighravwe, Desmond Eseoghene and Amole, Abraham Olatide and Etangetuk, Asukwu Enediabasi},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Analysis of Socio-Economic Criteria for Sewage Siting Decisions: A Fuzzy DEMATEL Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Sewage treatment plants play a pivotal role in urban management because of the volume of waste generated. Hence, their siting must be given adequate attention to optimise its benefits to a community. This siting problem is complex when multiple socio-economic factors are considered. To address this problem, this study presents a parametric analysis method for sewage facility siting. The technique combines fuzzy logic and the DEMATEL (Decision-Making Trial and Evaluation Laboratory) method; this combination improved the handling of uncertainty associated with experts' opinions on the criteria assessment. This method was used to model and evaluate the relationship among different socio-economic parameters that affect sewage facility siting, including population density and proximity to residential areas. With this method, the current study determined the cause-and-effect relationships among the socio-economic criteria. Using information from an estate in Lagos, Nigeria, we observed that environmental sustainability and health impacts were the most significant criteria for siting sewage facilities. On the other hand, it was observed that economic development and residential areas were considered dependent variables – which implies that they are affected by different parameters. They were highly influenced by other socio-economic factors such as population density and proximity to residential areas. These findings show the importance of considering socio-economic factors in planning sewage facility siting to promote sustainable urban development while minimising a facility's socio-economic impact. The framework presented in this study provides urban planners with a systematic approach for optimising sewage siting decisions in urban communities.},
  keywords={Hands;Costs;Uncertainty;Systematics;Decision making;Green products;Urban planning;Socioeconomics;Population density;Facilities management;Decision-making;sewage facility siting;fuzzy DEMATEL;socio-economic criteria;environmental sustainability;urban planning},
  doi={10.1109/NIGERCON62786.2024.10927225},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{11414481,
  author={Madaki, Rafeeah Rufai and Prasad, Rajesh},
  booktitle={2025 3rd International Conference on IoT, Communication and Automation Technology (ICICAT)}, 
  title={Computational Approaches used in Malaria Prediction in Africa: A Critical Review}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Malaria has been among the common diseases affecting Africa. Nigeria leads worldwide in malaria incidence. Numerous methods where used by different researchers with the intention of eradicating Malaria. Computational methods such as mathematical models and machine learning have been utilized in predicting Malaria occurrences. This review intends to study the various method used by different researchers in predicting malaria in Africa with the view of indicating areas to be accorded additional attention to win the fight against Malaria.},
  keywords={Automation;Reviews;Malaria;Africa;Machine learning;Mathematical models;Malaria;Machine learning;Prediction;Mathematical models},
  doi={10.1109/ICICAT68430.2025.11414481},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11498907,
  author={Olaleye, Banji Rildwan and Khumalo, Ntseliseng and Lekunze, Joseph Nembo and Orji, Everistus Zeluwa},
  booktitle={2025 International Conference on Decision Aid Sciences and Applications (DASA)}, 
  title={Influence of Authentic Leadership on Employees and Sustainable Performance in Selected Construction Firms: Does Work Engagement Matter?}, 
  year={2025},
  volume={},
  number={},
  pages={1930-1939},
  abstract={Authentic leadership has become increasingly recognized as a crucial factor in organizational performance across various industries. Nevertheless, its effects on employee and sustainable performance in the construction sector, particularly in the unique context of the southwest region of Nigeria, remain underexplored, especially when psychological intervening factors, such as work engagement, are considered. This study examines the relationship between authentic leadership (ATL), employee performance, and sustainable performance, and investigates the role of work engagement as a potential dual influence on these relationships. 490 data were gathered from employees of selected construction companies in this region, via an online Google form. They were subsequently analyzed using the SMARTPLS software. Grounded in authentic leadership theory and the job demand-resources (JD-R) model, data from construction firms indicate that authentic leadership and work engagement are positively related to employee and sustainable performance. However, work engagement, while independently associated with employee performance, significantly mediates the leader-performance connection; the moderating role in relation to sustainable performance remains insignificant. Notably, the traits of authentic leadership help employees develop key skills for top performance, inspiring a culture of continuous improvement and engagement.},
  keywords={Circuits;Feedback;Protocols;HTTP;Internet;Communication systems;Computer networks;Boosting;Learning (artificial intelligence);Machine learning;Authentic leadership;Construction Companies;Employee Performance;Sustainable Performance;Work Engagement},
  doi={10.1109/DASA68193.2025.11498907},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10927158,
  author={Braide, Sepiribo Lucky and Mohmmed, Shaimaa Hadi and Jiyad, Israa Zamel and Salau, Ayodeji Olalekan and Badrudeen, Tayo Uthman},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Transient Stability Evaluation of 132kV Transmission Network for Improved Power Quality}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Transient instability in the power system leads to voltage collapse and consequently outages. This paper proposed the formulation and use of a 4th-order Runge-Kutta and a conventional swing equation for the 132 kV power transmission network from the Afam generating station to the Port Harcourt main (zone-2) injection substation. The initiated faults are not expected to last longer than necessary in the occurrence of a fault. This means that relays must provide automatic signaling communication to dedicated protective devices for isolation to avoid system interruption and breakdown. Numerical data were collated from the Transmission Company of Nigeria (TCN) to analyze the study case under investigation. The electrical transient analyzer tool (ETAP) was used to model and simulate the given preset value circuit breaker and relay time setting of 0.00, 0.02, 0.04, 0.06, 0.10, 0.12, and 0.14, respectively, on the view to investigate and evaluate parameters of rotor angle (δ), angular speed (w), and rotor-differential change (dδ/dt). The protective relay to coordination considered 10-cycle operation to the relay time setting of t=0.2 seconds, which must be responsive to clear faults as quickly as possible to enhance reliable power supply. The obtained results vividly indicate that the fourth (4th) order Runge-Kutta numerical technique tends to restore fault conditions and become stable and accurate with a fast response time of 0.02 seconds. It provides a lower absolute error of - 51% with power transfer capability from 0.00 pu to 3.7870 pu. This significantly means that the relays/protective device actions to system abnormal condition restoration time for stability were adequate during transient behavior as compared to other numerical solutions (modified Euler technique, etc.) for power system evaluation and analysis.},
  keywords={Substations;Rotors;Power system stability;Stability analysis;Mathematical models;Circuit stability;Circuit faults;Time factors;Transient analysis;Numerical stability;Fourth (4th order);Runge kutta;conventional swing equation;transient stability;132kv transmission;faults;critical clearing time},
  doi={10.1109/NIGERCON62786.2024.10927158},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{11308600,
  author={Lungu, Nelson and Dash, Bibhuti Bhusan and Tembo, Simon and De, Utpal Chandra and Singh, Satyendr and Patra, Sudhansu Shekhar},
  booktitle={2025 International Conference on Sustainable Communication Networks and Application (ICSCN)}, 
  title={AI-Driven Integrated Logistics Framework for Antimalarial Drug Distribution in Remote Areas}, 
  year={2025},
  volume={},
  number={},
  pages={2143-2150},
  abstract={More than 600,000 people died from malaria in 2022, making it one of the main causes of death in Sub-Saharan Africa. Seasonal disease outbreaks and inadequate infrastructure in isolated areas frequently result in antimalarial medication shortages. For rural clinics, we offer an intelligent logistics framework that systematically predicts demand and schedules medication distribution. Our methodology combines a deep Reinforcement Learning (RL) agent for adaptive routing under uncertainty, a Graph Neural Network (GNN)-based supply-chain optimiser, and a multivariate Long Short-Term Memory (LSTM) network for demand prediction. By taking geography, vehicle capacities, cold-chain restrictions, and seasonal malaria patterns into consideration, the system simultaneously reduces delivery time and cost while avoiding stockouts. Our model architectures, training protocols, and data sources are all thoroughly described. Real-world data from 247 rural health facilities spread across six African nations (Kenya, Nigeria, Malawi, Uganda, Tanzania, and Zambia) over 24 months is used for experimental validation. Our method reduces average delivery time by 42%, total distribution cost by 28%, and stockout incidents by 34% when compared to a traditional static planning baseline. The normalised error metric for demand forecasts is 92.1%, which is a considerable improvement over the 67.3% accuracy of basic methods. These improvements are highly significant, according to statistical tests (p<0.01). These findings show that antimalarial medication delivery in underserved areas can be significantly enhanced by a fully integrated AI-driven pipeline.},
  keywords={Training;Costs;Uncertainty;Accuracy;Malaria;Graph neural networks;Vaccines;Long short term memory;Optimization;Drones;antimalarial logistics;demand forecasting;LSTM;graph neural network;reinforcement learning;supply chain optimization;remote healthcare},
  doi={10.1109/ICSCN67106.2025.11308600},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10771563,
  author={Zhang, LeLe and Wu, Xin and Liu, Kailun and Xiong, Chenfeng},
  booktitle={2024 IEEE Global Humanitarian Technology Conference (GHTC)}, 
  title={Evaluating the Spatial-Temporal Impact of Urban Flooding on Mobility Patterns and Point of Interest}, 
  year={2024},
  volume={},
  number={},
  pages={424-430},
  abstract={Urban flooding poses significant challenges to densely populated areas, increasing vulnerability to environmental changes. This study assesses the spatial and temporal mobility patterns in response to flood events in Lagos State, Nigeria, a region prone to severe flooding due to its low-lying topography and rapid urbanization. By integrating human mobility and geospatial data, the study analyzes the correlation between flooding and POI visits using the Maximum Information Coefficient (MIC) and Difference-in-Differences (DiD) models. Results indicate significant variations across POI categories, with increased visits to Healthcare & Medical services reflecting emergency needs, while Transportation and Outdoor Recreation experience declines, highlighting the negative impact on general mobility and economic activities. The findings underscore the importance of targeted urban planning and policy interventions to mitigate the effects of urban flooding on communities.},
  keywords={Microwave integrated circuits;Correlation;Urban planning;Transportation;Medical services;Disaster management;Surfaces;Floods;Socioeconomics;Sustainable development;Urban flood;Human mobility;Point of interest;Maximum Information Coefficient;Difference in Difference},
  doi={10.1109/GHTC62424.2024.10771563},
  ISSN={2473-5728},
  month={Oct},}@INPROCEEDINGS{9428853,
  author={Ogu, Reginald E. and Uzoechi, Lazarus O. and Mshelia, Yusuf U. and Erike, Izuchukwu Azubuike and Okoronkwo, Chinomso D.},
  booktitle={2020 IEEE 2nd International Conference on Cyberspac (CYBER NIGERIA)}, 
  title={Applicability of Distributed IoT-powered Triage Units in the Management of Infectious Diseases in Developing Countries: The COVID-19 case}, 
  year={2021},
  volume={},
  number={},
  pages={11-15},
  abstract={Medical pandemics disrupt human activities and threaten the existence of man. Oftentimes, health care delivery services and personnel become overwhelmed by health interventions in the context of pandemics. Currently, the COVID-19 respiratory health pandemic has troubled the world economy. This paper presents the Phase One of a health care delivery architecture based on the Internet of Things $(\mathbf{IoT})$ technology. The architecture proposed herein comprises of three layers: physical, communication and cloud. The architecture considered the peculiarity of developing countries like Nigeria, where there is inadequate electricity and limited communication bandwidth with poor Quality of Services $(\mathbf{QoS})$ of the Internet. The $\mathbf{IoT}$ triage architectural model developed in this work aims to address priority on assignment of the limited health facilities such as bed spaces, ventilators, medical professionals, etc., based on comparative analytics on vital health signals updates from $\mathbf{IoT}$ devices of patients. In this work, much emphasis is placed on the physical layer of the architecture. By this, a use case diagram for the physical triage outfit is developed in addition to the architecture. It is expected that the proper implementation of this architecture in health care delivery services across the globe will go a long in managing and minimizing the effects of pandemics like the COVID-19.},
  keywords={COVID-19;Ventilators;Protocols;Pandemics;Medical services;Quality of service;Developing countries;automation;distributed databases;Network architecture;public healthcare;wireless application protocols},
  doi={10.1109/CYBERNIGERIA51635.2021.9428853},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11592198,
  author={Njoku, Donatus O. and Osuji, Chizaramekpere and Okoroji, Bliss C. and Ezeji, Chiagoziem and Ofoegbu, Christopher I. and Iwuchukwu, Vitalis C.},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={IoT Enabled Smart Energy Management System for Rural Connectivity in Sub-Saharan African Communities}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Access to reliable electricity remains a significant barrier to socio-economic development and digital connectivity across rural Sub-Saharan Africa. Conventional power solutions are often unreliable, expensive, and lack the real-time intelligence necessary for optimized resource allocation. This paper addresses this challenge by proposing the design and simulation of an IoT-enabled smart energy management system tailored for resource-constrained environments, utilizing Eziobodo Village in Owerri West, Nigeria, as a key case study. The proposed solution involves a hybrid solar PV microgrid integrated with a smart transfer and monitoring architecture. The methodology relies on comprehensive microgrid modeling using Simulink with opensource solar and load data, coupled with the development of an IoT framework that enables smart metering, remote prioritization, and demand response. Key simulation results indicate that the optimized management system achieves an efficiency improvement of approximately 45% to 60% in hybrid system operation, significantly reducing the Levelized Cost of Energy (LCOE) and drastically improving load-served reliability, thereby providing a stable platform to power essential connectivity loads. This work offers a scalable, costeffective template for deploying resilient energy infrastructure that directly enables digital inclusion and sustainable development across similar underserved African communities.},
  keywords={Internet of Things;Loading;Energy;Modeling;Batteries;Simulation;Renewable energy sources;Monitoring;Timing;Generators;smart energy management;IoT;microgrid;renewable energy;rural electrification;Eziobodo village},
  doi={10.1109/CTUS-EMEA68989.2025.11592198},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11473756,
  author={Le, Cuong and Ngoc, Duc Pham},
  booktitle={2025 Asia Meeting on Environment and Electrical Engineering (EEE-AM)}, 
  title={Smart Schools in the Context of Industry 4.0: Potentials, Challenges and Roadmap}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The emergence of Industry 4.0 has transformed education through digitalization, artificial intelligence (AI), Internet of Things (IoT), and cloud-based systems. Smart schools represent a paradigm shift from traditional education to technology-driven, learner-centered ecosystems that integrate pedagogy, content, and digital infrastructure. This paper systematically reviews international smart school implementations using PRISMA methodology, explores theoretical lenses including TPACK (Technological Pedagogical Content Knowledge) and TAM (Technology Acceptance Model), and highlights the role of AI cameras in ensuring safety, personalization, and real-time assessment. Comparative findings from Nigeria, Iran, Malaysia, Finland, Australia, and the United States (US) demonstrate achievements in personalized learning, digital literacy, and STEM preparedness, but also reveal challenges of inequity, infrastructure gaps, teacher resistance, and sustainability. The paper concludes with a roadmap toward AI-enabled, inclusive, and sustainable smart schools, aligning with the Sustainable Development Goals (SDGs).},
  keywords={Feedback;Circuits;Information and communication technology;Internet of Things;Internet;Communication systems;Communications technology;Protocols;HTTP;Interoperability;Smart Schools;Industry 4.0;AI in Education;PRISMA;TPACK;TAM;Green ICT;Sustainability;Comparative Analysis},
  doi={10.1109/EEE-AM66675.2025.11473756},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11089631,
  author={Anjanamma, C. and Jyotsna, K.A. and Sravani, B. and Shilpa, K. and Narayana, C V Lakshmi and S, Kanakaprabha.},
  booktitle={2025 6th International Conference on Inventive Research in Computing Applications (ICIRCA)}, 
  title={Predicting Childhood Anemia Prevalence with Machine Learning: Evidence from Global Nutritional Data}, 
  year={2025},
  volume={},
  number={},
  pages={1459-1463},
  abstract={This study develops a predictive framework for childhood anemia prevalence among children aged 6-59 months through machine learning approaches applied to global nutritional data. Analyzing 4,080 observations across multiple countries and time periods, we compared Linear Regression, Random Forest, and Gradient Boosting algorithms to identify optimal predictive models and key determinants. Historical prevalence data emerged as the strongest predictor, with one-year and two-year lagged values demonstrating coefficients approximately ten times larger than any other feature. Linear Regression outperformed more complex algorithms, suggesting that anemia prevalence follows relatively stable temporal patterns. Global prevalence exhibited a steady decline from 39.9% in 2000 to 33.7% in 2019, while significant disparities persist between high-burden nations (Nigeria: 68.9%, India: 53.4%) and low-burden countries (United States: 6.1%). Regional variables contributed minimally to predictive power, indicating that country-specific factors dominate over geographic determinants. These findings underscore the persistent nature of childhood anemia and the importance of tailored, country-specific interventions in high-burden regions. The predictive methodology developed provides a valuable tool for forecasting trends, identifying at-risk populations, and evaluating potential intervention impacts.},
  keywords={Pediatrics;Machine learning algorithms;Anemia;Linear regression;Predictive models;Prediction algorithms;Market research;Approximation algorithms;Trajectory;Random forests;Anemia Prediction;Child Nutrition;Machine Learning;Global Health;Nutritional Epidemiology;Feature Importance Analysis},
  doi={10.1109/ICIRCA65293.2025.11089631},
  ISSN={},
  month={June},}@INPROCEEDINGS{7147542,
  author={Kiboro, Angelica and Bailey, Sheena and Nair, Mrinay and Salam, Tomisin and Dwhytie, Alex},
  booktitle={2014 IEEE Canada International Humanitarian Technology Conference - (IHTC)}, 
  title={Providing access to education in Sub-Saharan countries through Content-Oriented technology}, 
  year={2014},
  volume={},
  number={},
  pages={1-4},
  abstract={Access to education has been a growing concern for children in developing economies, namely lack of access to quality customized online content in the classroom and at home; lack of tools that make learning fun and effective in key subject areas; and lack of state resources to meet educational demands. The Rumie Initiative was founded to tackle these concerns. It is a non-profit organization bringing educational content to the world's underprivileged children through low-cost technology. The Rumie Initiative's vision is to redefine the way education is provided, and through this, significantly reduce poverty and drive economic development. The primary advantage of The Rumie Initiative over all other educational technology solutions is that its content is specifically tailored to meet the local educational needs and curriculum standards. Utilizing the vast reserves of free online updated educational content available today; these android driven tablets are an affordable and intuitive way to deliver pre-loaded content without the requirement of internet access. Through mass global volunteerism, The Rumie Initiative collaborates with educators in choosing appropriate educational content and distributes content-loaded tablets through local Non-Governmental Organizations, communities and government entities. The Rumie Initiative has started a program of trials around the world and recently received a positive response at a Computer - Based Math Education Summit in New York hosted by UNICEF from November 21st to 22nd 2013. The initiative was first launched in Haiti on 25th October 2013 and has since, been gaining momentum, currently exploring opportunities in Sub-Saharan countries such as Ghana, Kenya, Uganda, Rwanda, Burundi, South Africa and Nigeria. This paper focuses on The Rumie Initiative's unique business model to reach the masses, emphasizing issues relating to the power of volunteer ism, the forging of strategic development partners, and content-oriented technologies in increasing access to education.},
  keywords={Monitoring;Organizations;Communities;Terminology;Education;Servers;Blogs},
  doi={10.1109/IHTC.2014.7147542},
  ISSN={},
  month={June},}@INPROCEEDINGS{10926953,
  author={Ajayi, Sunday Thomas and Oludele Ojediran, Jeremiah and Ighravwe, Desmond Eseoghene and Akanni Olanrewaju, Oludolapo and Etangetuk, Asukwu Enediabasi and Omijie, Eloho},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Economic Analysis of Agro-product: a Supply Chain Management in Rural communities}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Green supply chain management (GSCM) has been identified as a strategy for addressing food security. Hence, this research aimed to implement a multi-criteria decision-making (MCDM) framework for the Agro-products subset of GSCM. This research objective addresses the issue of evaluating economic criteria parameters for green supply chain management for an Agro-business, through a developed multi-criteria decision framework. This research considered five Agro-products (poultry products, meat, fruits, fish, and vegetables) in the three major selected markets (Mowe-Ibafo, Arigbajo-Ifo, and Agbara-Lusada) in Ogun state, Nigeria. The economic parameters that affect Agro-products management was evaluated using a fuzzy entropy method (FEM). VIKOR model was introduced to assess the criteria's importance. VIKOR outputs indicated that meat and vegetable products are most important based on the fact that experts' opinions are the same in cases I, II, and III. Poultry products and meat are the second most important as the expert's views are the same in cases II, III, and I, II respectively. However, fish product was the least important as there was no agreement between the expert's opinions in the three cases. The information from this study is important for stakeholders in MCDM for Agro-products.},
  keywords={Economics;Supply chain management;Green products;Decision making;Fish;Entropy;Finite element analysis;Stakeholders;Sustainable development;Investment;Green supply chain management;Sustainable supply chain management;Sustainable Development;Environmental sustainability},
  doi={10.1109/NIGERCON62786.2024.10926953},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{11572949,
  author={Alshannag, Fadi Mohammed},
  booktitle={2026 International Conference on Artificial Intelligence for Sustainable Engineering and Innovation (AISEI)}, 
  title={Cyber Security Challenges in Digital Banking: Perspectives from Financial Institutions and Customers}, 
  year={2026},
  volume={},
  number={},
  pages={755-761},
  abstract={The fast development of online banking has transformed how individuals conduct and consume financial services. It has simplified the banking process, making it quicker and accessible to virtually anyone. Nevertheless, this advancement has also generated other issues, particularly cybersecurity threats. The security of online banking is currently one of the largest concerns of banks and their clients. Cybersecurity is now a global issue of concern due to the emergence of threats such as phishing, malware, and identity theft, the high regulatory demands, and the high standards of controls. This study examines how financial institutions as well as customers manage these risks based on examples in Nigeria, India, and the European Union. A comparative case study approach is employed using secondary data in the study. The results indicate that although customers are increasingly conscious of online threats, many of them do not practice safe measures to mitigate them, such as using weak passwords or not performing necessary system upgrades. Conversely, banks have gone a step further and invested in encryption and multi-factor authentication, as well as adhering to international security standards. Nevertheless, they still have problems such as outdated systems, insider threats, and customer ignorance. The research concludes that cybersecurity gaps exist due to the lack of complete alignment between customer behavior and institutional safeguards. To address this, it proposes enhancing digital literacy, adopting more contemporary security models, promoting greater openness in communication, and encouraging stronger collaboration between regulators, banks, and customers.},
  keywords={Banking;Computer security;Security;Printing;Fraud;Regulation;Modeling;Privacy;Online banking;Phishing;Fintech;Cyber Security;Behavioral Awareness;Financial Technology;Digital Banking},
  doi={10.1109/AISEI68628.2026.11572949},
  ISSN={},
  month={April},}@INPROCEEDINGS{11135889,
  author={Folarin, Oluwatimilehin and Ogunyemi, Mary and Omoare, Gods’Favour},
  booktitle={2025 International Conference on Communication, Computing, Networking, and Control in Cyber-Physical Systems (CCNCPS)}, 
  title={Off-Grid Lighting System for Rural Communities Using Renewable Energy, IoT, and Recyclable Materials}, 
  year={2025},
  volume={},
  number={},
  pages={349-354},
  abstract={Limited energy access is a major driver of multidimensional poverty in underdeveloped and developing nations, hindering economic productivity and overall development. Addressing energy deficiencies can significantly improve living standards and create growth opportunities, as the absence of a reliable power supply stifles advancement in activities that rely on power generation for lighting, cooling, or manufacturing. In response to these challenges, this study explores readily accessible recyclable materials-plastic bottles to promote clean energy. It introduces an innovation that illuminates homes in rural communities using natural light, solar energy, and stored energy. During the day, sunlight refracts through the water-filled bottle, providing natural lighting in the houses. At night, a 5000mAh lithium-ion battery, powered by a 3V solar panel, lights the home via a 2-watt LED bulb for up to 10 hours. This system can reduce energy consumption by up to 80% compared to traditional bulbs typically used in homes. In addition, the lithium-ion battery has a 10-year operational lifespan, while the solar panel has a lifespan of 5 years, contributing to the overall longevity. Early pilot tests show that this solution has the potential to provide sustainable, affordable lighting to over 600,000 households in South-West Nigeria, presenting a scalable and cost-effective model for rural electrification. By reducing reliance on fossil fuels and providing off-grid lighting, this study aligns directly with Sustainable Development Goals (SDGs) 7 (Affordable and Clean Energy) and 13 (Climate Action), offering an environmentally responsible and economically feasible solution for residents of rural communities and beyond.},
  keywords={Green energy;Lithium-ion batteries;YOLO;Lighting;Electrification;Light emitting diodes;Telecommunication computing;Solar panels;Plastic products;Sustainable development;Off-Grid Lighting;Clean Energy;Energy Optimization;Rural Electrification;Sustainability},
  doi={10.1109/CCNCPS66785.2025.11135889},
  ISSN={},
  month={June},}@INPROCEEDINGS{9692419,
  author={Bala, Jibril A. and Adeshina, Steve A. and Aibinu, Abiodun M.},
  booktitle={2021 1st International Conference on Multidisciplinary Engineering and Applied Science (ICMEAS)}, 
  title={Conceptual Design of an Autonomous Vehicle for Road Anomaly Detection and Manoeuvring}, 
  year={2021},
  volume={},
  number={},
  pages={1-7},
  abstract={The decaying road infrastructure in Nigeria raises the need for autonomous vehicles capable of detecting and navigating road anomalies. Existing control schemes for navigation are unsuitable for implementation due to the unstructured and dynamic nature of the environment. Due to the aforementioned factors, this paper presents a conceptual design of an autonomous vehicle for road anomaly detection and navigation. The vehicle utilizes a computer vision scheme based on Convolutional Neural Networks (CNN) for road anomaly detection and Model Predictive Control (MPC) for manoeuvring. The implementation of a vehicle prototype with remote monitoring and control capabilities is also presented in this paper. The implementation of this will provide an efficient scheme for road anomaly detection and manoeuvring in autonomous vehicles.},
  keywords={Computer vision;Navigation;Roads;Surveillance;Convolutional neural networks;Vehicle dynamics;Anomaly detection;Autonomous Vehicles;Computer Vision;Model Predictive Control;Road Anomaly Detection;Vehicle Navigation},
  doi={10.1109/ICMEAS52683.2021.9692419},
  ISSN={},
  month={July},}@INPROCEEDINGS{8417347,
  author={Uzoka, Faith-Michael E. and Akinnuwesi, Boluwaji Ade and Amoo, Taiwo and Debele, Fikru and Fashoto, Gbenga and Nwafor-Okoli, Chinyere},
  booktitle={2018 IST-Africa Week Conference (IST-Africa)}, 
  title={An Expert System for Malaria Diagnosis using the Fuzzy Cognitive Map Engine}, 
  year={2018},
  volume={},
  number={},
  pages={1-13},
  abstract={The complexity of malaria diagnosis increases because of symptom manifestation that could be confused with other tropical diseases and the fuzziness associated with patients' expression of their health conditions. There is a need for appropriate diagnostic tools that would assist the physician (or other trained medical personnel) in the differential diagnosis of malaria and other tropical diseases. In this paper, we present an initial result of an effort to develop a fuzzy cognitive map (FCM) system for the diagnosis of malaria. Concepts and their causality were defined based on the experiential knowledge from 30 physicians in 3 hospitals in Nigeria, who served as knowledge sources for this study. The semantic relationships among concepts were utilized in constructing an FCM model for malaria diagnosis, which was further integrated into a decision support engine (DSE). The comparative summary showed that the initial hypotheses (IH) by the physicians correctly matched the final diagnosis in 55% of the cases, whereas the accurate diagnosis (AD) of the FCM was 85%. This result is interesting; further analysis using Kendall's tau_b and the Spearman's rank order test also indicated a higher (though equally significant) correlation between the FCM results and AD than between IH and AD. The correlation between the physician's initial hypothesis and the FCM diagnosis was not significant.},
  keywords={Diseases;Medical diagnostic imaging;Decision support systems;Medical diagnosis;Engines;Uncertainty;fuzzy cognitive map;malaria;diagnosis;medical decision support system;tropical diseases},
  doi={},
  ISSN={2576-8581},
  month={May},}@INPROCEEDINGS{5275539,
  author={Momoh, James A. and Gaunt, C. Trevor and Onohaebi, Sunny},
  booktitle={2009 IEEE Power & Energy Society General Meeting}, 
  title={Engineering research and education in power system voltage stability enhancement}, 
  year={2009},
  volume={},
  number={},
  pages={1-11},
  abstract={Research in areas of voltage stability monitoring, assessment and control of power systems is an ongoing international activity at Howard University. The research engineering development involves real-time system parameters to compute a Voltage Stability Index (VSI) and margin, and provide advanced control schemes to mitigate the Voltage/Var problems. The strategy is based on the use of advanced measurement technologies to lay the foundations for applications of advanced optimization methods such as hybrid Fuzzy Logic Adaptive Dynamic Programming based controllers for VSI control and coordination. Thus far, the related international activities of our research and education work involve Howard University, University of Benin (Uniben) in Nigeria, and University of Cape Town (UCT) in South Africa (SA). Our research has developed understanding of real-time VSI using but not limited to practical power utility test data system models from both African countries.},
  keywords={Power system stability;Power engineering and energy;Power engineering education;Systems engineering education;Power system control;Voltage control;Control systems;Real time systems;Control engineering education;Monitoring;voltage stability;power systems},
  doi={10.1109/PES.2009.5275539},
  ISSN={1932-5517},
  month={July},}@INPROCEEDINGS{10944446,
  author={Ani, Ozoemena and Odo, Matthew Chinedu and Chidubem Maduagwu, Valentine and Ikebude, Victor Onyekachi and Davies-Ogbodo, Ebube and Oguine, Nonso Evans},
  booktitle={2025 33rd Southern African Universities Power Engineering Conference (SAUPEC)}, 
  title={Comparative Energy and Economic Analysis of Hyundai Kona EV with Toyota Corolla ICE Vehicle}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This work focused on a comparative energy and economic analysis of a Hyundai Kona EV and Toyota Corolla 2008 model. The study involved a monitored driving experiment from the NADDC solar EV charging station at the University of Nigeria Nsukka to its main gate at Nru junction, a distance of about 4km. The EV was driven from the charging station to the main gate and back at moderate speed; first with the car AC turned on at a low mode and second with the car AC turned off. Toyota Corolla was equally driven from the charging station to the gate and back at moderate speed and with AC turned off. The trip was repeated two times for each case for both cars. Parameters measured or determined for the experiments included time, distance, fuel/energy consumed. Results revealed that, for the same round trip of about 8 kilometers, without AC turned on, the Hyundai Kona consumed approximately 1.024 kWh of energy, costing 230.4 Naira. While with the AC turned on, at low mode, the Hyundai Kona consumed 1.056kWh of energy costing 237.6 Naira. On the other hand, the Toyota Corolla consumed about 7.78 kWh, costing 1750.5 Naira. The analysis of all the trips revealed that the energy discharge rate of the EV is influenced by various factors, including ambient temperature, vehicle weight, driving style, regenerative braking, activated devices or components, and electrical power losses. Based on analysis, it may be deduced that if the dashboard indicates a range of 500 kilometres at full charge, the EV is capable of covering a minimum actual distance of 396.9km when used without AC and 357km when used with AC under typical driving conditions. Also, the 15kW capacity solar EV charging station can only sustainably support charging one type of Hyundai Kona EV per day given normal sunny day.},
  keywords={Hands;Temperature sensors;Temperature measurement;Analytical models;Costing;Logic gates;Charging stations;Time measurement;Electric vehicle charging;Automobiles;Electric vehicle;Hyundai Kona;Toyota Corolla;Comparative analysis;Energy/economic analysis},
  doi={10.1109/SAUPEC65723.2025.10944446},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11592093,
  author={Ibrahim, Salihu Dausu and Eronu, Emmanuel Majiyebo and Sanni, Aliyu Ozovehe and Uthman, Muhammad},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={Hybrid SVR-Based Short-Term Spectrum Interference Forecasting: A 12-Month Predictive Framework for FM Broadcast Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Unlicensed FM broadcasting in spectrum-congested urban environments poses significant regulatory challenges, with traditional reactive monitoring approaches offering limited enforcement effectiveness. This paper presents a hybrid Support Vector Regression (SVR) framework for 12-month forecasting of FM spectrum interference events using four years (2021-2024) of monitoring data from Nigeria’s VHF Band II ($\mathbf{8 7. 5 - 1 0 8 ~ M H z}$). The framework constructs temporally aggregated features, including moving averages of band occupancy, multiplex overshoot trends, and historical violation counts. The $\varepsilon$-insensitive SVR model, optimized through rolling-window cross-validation, achieves RMSE of 0.087 and MAE of 0.063, outperforming ARIMA (RMSE: 0.142) and exponential smoothing (RMSE: 0.156) by $38.7 \%$ and $44.2 \%$ respectively. Sensitivity analysis reveals $\mathbf{3 0}$-day lookback windows optimize forecast accuracy while maintaining computational efficiency (8.3-second training time). Validation against 2024 regulatory records demonstrates $\mathbf{9 4. 3 \%}$ temporal alignment with an 11.3-day mean forecast lead time, enabling proactive enforcement that reduces response delays by $62 \%$. The framework provides regulatory bodies with actionable predictive intelligence for transitioning from reactive detection to proactive spectrum governance.},
  keywords={Forecasting;Interference;Modeling;Broadcasting;Printing;Timing;Windows;Training;Equations;Monitoring;Spectrum forecasting;support vector regression;broadcast monitoring;temporal feature engineering},
  doi={10.1109/CTUS-EMEA68989.2025.11592093},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11651618,
  author={Lukito, Kentza Louisandria and Putra, Joshua Loda Cahyo and Saputra, Gilbert Winda and Putra, R. Aditya Kristamtomo and Wiputra, Richard},
  booktitle={2026 IEEE 5th International Conference on Information Technology, Big Data and Artificial Intelligence (ICIBA)}, 
  title={Comparative Analysis of CBDC Technology Governance and Architecture: Implications for Indonesia's Project Garuda}, 
  year={2026},
  volume={5},
  number={},
  pages={1109-1115},
  abstract={This study compares the governance infrastructure and technological architecture of Central Bank Digital Currency (CBDC) programs in nine countries (China, India, Nigeria, the Bahamas, Jamaica, Thailand, Singapore, Brazil, and Sweden), representing the proof-of-concept, pilot, and launch stages of implementation. Using several comparative research case study methodologies starting from three levels, namely horizontal, vertical, and transversal, this study identified three main findings: (1) eight of the nine relevant countries chose a two-tier distribution model, but differed in the selection of technology platforms, (2) the technology on permissioned DLT showed structural limitations to deal with retail transactions on a national scale, so that the four countries independently moved to hybrid or centralized architectures, and (3) the third-party cooperation mechanism appears to be a result of stronger adoption than the technical sophistication of the technology, as evidenced by the failed adoption of the three launched CBDCs that have been launched, which is inversely proportional to the scale of China's e-CNY technology through the integration of the existing payment ecosystem, from the results of the five recommendations that can be followed up on to be proposed as the Garuda Project, the implementation of a two-layer wholesale-retail architecture, the integration of the QRIS ecosystem, and an incentive mechanism from third parties, commonly called the Intermediate State phase.},
  keywords={Banking;Distributed ledger;Technology;Architecture;Computer architecture;Printing;Programming;Modeling;Design methodology;Electromagnetic launching;central bank digital currency;distributed ledger technology;governance architecture;technology architecture;Project Garuda;comparative case study},
  doi={10.1109/ICIBA68339.2026.11651618},
  ISSN={},
  month={June},}@ARTICLE{1705768,
  author={Blau, J.},
  journal={IEEE Spectrum}, 
  title={Talk Is Cheap}, 
  year={2006},
  volume={43},
  number={10},
  pages={14-15},
  abstract={The first-generation of low-cost handsets are now being delivered in developing countries such as Bangladesh, India, Nigeria and Yemen. These supercheap phones have been stripped of everything except simple telephony and text messaging functions and feature single-chip designs, slimmed down software and price tags of US $40 and lower. Handset manufacturers believe that it is their social responsibility to connect many of the less fortunate of the world at a price they can afford. At the same time, they see new opportunities in these less-developed regions as they struggle to expand in the heavily saturated advanced industrial markets},
  keywords={Databases;Voting;Nominations and elections;Costs;Mobile handsets;Information systems;Vehicles;Automotive engineering;Data engineering;Guidelines},
  doi={10.1109/MSPEC.2006.1705768},
  ISSN={1939-9340},
  month={Oct},}
