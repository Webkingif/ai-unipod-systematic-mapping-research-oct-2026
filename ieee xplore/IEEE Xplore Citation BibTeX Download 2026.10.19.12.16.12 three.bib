@INPROCEEDINGS{10379355,
  author={Alozie, Emmanuel and Faruk, Nasir and Abdulkarim, Abubakar and Usman, Aliyu D. and Olayinka Imam-Fulani, Yusuf and Garba, Salisu and Adewole, Kayode S. and Oloyede, Abdulkarim A. and Sowande, Olugbenga A. and Abdullahi Baba, Bashir and Musa, Abdulwaheed and Imoize, Agbotiname Lucky and Adediran, Yinusa A. and Olagunju, Hawau I. and Taura, Lawan S.},
  booktitle={2023 2nd International Conference on Multidisciplinary Engineering and Applied Science (ICMEAS)}, 
  title={Signal Attenuation Modeling and Simulation for 5G and Beyond P2P Wireless Communication Networks in FR2 Bands: Comparison within M-Region in Nigeria}, 
  year={2023},
  volume={1},
  number={},
  pages={1-5},
  abstract={ITU-R categorized Nigeria into four rain regions (i.e., M, N, P, and Q) depending on the atmospheric conditions. Previous works that have conducted rain and attenuation modeling and simulations have assumed similar signal propagation behavior and parameters within locations categorized under the same region. This paper aims to explore these assumptions by conducting an extensive radio propagation simulations of point-to-point microwave links with a clear line-of-sight in order to estimate the total path loss (attenuation), excess path loss, and flat fade margins for each of the locations within the M-regions, i.e., Kano, Sokoto, and Adamawa. Results obtained showed that in all the locations, the loss monotonically increases with distance, with Sokoto having the highest level of signal losses and fading, while, Adamawa has the lowest. The deviation for both total loss, excess loss, and flat fading margin was found to be between 15 dB across the region.},
  keywords={Fading channels;Wireless communication;Rain;Atmospheric modeling;Simulation;Radio propagation;Attenuation;Total loss;FR2 band;EDX;LOS;Excess Loss;ITU-R},
  doi={10.1109/ICMEAS58693.2023.10379355},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{6271354,
  author={Musa, A. A. and Bashir, S. O. and Islam, Md Rafiqul and Khalifa, Othman O.},
  booktitle={2012 International Conference on Computer and Communication Engineering (ICCCE)}, 
  title={Dust-storm induced cross-polarization at MMW dands in Northern Nigeria}, 
  year={2012},
  volume={},
  number={},
  pages={936-940},
  abstract={Sand and Dust storms have the potentiality of causing microwave degradation for substantial percentage of time which can lead to drop in the availability and quality of services rendered by communication systems. This paper investigates induced cross-polarization by dust storms at MMW bands. It introduces a model factor to calculate phase shift and attenuation which are to be used as inputs to cross-polarization discrimination (XPD) computation. A parametric analysis of sand and dust storm in northern Nigeria was carried out and its effect on MMW band propagation.},
  keywords={Storms;Attenuation;Permittivity;Microwave propagation;Rain;Cities and towns;Probability;worst-month propagation statistics;differential phase shift;differential attenuation;cross-polarisation;dust storms},
  doi={10.1109/ICCCE.2012.6271354},
  ISSN={},
  month={July},}@INPROCEEDINGS{11277817,
  author={Babalola, Kehinde Zacheaus and Elenga, Rolains Golchimard and Genovese, Paolo Vincenzo},
  booktitle={2025 5th International Conference on Electrical, Computer, Communications and Mechatronics Engineering (ICECCME)}, 
  title={SWOT analysis approach for renewable energy production in Sub-Saharan African climate: case study of six geopolitical states of Nigeria}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Energy shortage has been a major challenge in SubSaharan African (SSA) regions. This study adopts a holistic approach of combining the numerical simulation tool HOMER and the Strengths, Weaknesses, Opportunities, Threats (SWOT) analytic tool to assess the development of solar energy generation and its storage for electricity security in six geopolitical zones in Nigeria. The HOMER model evaluated the techno-economic feasibility of solar-based hybrid systems, while the SWOT analysis was informed by secondary data sources, including national energy policy documents, and reports from international agencies. SWOT criteria were categorized according to their internal or external influence on renewable energy deployment, with a focus on economic, technical, political, and social dimensions. The numerical findings showed that the North-West and North-East recorded the lowest cost of energy (COE) and net present cost (NPC) estimated at ${\$}$ $0.6149 / \mathrm{kWh}$ - ${\$}$ $0.6213 / \mathrm{kWh}$ and ${\$}$ $36,087.99$ - ${\$}$ $36,466.08$ respectively, followed by North-central with a COE of ${\$}$ $0.7577 / \mathrm{kWh}$ and NPC of ${\$}$ $44,467.81$, South-West (COE: ${\$}$ $0.8289 / \mathrm{kWh}$, NPC: ${\$}$ $48,639.09$), South-East (COE: ${\$}$ $0.8494 / \mathrm{kWh}$, NPC: ${\$}$ $49,849.17$), and South-South (COE: ${\$}$ $0.9165 / \mathrm{kWh}, \mathrm{NPC}$: ${\$}$ 53,787.57). The SWOT analysis highlighted opportunities in lowemission transitions, weaknesses such as high component costs and lack of skills, as well as potential threats such as insurgency and unknown gunmen around the nation’s energy landscape. Finally, a sensitivity analysis was conducted to evaluate the impact of variation in key system parameters, including solar radiation and battery replacement costs on the cost of energy.},
  keywords={Renewable energy sources;Costs;Stability criteria;Solar energy;Production;Numerical simulation;Vocational training;Security;Solar radiation;Standards;Renewable Energy Systems;Solar Energy;Optimization;SWOT Analysis;Nigeria},
  doi={10.1109/ICECCME64568.2025.11277817},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9692282,
  author={Abubakar, A. and Bashir, A. W. and Almeida, C. F. M. and Leite, B. C. C. and Gemignani, M.},
  booktitle={CIRED 2021 - The 26th International Conference and Exhibition on Electricity Distribution}, 
  title={DESIGNING ENERGY-EFFICIENT RESIDENTIAL BUILDINGS FOR NIGERIA AND SUB-SAHARAN AFRICA CONSIDERING AEROGEL THERMAL INSULATION MATERIAL AND PHOTOVOLTAIC POWER GENERATION}, 
  year={2021},
  volume={2021},
  number={},
  pages={1930-1934},
  abstract={This paper presents the design of an energy-efficient and self-sufficient residential building for the typical weather in Nigeria and by extension sub-Saharan Africa (SSA), considering aerogel material and photovoltaic power generation. Firstly, a typical residential building design of the selected region is modelled using aerogel material to minimize the energy consumption of the building while also improving its thermal comfort. Then, an isolated photovoltaic system, with an optimally sized battery energy storage system (BESS), is incorporated to make the building energy self-sufficient. The proposal aims at tackling the extreme weather condition and the recurrent power outage of the region. The outcome of the designed system shows that the use of aerogel insulation material attained a 6% reduction in the recorded mean air and operative temperatures while also maintaining acceptable range of humidity. The use of aerogel also reduces energy consumption in the building by 11.7%. Also, incorporating a PV system with an optimally sized BESS tackles power shortage issue effectively, making the building energy self-sufficient.},
  keywords={},
  doi={10.1049/icp.2021.2094},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10051416,
  author={Boyinbode, Olutayo K. and Oyesanmi, Fiyinfoluwa G. and Obe, Olumide O. and Boyinbode, O.F.},
  booktitle={2022 5th Information Technology for Education and Development (ITED)}, 
  title={Implementation of Internet of Things for Structural Health Monitoring in Nigeria}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={The lingering cases of building collapse in Nigeria and the attending rate of mortality call for urgent attention. Advances in Internet of Things (IoT) technology can be leveraged to facilitate the autonomous monitoring of buildings. In this paper, an IoT model was implemented using piezo electronic transducers and programmable microcontrollers to monitor structural health as well as a warning system to notify users when structural integrity becomes threatened. The data obtained from the sensors are stored on the cloud and can be used to develop a robust building information system.},
  keywords={Cloud computing;Microcontrollers;Buildings;Sensor systems;Web servers;Sensors;Safety;IoT;structural health monitoring;public safety;structural collapse},
  doi={10.1109/ITED56637.2022.10051416},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10884312,
  author={Rai, Anand Kumar and Jaiswal, Siddharth D and Prakash, Shubham and Sree, Bendi Pragnya and Mukherjee, Animesh},
  booktitle={2024 IEEE International Conference on Knowledge Graph (ICKG)}, 
  title={DENOASR: Debiasing ASRs through Selective Denoising}, 
  year={2024},
  volume={},
  number={},
  pages={283-290},
  abstract={Automatic Speech Recognition (ASR) systems have been examined and shown to exhibit biases toward particular groups of individuals, influenced by factors such as demographic traits, accents, and speech styles. Noise can disproportionately impact speakers with certain accents, dialects, or speaking styles, leading to biased error rates. In this work we introduce a novel framework ${\mathcal{D}}{\mathcal{E}}{\mathcal{N}}{\mathcal{O}}{\mathcal{A}}{\mathcal{S}}{\mathcal{R}}$ which is a selective denoising technique to reduce the disparity in the word error rates between the two gender groups male and female. We find that a combination of two popular speech denoising techniques viz. DEmucs and Le can be effectively used to mitigate ASR disparity without compromising their overall performance. Experiments using two SOTA open-source ASRs - OpenAI Whisper and NVIDIA Nemo on multiple benchmark datasets - TIE, Vox-Populi, TedLium and Fleurs show that there is a promising reduction in the average word error rate gap across the two gender groups. For a given dataset, the denoising is selectively applied on speech samples having speech intelligibility below a certain threshold estimated using a small validation sample thus ameliorating the need for large-scale human written ground-truth transcripts. Our findings suggest that selective denoising can be an elegant approach to mitigate biases in present-day ASR systems.},
  keywords={Deep learning;Accuracy;Error analysis;Noise reduction;Noise;Knowledge graphs;Benchmark testing;Robustness;Real-time systems;Automatic speech recognition;debiasing;selective denoising;ASR;word error rate},
  doi={10.1109/ICKG63256.2024.00043},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10927347,
  author={Onifade, Morakinyo Kehinde and Osanyinpeju, Kifilideen Lekan and Jeremiah, Eshenake Rukemen},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Computer-Aided Design and Simulation of Keys and Splines for 0.5-Ton Capacity Trucks (Toyota Tacoma) Optimized for Nigerian Roads Conditions}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The manufacturing of keys and splines, crucial components in mechanical power transmission systems, has experienced significant growth. Various types of keys and splines have been developed using diverse techniques and procedures, influenced by factors such as application, reliability, lifespan, processing time, and manufacturing cost. Keys and splines facilitate the connection between hubs and shafts in power-transmitting devices, enabling efficient torque transmission and weight support, particularly vital for navigating challenging terrains like Nigeria roads. Existing key and spline designs may not adequately address the unique demands of Nigerian roads, potentially leading to premature failure and compromised performance. This study investigates the computer-aided design and simulation of keys and splines for 0.5-ton capacity trucks (Toyota Tacoma), tailored to Nigerian roads conditions. Utilizing Solid works models, computer-aided design and simulation were conducted. Static experimental testing analysed load-strain behaviour, while dynamic testing validated fatigue methods. Stress analysis was carried out to investigate high risk stress concentration locations and to examine the effects of spline teeth design on overall stress distribution was conducted. identified critical areas and evaluated the impact of spline teeth design on resulting stress. Maximum stress occurs at the root fillet of the splines’ drive sides. Uniform high stress distribution around the spline relief. Linear relationship between stresses and applied load with constant stress-to-load ratios. Contact stress distribution peaks at at the beginning of the face width. Analytical calculations and analysis confirm that the designed keys and splines demonstrates compactness, lightweight construction, and enhanced lifespan, rendering them suitable for Nigeria roads.},
  keywords={Shafts;Solid modeling;Design automation;Roads;Computational modeling;Object recognition;Splines (mathematics);Stress;Load modeling;Testing;Key and Spline Design;Computer Aided Design (CAD);Simulation;Nigerian Roads;Power Transmission Keys},
  doi={10.1109/NIGERCON62786.2024.10927347},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{10887912,
  author={Kim, Jaeyoung and Mavandadi, Sepand and Audhkhasi, Kartik and Bharadwaj, Shikhar and Farris, Brian and Chen, Tongzhou and Ramabhadran, Bhuvana and Ganapathy, Sriram},
  booktitle={ICASSP 2025 - 2025 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Identifying and Mitigating Mismatched Language Code in Multilingual ASR}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Multilingual speech recognition systems often use an input language code in order to prompt the transcription in the target language. However, the spoken language in the input audio may not always match the language code, as often prevalent in multilingual societies. This language mismatch can significantly reduce ASR quality. We present a technique to identify and mitigate this issue. We combine off-the-shelf language-ID and language verification models to determine the language code input to the ASR model. The language verification model acts as a gate that decides when to trust the provided language code or use the output of the language-ID model. We compare these approaches with baselines that include vanilla language-ID based and language-independent ASR models. Our experiments on YouTube, SPRING-INX and FLEURS datasets shows the efficacy of the proposed model especially in the mismatched language code setting.},
  keywords={Codes;Video on demand;Speech coding;Speech recognition;Predictive models;Signal processing;Logic gates;Multilingual;Web sites;Speech processing;multilingual speech recognition;language verification identification;language conditioning},
  doi={10.1109/ICASSP49660.2025.10887912},
  ISSN={2379-190X},
  month={April},}@INPROCEEDINGS{9988286,
  author={Lawal, Lasisi Salami and Aibinu, Abiodun Musa and Chris, Chatwin R. and Udoyen, Ubong and Iheanacho, Theddeus and Jaafar, Abdulrahaman and Ibrahim, Isa Ali},
  booktitle={2022 International Conference on Electrical, Computer, Communications and Mechatronics Engineering (ICECCME)}, 
  title={Overview of Satellite Communications and its Applications in Telemedicine for the underserved in Nigeria: A case study}, 
  year={2022},
  volume={},
  number={},
  pages={1-10},
  abstract={More than 2000 satellites currently relay communications signals to and fro various locations across the globe for Internet, Broadcasting, Telephony and Navigation and the number is expected to quadruple in the next few years due to the proliferation of Global N on-Geo Satellite Constellations. With the potential to connect people separated by great distances, satellites are now being applied in telemedicine to make healthcare cheaper and more accessible. Nigeria has not been left behind in these efforts and has deployed the NIGCOMSAT-1R Communications satellite to provide telemedicine services to patients with health issues. Internally displaced women and children are globally the worst hit by the unavailability of healthcare services, with 87% of deaths in internally displaced person (IDP) camps resulting from preventable illnesses. This presents a clear need for the adoption of telemedicine in IDP camps to provide Digital Health Inclusion services to the vulnerable citizens. We carried out a satellite-enabled telemedicine medical outreach at New Kuchingoro IDP camp in Abuja, Nigeria. A mobile application that allowed for text, audio, and video communication was employed using internet connectivity provided by the NIGCOMSAT-1R Communications Satellite. A total of 317 patients were attended to over the course of three days, and major issues prevalent in Nigerian hospitals, such as long waiting hours, were minimized. The medical outreach experience demonstrates the advantage of satellite broadband for telemedicine projects. It also proves the urgent need for innovative solutions for healthcare delivery in underserved and unserved Nigerian communities.},
  keywords={Satellite constellations;Pediatrics;Mechatronics;Telemedicine;Satellite broadcasting;Telephony;Electronic healthcare;Digital Health;Telemedicine;Satellite Communication;Internally Displaced Persons (IDPs);Mobile Health;Telecommunications},
  doi={10.1109/ICECCME55909.2022.9988286},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11592126,
  author={Imam-Fulani, Yusuf Olayinka and Usman, Aliyu D. and Tekanyi, Abdoulie M.S and Yaro, Abdulmalik S. and Abdulkarim, Abubakar and Faruk, Nasir and Agbon, E.E},
  booktitle={2025 IEEE Connecting the Unconnected Europe, Middle East, and Africa Regional Summit (CTUS-EMEA)}, 
  title={NIRAP 5G-FR1: A Regional-Adaptive Path Loss Model for 5G Sub-6 GHz Propagation in Nigeria}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Radio wave propagation is affected by diverse terrain and clutter conditions, making most existing path loss (PL) models highly inaccurate for local 5G planning. Existing models are limited in frequency and geographical scope. This paper presents the Nigeria Regional-Adaptive Propagation model for the FR1 band (NIRAP 5G-FR1), a novel adaptive PL model tailored for nationwide 5G Sub-6 GHz deployment. Large-scale simulations were conducted across 37 cities at 10 FR1 frequencies. A generic Close-In (CI) baseline model was developed, and six regionspecific Multiplicative Correction Factors (MCFs) were derived using Multiple Linear Regression to capture regional propagation characteristics. The resulting NIRAP 5G-FR1 model adaptively adjusts to regional conditions and demonstrates significantly improved prediction accuracy, with RMSE values within globally acceptable limits. The model offers a scalable, and environmentsensitive tool for accurate 5G network design and optimization.},
  keywords={Modeling;Equations;5G mobile communication;Distance measurement;Tagging;Frequency;Propagation;Printing;Urban areas;Transmitters;5G;Path Loss;FR1;Correction Factor;NIRAP-5G},
  doi={10.1109/CTUS-EMEA68989.2025.11592126},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{7991197,
  author={Melodi, A. O. and Momoh, J. A. and Oyinlola, A. O.},
  booktitle={2017 IEEE PES PowerAfrica}, 
  title={Transmission system reliability modeling and assessment for Nigerian electric grid}, 
  year={2017},
  volume={},
  number={},
  pages={40-45},
  abstract={This paper presents transmission grid reliability modeling and assessment that is critical to system reinforcement and expansion. This study explored an analytical approach for application on sub-Saharan African grids, which are fraught with effective expansion planning challenges or know-how. In this study, application of delivery point and system reliability concepts was explored and demonstrated, which involved using relatively known transmission system average interruption duration index (TSAIDI), transmission system average interruption frequency index (TSAIFI) and system average restoration index (SARI). These indices utilize temporal outage duration, outage frequency, and the grid's delivery points population data, which are obtained from system records and used to model the trends and values of TSAIDI, TSAIFI, and SARI for the observed period. Using these indicators in specific algorithm, options of effective long term grid expansion strategy are deducible, such as system lines or network regions requiring reinforcement for improved reliability of service delivery. In conclusion, this study established and demonstrated an effective algorithm for reliability assessment of sub-Saharan grids based on known system oriented indices.},
  keywords={Reliability;Power system reliability;Indexes;Mathematical model;Security;Sociology;Transmission grid;outage duration;outage frequency;delivery point reliability;system reliability;T-SAIDI;T-SAIFI;SARI},
  doi={10.1109/PowerAfrica.2017.7991197},
  ISSN={},
  month={June},}@INPROCEEDINGS{8905951,
  author={Mustapha, Adewusi Oladimeji and Victor, Omotosho Temidayo and Lola, Akinyemi Marvel and Eterigho, Emetere Moses and Sayo Akinloye, Akinwumi and Oluwafunmilayo Oluwayemisi, Ometan},
  booktitle={2019 6th International Conference on Space Science and Communication (IconSpace)}, 
  title={Modeling of Cloud Attenuation on Earth - Space Path in Ota Southwest Nigeria}, 
  year={2019},
  volume={},
  number={},
  pages={96-99},
  abstract={A new cloud attenuation model on earth-space path has been develop for a tropical station (6.7°N, 3.23°E) based on cloud cover, radiometric measurement and climatological data at the Covenant University in Ota. The collection of station data by a 7GHz spectrum analyzer for the total attenuation at elevation angle of 59.9° to Astra 2 satellites located at longitude 28.2°E. Automatic weather station parameters and daily visual clouds observation; as well as the acquisition of station radiosonde data were carried out. The station spectrum analyzer data between 2014 and 2017 were analyzed to obtain cloud attenuation contributions from the total attenuation measurement. The measured Cloud attenuation was compared with eight existing cloud attenuation models. Cloud attenuation at 12.245 GHz is 3.40 dB compare to 0.81 dB cloud attenuation predicted by ITU-RP 840 model, next is the Liebe's model, followed by Slobin model. A new developmental model was derived for the tropical station. The new cloud attenuation model was developed using the station radiosonde data from 1953-2011 for the computations of each cloud layer's liquid water content and specific attenuation coefficient. The cumulative distribution curves obtained was compared with each simulation distribution and the closest match to the station measured cumulative distribution is considered in the new cloud attenuation model for the station. The new model predicted 4.0 dB margins for clouds attenuation at 0.01% unavailability for the station. The study reveal cloud attenuation was under estimate by the eight existing cloud attenuation model for the tropical station.},
  keywords={Clouds;Attenuation;Mathematical model;Computational modeling;Data models;Atmospheric measurements;Attenuation measurement;clouds attenuation;satellite communication;cloud model;earth-space path;southwest Nigeria},
  doi={10.1109/IconSpace.2019.8905951},
  ISSN={2165-431X},
  month={July},}@INPROCEEDINGS{10779542,
  author={Yusuf, Salisu Ibrahim and Nabil, El Ioini and Yi Liao, Iman},
  booktitle={2024 IEEE SmartBlock4Africa}, 
  title={Evaluating the Potential Adoption of Blockchain and IoT in Nigeria's Oil and Gas Industry Sector: A Technology Acceptance Model Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Nigeria's oil and gas industry is a multi-billion-dollar sector with a complex network of businesses, that pre-dominantly rely on manual supply chain processes, hindering service efficiency. with many actors in the sector, there is a need for transparent and reliable operations and transactions between parties. Blockchain and IoT can be leveraged to ensure efficient interactions. This study evaluates the interest and potential adoption of blockchain and Internet of Things (IoT) technology in Nigeria's oil and gas sector through the Technology Acceptance Model (TAM). We surveyed key industry stakeholders, including regulatory agencies, academics, and truck drivers. Utilizing a null hypothesis methodology to analyze the data, our findings reveal a positive perception towards adopting blockchain and IoT technologies. This suggests that stakeholders and researchers should explore the potential of these technologies to enhance the sector.},
  keywords={Technology acceptance model;Oils;Supply chains;Gas industry;Blockchains;Stakeholders;Petroleum industry;Internet of Things;Reliability;Testing;Technology Acceptance Model (TAM);Blockchain;Internet of Things (IoT);Nigeria Oil and Gas Industry;Digital Transformation;Industry 4.0;Hypothesis Testing},
  doi={10.1109/SmartBlock4Africa61928.2024.10779542},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{8735650,
  author={Grever, Cooper and Kropp, Debora and Smith, Joshua and Monteleone, Tori},
  booktitle={2019 Systems and Information Engineering Design Symposium (SIEDS)}, 
  title={Railway Transportation Expansion and Resource Coverage Analysis in Nigeria}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={The Federal Republic of Nigeria has extensive natural resources and significant economic potential, but portions of the population suffer from poverty and lack of access to essential supplies, such as food and vaccines, due to geographic isolation. Railways offer a stable, practical method to transport resources over large distances. Railway infrastructure has also been shown to increase welfare of isolated communities and while the current railway network is limited in structure and technology, renewed government interest provides an opportunity to expand the current Nigerian railway. This paper describes the construction of a data-driven railway development map to increase coverage for the resource of interest, vaccines, to remote areas of Nigeria. A dataset of hundreds of potential city-hubs was evaluated and minimized based on coverage radius. Multiple railway networks were modeled to maximize coverage through both a minimum spanning tree and traveling salesman method while constrained by minimal distance. These models were then refined by applying nominal scoring to the city-hubs. To calculate scores, the significant factors for vaccination coverage were determined on a state-by-state basis by a stepwise regression. The coefficient values of the normalized significant factors were applied to city-hubs through nominal scoring based on their state and population. The expanded network and selected city-hubs were implemented into a geospatial map of Nigeria to provide a data-driven display for recommended railway expansions. The networks were further constrained by topographic obstacles and a forecasting model was developed based on population growth and the expanded railway. The methodology established in this project can be adapted to assist other developing countries facing similar challenges.},
  keywords={Rail transportation;Urban areas;Sociology;Statistics;Economics;Vaccines;Optimization;Railway Infrastructure;Resource Coverage;Regression Analysis;Geospatial Analysis},
  doi={10.1109/SIEDS.2019.8735650},
  ISSN={},
  month={April},}@INPROCEEDINGS{10630065,
  author={Atanda, Oladayo G. and Adebiyi, Marion O. and Omolaja, Oladunjoye O. and Akindeji, Kayode and Adebiyi, Ayodele A.},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={COVID-19 Disease Prediction System Using Genetic Algorithm (Case Study: Nigeria)}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={This research paper presents a COVID-19 disease prediction system designed specifically for Nigeria. The system combines the Genetic Algorithm (GA) approach with Support Vector Regression (SVR) models to improve the accuracy and efficiency of COVID-19 prediction models. The main objective is to enable early detection and effective management of COVID-19 cases. By integrating GA and SVR, the system optimizes feature selection and utilizes advanced regression techniques to forecast the likelihood of COVID-19 infection more accurately. The study utilizes a diverse dataset comprising COVID-19 cases reported in Nigeria. The dataset includes variables such as age, gender, comorbidities, symptoms, and geographic location. The effectiveness of the genetic algorithm-based prediction system is initially evaluated through rigorous assessment and comparison. Then, the SVR model is introduced as an alternative approach, and its performance is evaluated based on accuracy, sensitivity, and specificity. The results show that the genetic algorithm-based system achieves an impressive 100 percent accuracy in predicting the likelihood of COVID-19 infection. Upon integrating the SVR model, the accuracy slightly decreases to 97 percent. However, the SVR model demonstrates strong performance and exhibits promising potential for accurate prediction and early detection of COVID-19 cases. In conclusion, the COVID-19 disease prediction system developed using a combination of genetic algorithms and SVR models is a valuable tool for accurately predicting the likelihood of COVID-19 infection in Nigeria.},
  keywords={COVID-19;Training;Support vector machines;Accuracy;Predictive models;Vectors;Public healthcare;COVID-19;Machine Learning;Genetic Algorithm;Support Vector Regression},
  doi={10.1109/SEB4SDG60871.2024.10630065},
  ISSN={},
  month={April},}@INPROCEEDINGS{9803108,
  author={Dodo, Usman Alhaji and Ashigwuike, Evans Chinemezu and Emechebe, Jonas Nwachukwu},
  booktitle={2022 IEEE Nigeria 4th International Conference on Disruptive Technologies for Sustainable Development (NIGERCON)}, 
  title={Municipal Solid Waste Generation Forecast using an ARIMA Model: A Focus on Abuja City, Nigeria}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={In this paper, an autoregressive integrated moving average (ARIMA) model was used to forecast the municipal solid waste generation rates of Nigeria’s federal capital city, Abuja. The historical data used (January 2014 to December 2020) for the forecast were obtained from the Abuja Environmental Protection Board. A practical method of Box-Jenkins which includes four iterative sequences; stationarity check, model identification, estimation of parameters, and diagnostics were used for implementing the ARIMA models. The results indicate that an ARIMA (1, 1, 9) is the optimal model having outperformed other candidate models in terms of the adjusted determination coefficient and information criteria and hence, employed for forecasting the quantity of waste generation up to the year 2025. About 1,288,140 tons of municipal solid waste are expected to be generated from 2021 to 2025 in the city. It is hoped that this study will be useful for planning and developing an effective waste management system by the Federal Capital Territory Administration.},
  keywords={Waste management;Waste materials;Solid modeling;Urban areas;Estimation;Predictive models;Planning;ARIMA;Box-Jenkins;forecast;solid waste;stationarity},
  doi={10.1109/NIGERCON54645.2022.9803108},
  ISSN={2377-2697},
  month={April},}@INPROCEEDINGS{8928883,
  author={Airoboman, A. E and James, P. and Araga, I. A. and Wamdeo, C. L and Okakwu, I. K.},
  booktitle={2019 IEEE PES/IAS PowerAfrica}, 
  title={Contingency Analysis on the Nigerian Power Systems Network}, 
  year={2019},
  volume={},
  number={},
  pages={70-75},
  abstract={The purpose of contingency analysis in power system is for security analysis which is aimed at evaluating the power system and finding the overloads and problems that could impede on the system's performance. When the power system is in abnormal condition, due to contingency condition an entire system or part of the system become part of the congestion, and develop unexpected change on the loads. Contingencies offer tools for analyzing, creating, managing, and reporting list of contingencies and violations. In this paper, the Newton Raphson approach was adopted in performing the load flow, while the system was modeled in the Electrical Transient Analyzer Programme ETAP 12.6 in order to carry out the contingency analysis. The results from the load flow amongst others indicated that, line L4 and transformer T2A has the highest and lowest branch losses of 156.3 kW and 8.0 kW respectively. Further results from the Performance Index PI indicated that Kinkinau and Turuku feeders have the highest PI values of 7.36 respectively while under voltage was experienced by eight (8) feeders from the system's operating report. Finally, an overall system loss of 753.2 kW and 10437.3 KVAR was experienced by the network. The results of the study can therefore serve as a guide for system's operators and for the purpose of expansion planning.},
  keywords={Power system stability;Load flow;Mathematical model;Power transmission lines;Stability analysis;Load modeling;Bus;Contingency;Feeders;Load-flow;Network},
  doi={10.1109/PowerAfrica.2019.8928883},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{9078669,
  author={Airoboman, A.E and Aminu, S. and Ahmad, A.A. and Okakwu, I.K and Ade-Ikuesan, O.O},
  booktitle={2019 IEEE PES/IAS PowerAfrica}, 
  title={Compensation and Enhancement of the Nigerian Power Systems Network}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={This research work is aimed at performing the load flow analysis of Kaduna 132/33 kV transmission station in order to ascertain its steady state operating condition. Electrical Transient Analyzer Program (ETAP) software (version 12.6) was employed in the modeling and performing of the load flow analysis using the single line diagram (SLD) and the actual data obtained from the station. The losses in the network were compensated using the Optimal Capacitor Placement OCP module on the ETAP environment. The OCP optimally sized and placed capacitors on the affected buses which improved the bus voltages of the entire network. The results obtained recorded voltage violations at Abakpa, Water works, NAF base, Rigasa, Airport, Kinkinau, Angwa Dosa and Turuku buses with magnitudes of 93.483%, 92.188%, 94.716%, 93.012%, 91.789%, 90.244%, 94.171%, 91.676% respectively. An overall system loss of 753.2 kW and 10437.3 kVAR was recorded by the network. The results from the OCP revealed that it optimally sized and placed eight capacitor banks on eight of the candidate buses which include Abakpa Bus, Water works Bus, NAF Base Bus, Rigasa Bus, Airport Bus, Kinkinau Bus, Angwa Dosa Bus, and Turuku Bus. Consequently, an improvement of 3.408%, 6.721%, 2.401%, 3.835%, 6.397%, 8.866%, 3.359% and 6.591% respectively were recorded for the buses which raised their voltage profile to 96.891%, 98.186%, 97.53%, 96.703%, 99.11%, 97.117%, 96.847%, 98.267% and 98.909% respectively. The losses were also reduced from 753.2 kW and 10437.3 kVAR to 586.1 kW and 8015.7 kVAR respectively.},
  keywords={Mathematical models;Capacitors;Reactive power;Power systems;Power system stability;Jacobian matrices;Costs;Compensation;ETAP;Load-flow;Losses;OCP},
  doi={10.1109/PowerAfrica46609.2019.9078669},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{6625043,
  author={Faruk, Nasir and Adediran, Yinusa. A. and Ayeni, Adeseko A.},
  booktitle={Eurocon 2013}, 
  title={Error bounds of empirical path loss models at VHF/UHF bands in Kwara State, Nigeria}, 
  year={2013},
  volume={},
  number={},
  pages={602-607},
  abstract={Propagation models are used extensively in signal prediction and interference analysis. Peculiarity of these models gives rise to high prediction errors when deployed in a different environment other than the one initially built for. In this paper, we provide the error bounds on the efficacy at predicting path loss for 10 empirical widely used path loss models. The results show that no single model provides a good fit consistently. However, Hata and Davidson models provide good fitness along some selected routes with measured RMSE values of less than 8 dB. ITU-R P.1546-3, Walfisch Ikegami, ECC, Egli, CCIR and FSPL perform woefully, with higher RMSE and SC-RMSE (Spread Corrected RMSE) values. In terms of mean value errors, Hata, Davidson and ITU-R P.5293 models give mean values close to zero. However, COST 231 also provides better skew, while CCIR and ECC gives fair results but ITU-R P. 1546, WI and FSPL give worst results. The prediction errors for Davidson are nearly distributed symmetrically around the mean error of 2.15 dB. It was also observed that, the Gaussian error distribution within the window of ±5 dB dominates the frequency counts. However, the error counts for CCIR model are quite high but spread along the distribution but HATA, FSPL, Walfisch Ikegami and ITU-R P. 5293 models does not follow normal distribution.},
  keywords={Loss measurement;Predictive models;Buildings;Cities and towns;Analytical models;Propagation losses;Frequency measurement;Error Bound;Path loss;Propagation model;Hata model;Davidson model},
  doi={10.1109/EUROCON.2013.6625043},
  ISSN={},
  month={July},}@INPROCEEDINGS{9077649,
  author={Agbeyangi, Abayomi O. and Abegunde, Omolayo. and Eludiora, Safiriyu I.},
  booktitle={2020 International Conference in Mathematics, Computer Engineering and Computer Science (ICMCECS)}, 
  title={Authorship Verification of Yorùbá Blog Posts using Character N-grams}, 
  year={2020},
  volume={},
  number={},
  pages={1-6},
  abstract={The task of determining whether a pair (or more) documents were written by the same author comes under authorship verification. N-grams are sequences of elements appearing in texts, they can be words, POS tags, characters, or some other elements that can be encountered one after another in texts. The tasks in authorship verification were more challenging as it focuses on whether the target author and the text to be used have a closely related style. In this paper, an authorship verification task on a Yorùbá blog posts is hereby presented. N-grams features were extracted from the corpus and inductive learning techniques was applied to build feature-based models in order to perform the automatic author identification. K-means clustering algorithm was used in the study since the supervised algorithm cannot be applied to the one-class classification of the dataset. The evaluation was done with Silhouette Coefficient algorithm which is used to evaluate unlabeled data. The result obtained is positive which indicates the data points have a strong relationship with the dataset. The obtained result signifies a yes relationship between the posts. This signifies that the posts were from the same author.},
  keywords={Computer science;Blogs;Clustering algorithms;Feature extraction;Mathematics;Classification algorithms;Authorship verification;Authorship analysis;Yorùbá language;Character N-grams;Blog posts},
  doi={10.1109/ICMCECS47690.2020.246982},
  ISSN={},
  month={March},}@INPROCEEDINGS{10051541,
  author={Ogala, Justin Onyarin and Mughele, Ese Sophia and Chiemeke, Stella Chinnye},
  booktitle={2022 5th Information Technology for Education and Development (ITED)}, 
  title={Fraud Detection System for Effective Healthcare Administration in Nigeria using Apache Hive and Big Data Analytics: Reflection on the National Health Insurance Scheme}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={Nigerian researchers have shown that the lack of adequate mechanisms for fraud detection has impaired both providers and beneficiaries of this scheme. This work develops a fraud detection program for Nigeria's National Health Insurance Scheme (NHIS). Nigeria's National Health Insurance Scheme (NHIS) and Health Maintenance Organizations (HMOs) are the subjects of this study. The study was conducted using available data from NHIS-registered healthcare facilities and HMOs. Unified Modeling Language (UML) tools were used to create the framework. The framework was built with Apache Derby DB, Hadoop Distributed File System (HDFS), and Apache MapReduce as the big data processing platform. Using Apache Hive and Big Data Analytics, a system for detecting healthcare fraud is developed. This system used data from the Nigerian National Health Insurance Scheme (NHIS), which was broken down into three categories: enrolment, referral, and claim data. The analysis of current healthcare investigative methods is conducted, and a new framework is proposed.},
  keywords={File systems;Unified modeling language;Insurance;Medical services;Organizations;Big Data;Maintenance engineering;Big Data;Fraud;Detection Apache Hive Deep Learning;NHIS;Healthcare Insurance},
  doi={10.1109/ITED56637.2022.10051541},
  ISSN={},
  month={Nov},}@ARTICLE{9546758,
  author={Hinga, Simon K. and Atayero, Aderemi A.},
  journal={IEEE Access}, 
  title={Deterministic 5G mmWave Large-Scale 3D Path Loss Model for Lagos Island, Nigeria}, 
  year={2021},
  volume={9},
  number={},
  pages={134270-134288},
  abstract={5G millimeter wave (mmWave) application in mobile connectivity to realize high-speed, reliable communication is attributed with high path loss. This paper presents a detailed 3D ray-tracing technique at 28 GHz for Lagos Island to investigate five unique path loss scenarios: path loss, free space path loss with antenna pattern, free space path loss without antenna pattern, excess path loss with antenna pattern, and the excess path loss without antenna pattern for an urban environment. The Close-In (CI) model, Floating Intercept (FI) path loss model, and a root mean square error (RMSE) are used to model and evaluate the best path loss model for Lagos Island. The average achieved FI ( $\alpha,\beta, \sigma $ ) parameters were 189.92352, 0.1654, and 0.66948, While the average CI ( $\eta,X\sigma $ ) parameters were 2.309355 and 56.236425. From all the scenarios evaluated, the lowest path loss exponent achieved was 0.45, while the highest path loss exponent was 3.8. We have established that the FI path loss model accurately characterizes path loss for the Lagos Island environment with the lowest RMSE of 0.0359 dB and the highest RSME of 0.0997 dB. In contrast, the CI model over-predict the path loss at 28 GHz with the lowest RMSE of 0.0495 dB and the highest RMSE of 2.2547 dB. This work opens up a new area of research on mm-Wave at 28 GHz in Lagos Island, and the results obtained from this work can be used to benchmark future studies on mmWave in a similar environment.},
  keywords={Propagation losses;Antennas;5G mobile communication;Solid modeling;Three-dimensional displays;Radio transmitters;Predictive models;5G;close-in model;floating intercept model;millimeter-wave;path loss model},
  doi={10.1109/ACCESS.2021.3114771},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11319046,
  author={Sunday, Joseph Ochayi and Chigbo, Clement Chidi-Ife and Idem, Udosen Jacob and Yebisi, Ebenezer Tunde and Ojo, Abiodun Ayodele},
  booktitle={2025 IEEE International Conference on Emerging Trends in Engineering and Computing (ETECOM)}, 
  title={E-Government as a Tool for Reforming Land Holding Systems in Nigeria: Legal Challenges and Future Pathways}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Nigeria’s land administration faces persistent problems, including conflicting tenure claims, poor recordkeeping, corruption, dependence on traditional methods, and the complexity of diverse legal systems. E-Government, which applies Information and Communication Technology (ICT) to the delivery of public services, presents valuable opportunities to modernise land registration processes, enhance transparency, and strengthen security of tenure. This study explores the role of e-government in Nigerian land reform, with particular attention to legal challenges and possible future directions. A key finding is the significant influence of Nigeria’s varied legal regimes on landholding procedures and administrative processes. The study’s distinctive contribution is its proposal of an integrated legislative and regulatory framework, modelled on the global Land Administration Domain Model (LADM). This model encourages a federal-state integrative approach to e-governance for sustainable, efficient, and effective landholding practices. The study concludes that outdated legislation, weak data protection, and limited interoperability must first be addressed before e-government can successfully transform Nigeria’s land administration system.},
  keywords={Law;Transforms;Market research;Information and communication technology;Planning;Security;Proposals;Standards;Electronic government;Investment;E-Government;digital land administration;Land Use Act;Nigeria;Legal Reform},
  doi={10.1109/ETECOM66111.2025.11319046},
  ISSN={},
  month={Oct},}@ARTICLE{9117142,
  author={Mukhtar, Nasiru and Kamin, Yusri Bin and Saud, Muhammad Sukri Bn and Al Rahmi, Waleed Mugahed and Nordin, Mohd Safarin Bin and Arsat, Mahyuddin Bin and Amin, Nor Fadila Binti and Yahaya, Noraffandy Bin},
  journal={IEEE Access}, 
  title={Conceptual Model of Technical Sustainability for Integration Into Electrical/Electronic Engineering Programmes in Nigerian Polytechnics}, 
  year={2020},
  volume={8},
  number={},
  pages={128519-128535},
  abstract={Global warming is probably the greatest threat of this century. Several developed and developing countries have taken important measures to reduce its adverse effects, including greening their Higher Education Institutions (HEIs) curricula. However, Sub Saharan African countries are left behind to that effect, despite the fact that people in these countries are the greatest recipients of the global warming harmful consequences. The goal of this research therefore, is to investigate the suitable competencies in technical sustainability for incorporation into Higher National Diploma electrical/electronic engineering curriculum in Nigeria. The authors used mixed-method approach employing sequential exploratory design in the study. In the qualitative phase, we analyzed documents consisting of 10 journal articles and 3 skills standards, as well as conducted a total of 10 interviews with experts. Also, we carried out 3 rounds of modified Delphi survey using 28 participants to ascertain the appropriateness of the competencies suitable for infusion into the said curriculum. The study discovered competencies suitable for incorporation into the curriculum which include cognitive-related competencies in clean energy, eco-design, and R&D; psychomotor-related competencies in sustainable production, waste-to-energy-technology, communication/ICT, and use of modern engineering software tools; and affective values related to engineering ethical responsibility, occupational health and safety, cooperation/teamwork, and equity. We analyzed only 13 documents, conducted 10 interviews, and administered questionnaires in 3 rounds of Delphi survey technique to 28 experts in only one geo-political zone of the country. Thus, conclusions derived from these sources rely on the genuineness of the information provided by the participants. The findings provided the researchers, accreditation bodies as well as curriculum developers with competencies in technical sustainability in the events of curriculum upgrade or renewal to integrate technical sustainability. The findings are the results of triangulated data elicited theoretically and empirically.},
  keywords={Sustainable development;Education;Economics;Cultural differences;Green products;Standards;Global warming;Technical sustainability;electrical/electronic engineering;sustainability integration},
  doi={10.1109/ACCESS.2020.3002579},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10629952,
  author={Janet, Awotunde Gbenisola and Adetokunbo, Adekunle Olusegun},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={Acceptance and Utilization of Information Technology Among Poultry Farmers in Kwara State, Nigeria: A Utaut Model Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Information technology is of great value to poultry farmers as it is use to access latest issues and current trend about poultry farming. But still, poultry farmers regard information technology as the deteriorating agent in poultry farming sector because many poultry farmers misused the platform for wrong reasons. The issue with information technology use should be transformed into an incentive for the positive to help, improve, promote, provides better nutrition and additional income to the poultry farmers instead of fighting a lost war because social networking is here to remain. Although there are very few empirically tested researches on information technology, the paper examines the acceptance and use of information technology (IT) among poultry farmers in Kwara State, Nigeria using the Unified Theory of Acceptance and Use of Technology (UTAUT) Model. The study made use of primary data obtained from a structured questionnaire administered to 136 poultry farmers. SPSS was used to analyze the collected data. The results showed that performance expectancy, effort expectancy, social influence, facilitating conditions, were some of the significant determinants influencing the acceptance and use of information technology among the poultry farmers. Findings also revealed the factors have a direct influence on the attitude and behavior of poultry farmers towards using information technology. The study concluded that the UTAUT model is applicable to exploring the usage of information technology among poultry farmers in Kwara State. The study also suggested that policy makers, should consider the effective utilization of information technology in order to increase the information productivity of poultry farmers and enhance their livelihood in the study area.},
  keywords={Productivity;Social networking (online);Livelihood;Market research;Information technology;Sustainable development;Farming;UTAUT model;information Technology;poultry farmers},
  doi={10.1109/SEB4SDG60871.2024.10629952},
  ISSN={},
  month={April},}@INPROCEEDINGS{6419213,
  author={Ibiyemi, T. S. and Ajewole, M. O. and Ojo, J. S. and Obiyemi, O. O.},
  booktitle={2012 20th Telecommunications Forum (TELFOR)}, 
  title={Rain rate and rain attenuation prediction with experimental rain attenuation efforts in south-western Nigeria}, 
  year={2012},
  volume={},
  number={},
  pages={327-329},
  abstract={This paper presents the comparison of existing rain rate models with three years one minute average rain rate obtained using a vertically looking micro rain radar. The improved Moupfouma model showed good agreement with the measured rain rate. Rain attenuation for selected broadcast satellites with varying look angles was also estimated. The satellite with the lowest antenna elevation accounts for the highest rain induced attenuation. Finally, recent experimental efforts on beacon signal measurement for extensive rain attenuation modeling for satellite-earth link are also presented.},
  keywords={Rain;Attenuation;Satellites;Satellite broadcasting;Predictive models;Telecommunications;Attenuation measurement;Micro rain radar;rain rate;satellite beacon},
  doi={10.1109/TELFOR.2012.6419213},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{8665467,
  author={Dioha, Michael O. and Emodi, Nnaemeka V. and Mathew, Mobi and Dioha, Emmanuel C.},
  booktitle={2018 International Conference on Power Energy, Environment and Intelligent Control (PEEIC)}, 
  title={Techno-Economic Feasibility of Domestic Solar Water Heating System in Nigeria}, 
  year={2018},
  volume={},
  number={},
  pages={54-60},
  abstract={Nigeria's electricity mix is made up of 85% fossil fuel and this share is projected to increase in the future due to the projected increase in socioeconomic activities. This will lead to an increased emission level despite the abundant solar energy resources which is a suitable alternative for sustainable energy development in Nigeria. This paper addresses the issue by evaluating the technical and financial viability of deploying domestic Solar Water Heaters (SWH) in the Nigeria households using the RETScreen modelling framework. Performance, greenhouse gas (GHG) emission mitigation and financial analyses were performed for six selected cities in the six geopolitical zones in Nigeria. Results indicate that a single evacuated tube SWH can produce a maximum solar fraction of 69% for Nigeria's households. The results further suggest that SWH can play a major role towards energy security and GHG emission mitigation in the country. The results of the financial analysis showed that SWH is economically viable in most parts of Nigeria with exception of the south-south geopolitical zone where the R1 category of households in Port Harcourt city still requires financial support for the viability of SWH. This study recommends the increased adoption of policies enhancing the penetration of SWH systems in order to transcend Nigeria towards a low carbon pathway.},
  keywords={Water heating;Urban areas;Electron tubes;Fossil fuels;Solar heating;Temperature distribution;Solar water heater;RETScreen;Techno-economic feasibility;Nigeria},
  doi={10.1109/PEEIC.2018.8665467},
  ISSN={},
  month={April},}@INPROCEEDINGS{8281884,
  author={Olukunle, Akande Akinyinka and Kemdirim, Agubor Cosmas and Akande, Ahmed Wasiu},
  booktitle={2017 IEEE 3rd International Conference on Electro-Technology for National Development (NIGERCON)}, 
  title={Autoregressive modeling of mobile radio channel in LTE network, a case study of Ibadan City, Nigeria}, 
  year={2017},
  volume={},
  number={},
  pages={107-112},
  abstract={The mobile communication industry since its inception has been confronted with the problem of meeting the ever increasing demand for higher data rates as well as quality of service (QoS) which may be affected by channel obstruction, signal attenuation and frequency assignment in network planning. This paper is basedon autoregressive modeling of mobile channel in LTE network in which the propagation path loss for locations in Ibadan City was investigated. Using drive test, data obtained were optimized using Auto-Regressive Adaptive inertiaweight(ARAW). Simulation was carried out using MATLAB R2014a. The average measured losses obtained were compared with the corresponding results obtained using Okumura-Hata, COST 231, Ericsson 999 and ECC-33 models. The validation of model was performed with error metrics such as Absolute Mean Percentage Error (AMPE) and Root Mean Square Error (RMSE). The results obtained indicated that ARaw optimized model gave better result which is suitable for cell coverage planning and LTE signal power attenuation prediction.},
  keywords={Loss measurement;Data models;Predictive models;Urban areas;Mobile communication;Propagation losses;Long Term Evolution;Auto-Regressive;COST-231;Drive test;Mobile channel;4G network},
  doi={10.1109/NIGERCON.2017.8281884},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{11147360,
  author={Hamza, Usman and Abdullah, Nasuha Lee and Mashita Syed-Mohamad, Sharifah},
  booktitle={2025 IEEE Integrated STEM Education Conference (ISEC)}, 
  title={Integrating DevOps Knowledge Using a University-Based Software Engineering Course in Nigerian Universities}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper provides a design and pilot implementation of a DevOps-based Software Development course learning process for computer science and software engineering students in Al-Qalam University, Nigeria. Part of proposed system is Body of Knowledge in DevOps technology for Software Engineering and Computer Science curriculum, which is based on expert opinions and describes the Knowledge Groups required for Software Engineering professionals to do their work and DevOps young software engineers. The Software Engineering DevOps fundamentals serve as a foundation for identifying critical skills and competencies, and building curriculum and profiles for those skills and competencies. The paper implements the first course that has been conducted at Al-Qalam University Katsina for semester I, 2023/2024 session and describes teaching techniques used to create courses, including project-based learning, which helps students understand DevOps and Agile development techniques and provides a brief introduction to commonly used DevOps terminology, concepts, models, and tools, with a focus on DevOps tools for software development, deployment, and operations, which support key DevOps development principles. Finally, the paper proposed a curriculum course outline Cloud computing and related services make it possible to employ Infrastructure as Code (IaCode) to integrate, deploy, and manage modern software as a service and other related issue. Cloud platforms (both commercial and open source, such as Amazon Web Services (AWS) and Microsoft Azure) provide numerous opportunities for application management [6], monitoring and measuring cloud resources. The cloud provides the fundamental software engineering environment for delivering Big Data apps, and the platform for developing agile Data Science apps that empower agile data management for teaching DevOps techniques in Nigerian Universities for undergraduate software engineering and computer science students which has never been in existence in Nigerian University Commission curriculum.},
  keywords={Knowledge engineering;Computer science;Cloud computing;DevOps;Web services;Terminology;Education;Software as a service;Software engineering;STEM;Software Engineering;Body of Knowledge;Teaching methodology;Learning DevOps Software Engineering},
  doi={10.1109/ISEC64801.2025.11147360},
  ISSN={2473-7623},
  month={March},}@ARTICLE{9863797,
  author={Podmore, Robin and Kapur, Rajan},
  journal={IEEE Power and Energy Magazine}, 
  title={Smart Village Voices in Africa, System-of-Systems Approach: Part 1: A System-of-Systems Approach for Zero Poverty}, 
  year={2022},
  volume={20},
  number={5},
  pages={54-60},
  abstract={This article is the first in a four-part series 1) Smart Village Voices in Africa: Part 1: A System-of-Systems Approach for Zero Poverty 2) Smart Village Voices in Africa: Part 2: Village Entrepreneurs in Nigeria 3) Smart Village Voices in Africa: Part 3: Electrification in Cameroon 4) Smart Village Voices in Africa: Part 4: Gemstones to Electric Infrastructure in Zambia.},
  keywords={Africa;Rural areas;Smart cities;Sustainable development;Energy management;Economics},
  doi={10.1109/MPE.2022.3184063},
  ISSN={1558-4216},
  month={Sep.},}@ARTICLE{11053813,
  author={Ugbehe, Prosper O. and Diemuodeke, Ogheneruona E. and Aikhuele, Daniel O. and Okedu, Kenneth E. and Kalnoor, Gauri},
  journal={IEEE Access}, 
  title={Estimation and Forecasting of Nigeria’s Residential, Commercial, and Industrial Electricity Demands}, 
  year={2025},
  volume={13},
  number={},
  pages={112081-112101},
  abstract={Energy demand forecasting has emerged as a crucial area of research, driven by the need for accurate predictions of future electricity consumption. This is critically essential for the effective planning and operation of electric power systems. Several studies have only forecasted what could be best termed as ‘suppressed electricity demand’ in Nigeria, given the non-consideration of basic unmet demand factors. Suppressed electric energy demand arises from inadequate energy access accounting for unmet electricity needs such as electricity capacity utilization, access rate, outages, and transmission and distribution (T&D) losses. These unmet electricity needs are considered sensitive determinants in achieving optimal planning and utilization of electricity in a developing economy like Nigeria. This study, therefore investigated and estimated these unmet basic electricity needs in deriving a potential electricity consumption and typical demand forecast for Nigeria in consideration of sustainability and full capacity utilization. It aimed at forecasting Nigeria’s potential electricity demand by analyzing the various electricity usage patterns in the country. It presented a methodological approach for estimating and forecasting the expected electricity demand in the nation by developing and examining economic and environmentally sustainable models with the incorporation of unmet electricity needs. These needs were analyzed using the developed models and sourced data to obtain advanced estimates of electricity consumption. A high-precision, long-term forecasting procedure was then implemented using these estimates. The implementation and simulation of the procedure was conducted with a Machine Learning/AI procedure (using Python) compatible with the Google Collaboratory tool. The obtained results were post processed using MS Excel. The results indicated that Nigeria’s potential electricity demand will be 69783.099, 80383.785 and 90984.472 GWh by 2030, 2040 and 2050, respectively. The forecast results were further validated with those obtained using stochastic/probabilistic extrapolation method. While the Python simulation indicated a lower average Mean Square Error (MSE) of 0.008%, the stochastic/probabilistic extrapolation procedure gave an MSE of 0.021%. With the forecasting results, decision-makers and policy-makers in Nigeria’s energy sector are armed with the right tool for effective and informed decision-making in electricity planning and management. The approach of this study to solving the national energy challenge is timely and aims to help navigate the complex challenges of making informed decisions in the sector, and establish future research avenues that may facilitate the effective integration of renewable energy into the national energy landscape.},
  keywords={Electricity;Predictive models;Biological system modeling;Planning;Energy consumption;Electric potential;Accuracy;Economics;Economic indicators;Data models;Electricity demand;electricity forecast;potential electricity demand;sustainability;unmet electricity needs},
  doi={10.1109/ACCESS.2025.3582625},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11712742,
  author={Baharom, Nur Amalina and Rosa Mohamad Sattar, Afrina and Amin Mohd Zaidi, Muhammad Ajrul and Alhaji Rabiu, Aliyu and Sa’Idu, Sabo Jamilu and Abubakar Lamido, Usman},
  booktitle={2026 7th International Conference on Artificial Intelligence and Data Sciences (AiDAS)}, 
  title={A Reproducible Snakemake Workflow for Cross-Context Islamophobia Analysis in Malaysian and Nigerian Social Media}, 
  year={2026},
  volume={},
  number={},
  pages={174-179},
  abstract={The increasing spread of Islamophobia and related discourse on social media has raised concerns regarding online hate narratives, cultural stereotypes, and extremist framing across different sociopolitical contexts. However, existing studies often focus on classification performance while providing limited thematic interpretation and reproducible analytical workflows. This study presents a reproducible BERTopic-based workflow for cross-context analysis of Islamophobia discourse using multilingual social media datasets from Malaysia, Nigeria, and the CONAN hate speech corpus. The proposed workflow integrates data standardization, text preprocessing, local LLM-assisted filtering using Gemma via Ollama, multilingual translation, semantic embedding generation using SentenceTransformers, and BERTopic modeling. The entire methodology was automated using Snakemake to support reproducibility and modular execution. Validation using 800 sampled instances from the CONAN dataset showed strong filtering performance, achieving 94.5% accuracy and 97.17% F1-score. After filtering and preprocessing, 1,551 Islamophobia texts were retained, and BERTopic identified 38 meaningful topics with a topic diversity score of 0.7757. The findings revealed dominant narratives involving extremism and violence framing, gendered Islamophobia, Islamisation threat narratives, anti-Muslim stereotyping, and sociopolitical and religious discourse. Cross-context analysis showed that the CONAN dataset was dominated by explicit anti-Muslim and cultural threat narratives, while Malaysian discourse focused more on sociopolitical and religious issues, and Nigerian discourse showed stronger associations with security and extremism framing. The study contributes a transparent and reproducible workflow for multilingual Islamophobia discourse analysis across diverse online sociocultural environments.},
  keywords={Modeling;Context;Multilingual;Labeling;Social networking (online);Filtering;Filters;Large language models;Manuals;Printing;Islamophobia Detection;BERTopic;Snakemake;LLMs;Social Media Analysis},
  doi={10.1109/AiDAS71914.2026.11712742},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11592097,
